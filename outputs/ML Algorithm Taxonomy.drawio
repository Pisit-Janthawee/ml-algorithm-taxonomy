        <mxCell id="deeplearning-409" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which learning rate should I start with?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ α ≈ 0.35 at the steepest drop; the minimum is too late (loss explodes soon after)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500.0" y="2570.0" width="300.0" height="68.0" as="geometry" />
