        <mxCell id="dimred-174" value="$$z = \frac{x - \mu}{\sigma}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="560.0" y="610.0" width="300.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-175" value="mean of the feature" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="680.0" width="130.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-176" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570.0" y="689.0" as="sourcePoint" />
            <mxPoint x="730.0" y="630.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-177" value="standard deviation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="680.0" width="130.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-178" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820.0" y="689.0" as="sourcePoint" />
            <mxPoint x="720.0" y="650.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-179" value="Example: μ₁ = 56.3 m², σ₁ = 14.4 m²  →  a 70 m² house has &lt;span style='background:#FFFF00'&gt;z = (70 − 56.3) / 14.4 = 0.96&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="715.0" width="580.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-180" value="&lt;b&gt;Why:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Without scaling, the feature with the biggest numbers (m²) dominates the variance&lt;/li&gt;&lt;li&gt;PCA finds directions of &lt;b&gt;maximum variance&lt;/b&gt; → features must be comparable&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="760.0" width="580.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-181" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is a 70 m² house big or small here?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ z = 0.96: about 1.0 standard deviations above the average house&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="415.0" y="592.0" width="210.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-182" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625.0" y="660.0" as="sourcePoint" />
            <mxPoint x="792.0" y="728.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-183" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="240.0" width="620.0" height="620.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-184" value="② Covariance Matrix &amp;amp; Eigen-decomposition" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1074.0" y="250.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-185" value="Background: how features vary together" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1074.0" y="276.0" width="592.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-186" value="$$\Sigma = \frac{1}{n-1} Z^{T} Z$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="310.0" width="580.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-187" value="$$\Sigma = \begin{bmatrix} Var(z_1) &amp; Cov(z_1,z_2) \\ Cov(z_2,z_1) &amp; Var(z_2) \end{bmatrix} = \begin{bmatrix} 1.00 &amp; 0.86 \\ 0.86 &amp; 1.00 \end{bmatrix}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1070.0" y="365.0" width="600.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-188" value="diagonal = variance (= 1 after standardizing)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="435.0" width="260.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-189" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1340.0" y="444.0" as="sourcePoint" />
            <mxPoint x="1470.0" y="390.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-190" value="off-diagonal = covariance (= correlation here)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1390.0" y="440.0" width="260.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-191" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1605.0" y="449.0" as="sourcePoint" />
            <mxPoint x="1605.0" y="390.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-192" value="$$\Sigma\, v = \lambda\, v \qquad \det(\Sigma - \lambda I) = 0$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="485.0" width="580.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-193" value="eigenvector v = direction of a principal component" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="535.0" width="280.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-194" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1275.0" y="544.0" as="sourcePoint" />
            <mxPoint x="1275.0" y="512.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-195" value="eigenvalue λ = variance along v" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1390.0" y="535.0" width="200.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-196" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1390.0" y="544.0" as="sourcePoint" />
            <mxPoint x="1315.0" y="512.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-197" value="$$\lambda_{1,2} = \frac{a+c}{2} \pm \sqrt{\left(\frac{a-c}{2}\right)^2 + b^2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="570.0" width="580.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-198" value="&lt;span style='background:#FFFF00'&gt;\(\lambda_1 = 1.86,\ \ v_1 = (0.71,\ 0.71)\)&lt;/span&gt;&lt;br&gt;\(\lambda_2 = 0.14,\ \ v_2 = (-0.71,\ 0.71)\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="635.0" width="580.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-199" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which direction holds most of the spread?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ v₁ = (0.71, 0.71), λ₁ = 1.86 → 93% of all variance&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1512.0" y="654.0" width="163.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-200" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1512.0" y="654.0" as="sourcePoint" />
            <mxPoint x="1488.0" y="652.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-201" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(\lambda_1 + \lambda_2 = \) total variance \(= 2\) (number of standardized features)&lt;/li&gt;&lt;li&gt;PC1 explains \(1.86/2 = 93\%\) of the variance → keep 1 dimension instead of 2&lt;/li&gt;&lt;li&gt;Eigenvectors are orthogonal (90°) → new features are uncorrelated&lt;/li&gt;&lt;li&gt;In practice computed with SVD of Z (more stable)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="705.0" width="580.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-202" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1720.0" y="240.0" width="680.0" height="620.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-203" value="③ Principal Components (new axes)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1734.0" y="250.0" width="652.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-204" value="Rotate the axes to the directions of spread" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1734.0" y="276.0" width="652.0" height="18.0" as="geometry" />
        </mxCell>
