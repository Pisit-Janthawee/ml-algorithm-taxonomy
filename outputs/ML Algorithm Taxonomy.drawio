        <mxCell id="timeseries-505" value="$$\hat{y}_{T+h} = \mu + \varphi^{h}\,(y_T - \mu)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="1330.0" width="600.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-506" value="$$Var(e_{T+h}) = \sigma^2\sum_{j=0}^{h-1}\varphi^{2j}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="1375.0" width="600.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-507" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;ARMA forecasts are good for a few steps, then fall back to the long-run mean&lt;/li&gt;&lt;li&gt;Uncertainty grows with every step → always show the interval, not only the line&lt;/li&gt;&lt;li&gt;Baseline for your LSTM: if LSTM can't beat AR on returns, it isn't learning real signal&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="1440.0" width="340.0" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-508" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How far ahead can I trust the forecast?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ a few steps: the 95 % band widens from ±1.96 to ±3.13σ by h = 25 while the line decays to μ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2115.0" y="1435.0" width="265.0" height="68.0" as="geometry" />
        </mxCell>
