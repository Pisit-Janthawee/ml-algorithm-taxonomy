        </mxCell>
        <mxCell id="deeplearning-411" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;One short run: start α tiny, multiply by 1.12 every mini-batch, record (smoothed) loss&lt;/li&gt;&lt;li&gt;Loss flat → α too small · steep drop → good · explodes → too big&lt;/li&gt;&lt;li&gt;Choose α at the steepest drop (or min-loss α ÷ 10)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2870.0" width="640.0" height="66.0" as="geometry" />
