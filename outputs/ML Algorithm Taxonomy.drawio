          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-163" value="Weak" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="1323.0" width="80.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-164" value="Decision node = feature test  ·  Leaf = predicted class [count Yes, count No]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="1450.0" width="800.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-165" value="Recursion on Sunny branch (5 rows, H = 0.971)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1080.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-166" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Feature&lt;/th&gt;&lt;th&gt;IG&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Humidity&lt;/td&gt;&lt;td&gt;0.971&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Temp&lt;/td&gt;&lt;td&gt;0.571&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Wind&lt;/td&gt;&lt;td&gt;0.020&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1104.0" width="380.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-167" value="Recursion on Rain branch (5 rows, H = 0.971)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1210.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-168" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Feature&lt;/th&gt;&lt;th&gt;IG&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Wind&lt;/td&gt;&lt;td&gt;0.971&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Temp&lt;/td&gt;&lt;td&gt;0.020&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Humidity&lt;/td&gt;&lt;td&gt;0.020&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1234.0" width="380.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-169" value="&lt;b&gt;ID3(S, features)&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;if S is pure: return leaf(class)&lt;br&gt;if no features: return leaf(majority)&lt;br&gt;A = argmax IG(S, a)&lt;br&gt;node = test on A&lt;br&gt;for each value v of A:&lt;br&gt;&amp;nbsp;&amp;nbsp;child = ID3(S_v, features − A)&lt;br&gt;return node&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1300.0" y="1345.0" width="380.0" height="170.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-170" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Greedy, top-down: the best split &lt;i&gt;now&lt;/i&gt; is chosen; earlier choices are never revisited&lt;/li&gt;&lt;li&gt;Each feature is used at most once on a path (categorical); the tree stops when leaves are pure&lt;/li&gt;&lt;li&gt;This tree classifies all 14 training days correctly — risk of &lt;b&gt;overfitting&lt;/b&gt; on noisy data&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1500.0" width="840.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-171" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How does the tree classify a rainy day with strong wind?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ follow Outlook = Rain → Wind = Strong → leaf No [0+, 2−]: each root-to-leaf path is one IF-THEN rule&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1610.0" width="840.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-172" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010.0" y="1610.0" as="sourcePoint" />
            <mxPoint x="1010.0" y="1430.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tree-173" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="1000.0" width="640.0" height="780.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-174" value="⑤ Rules, Gain Ratio &amp;amp; Limitations" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1774.0" y="1010.0" width="612.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-175" value="&lt;b&gt;Extracted rules (each path = one rule):&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;IF Outlook = Overcast THEN &lt;b&gt;Yes&lt;/b&gt;&lt;/li&gt;&lt;li&gt;IF Outlook = Sunny AND Humidity = High THEN &lt;b&gt;No&lt;/b&gt;&lt;/li&gt;&lt;li&gt;IF Outlook = Sunny AND Humidity = Normal THEN &lt;b&gt;Yes&lt;/b&gt;&lt;/li&gt;&lt;li&gt;IF Outlook = Rain AND Wind = Strong THEN &lt;b&gt;No&lt;/b&gt;&lt;/li&gt;&lt;li&gt;IF Outlook = Rain AND Wind = Weak THEN &lt;b&gt;Yes&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1050.0" width="600.0" height="131.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-176" value="Bias toward many-valued features" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1200.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-177" value="Splitting on &lt;i&gt;Day&lt;/i&gt; (14 unique values) gives 14 pure leaves → IG = 0.940 (the maximum!) but it is useless for new days." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1222.0" width="600.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-178" value="$$SplitInfo(S,A) = -\sum_v \frac{|S_v|}{|S|}\log_2\frac{|S_v|}{|S|}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1260.0" width="600.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-179" value="$$GainRatio = \frac{IG(S,A)}{SplitInfo(S,A)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1316.0" width="600.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-180" value="C4.5 fix → Outlook: SplitInfo = 1.577, &lt;span style=&quot;background:#FFFF00&quot;&gt;GainRatio = 0.156&lt;/span&gt;;  Day: SplitInfo = 3.807, GainRatio = 0.247" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1366.0" width="600.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-181" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;ID3&lt;/th&gt;&lt;th&gt;C4.5&lt;/th&gt;&lt;th&gt;CART&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Criterion&lt;/td&gt;&lt;td&gt;Information Gain&lt;/td&gt;&lt;td&gt;Gain Ratio&lt;/td&gt;&lt;td&gt;Gini / Variance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Features&lt;/td&gt;&lt;td&gt;categorical&lt;/td&gt;&lt;td&gt;categorical + numeric&lt;/td&gt;&lt;td&gt;categorical + numeric&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Splits&lt;/td&gt;&lt;td&gt;multi-way&lt;/td&gt;&lt;td&gt;multi-way&lt;/td&gt;&lt;td&gt;binary&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pruning&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;yes (error-based)&lt;/td&gt;&lt;td&gt;yes (cost-complexity)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Missing values&lt;/td&gt;&lt;td&gt;no&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;yes (surrogates)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1410.0" width="600.0" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-182" value="&lt;b&gt;Limitations:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Overfitting → limit depth, minimum samples per leaf, or prune&lt;/li&gt;&lt;li&gt;Unstable: small data changes → different tree → fixed by Bagging / Random Forest (Ensemble page)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1580.0" width="600.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-183" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why not simply split on 'Day'?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ its IG (0.940) is the maximum, but 14 one-row leaves can't predict new days — Gain Ratio drops it to 0.247&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
