          <mxGeometry x="400.0" y="4710.0" width="1000.0" height="680.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-705" value="⑬ Vanishing gradients → LSTM / GRU gates" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="4720.0" width="972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-706" value="Why plain RNNs forget, and how gates fix it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="4746.0" width="972.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-707" value="$$\frac{\partial h_T}{\partial h_t} = \prod_{k=t+1}^{T} W_{hh}\,\tanh'(\cdot) \approx (w\,\bar{g})^{T-t}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
