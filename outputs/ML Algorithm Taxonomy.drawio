        </mxCell>
        <mxCell id="regression-293" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Batch GD&lt;/b&gt; uses all m samples per step;  &lt;b&gt;SGD&lt;/b&gt; one sample;  &lt;b&gt;Mini-batch&lt;/b&gt; a small batch (see Optimization page)&lt;/li&gt;&lt;li&gt;Scale features first (standardize) so the bowl is round and GD converges faster&lt;/li&gt;&lt;li&gt;Same algorithm trains Logistic Regression and Neural Networks — only the cost function changes&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1540.0" width="880.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-294" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which way and how far should β move at each step?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ downhill (opposite the gradient), by α × slope: steps shrink near the bottom and stop at β₁ ≈ 0.59&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000.0" y="1525.0" width="290.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-295" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000.0" y="1525.0" as="sourcePoint" />
            <mxPoint x="626.3" y="1357.1" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="regression-296" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What happens if the learning rate α is too large?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ each step overshoots the minimum and lands higher up the other side → the cost grows instead of falling&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
