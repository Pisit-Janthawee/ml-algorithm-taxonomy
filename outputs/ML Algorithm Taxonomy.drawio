        <mxCell id="association-178" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which rules are worth acting on?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ confidence ≥ 0.7 and lift &gt; 1: only Diaper → Beer and Beer → Diaper&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
