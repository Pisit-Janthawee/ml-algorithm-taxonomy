        </mxCell>
        <mxCell id="featureeng-484" value="keeps the order Low &amp;lt; Mid &amp;lt; High; never use it for nominal data (implies Tech &amp;gt; Bank)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2040.0" y="1188.0" width="330.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-485" value="Target (mean) encoding (sector) with smoothing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#9673A6;" vertex="1" parent="1">
