        <mxCell id="classification-27" value="&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Binary (or categorical) target&lt;/li&gt;&lt;li&gt;Independent observations&lt;/li&gt;&lt;li&gt;Linear relation between features and log-odds&lt;/li&gt;&lt;li&gt;No strong multicollinearity&lt;/li&gt;&lt;li&gt;Enough samples (≈10+ events per feature)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
