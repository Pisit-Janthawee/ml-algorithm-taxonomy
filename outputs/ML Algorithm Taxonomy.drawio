        <mxCell id="featureeng-481" value="drop_first: remove one column (Bank = both 0) → avoids the dummy-variable trap (perfect multicollinearity in linear models)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
