        <mxCell id="anomaly-1850" value="threshold = 95th pct of normal = 1.84" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="592.4" y="5003.0" width="220.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1851" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does the model fail to rebuild this point?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ 5 of 8 anomalies exceed the threshold; points lying ALONG the main axis rebuild well even if far away — a linear 1-D code is too weak, a real autoencoder adds non-linearity&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="890.0" y="5010.0" width="380.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1852" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890.0" y="5092.0" as="sourcePoint" />
            <mxPoint x="755.0" y="5144.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-1853" value="&lt;b&gt;Practice:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Train only on normal data, threshold on validation errors&lt;/li&gt;&lt;li&gt;Real autoencoders (MLP / LSTM) handle images, logs, sequences&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="890.0" y="5150.0" width="390.0" height="62.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1854" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1340.0" y="4590.0" width="1060.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1855" value="⑭ Which detector? Results on this data &amp;amp; selection guide" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1354.0" y="4600.0" width="1032.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1856" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;method&lt;/th&gt;&lt;th&gt;precision@8&lt;/th&gt;&lt;th&gt;local anomaly rank&lt;/th&gt;&lt;th&gt;assumption&lt;/th&gt;&lt;th&gt;local / global&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Global Z (max |z|)&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;90&lt;/td&gt;&lt;td&gt;one normal blob&lt;/td&gt;&lt;td&gt;global&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Isolation Forest&lt;/td&gt;&lt;td&gt;0.88&lt;/td&gt;&lt;td&gt;32&lt;/td&gt;&lt;td&gt;anomalies are few &amp; different&lt;/td&gt;&lt;td&gt;global&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LOF (k = 10)&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;density varies by region&lt;/td&gt;&lt;td&gt;local&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;KDE / OCSVM-like&lt;/td&gt;&lt;td&gt;0.88&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;smooth normal region&lt;/td&gt;&lt;td&gt;global&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PCA reconstruction&lt;/td&gt;&lt;td&gt;0.62&lt;/td&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;normal data lies on a low-dim subspace&lt;/td&gt;&lt;td&gt;global&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DBSCAN noise&lt;/td&gt;&lt;td&gt;0.47 (15 flagged)&lt;/td&gt;&lt;td&gt;in cluster&lt;/td&gt;&lt;td&gt;clusters of similar density&lt;/td&gt;&lt;td&gt;local-ish&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="4640.0" width="1020.0" height="180.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1857" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;situation&lt;/th&gt;&lt;th&gt;start with&lt;/th&gt;&lt;th&gt;why&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tabular, many features, no labels&lt;/td&gt;&lt;td&gt;Isolation Forest&lt;/td&gt;&lt;td&gt;fast, scales, no distance metric&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;clusters of different density&lt;/td&gt;&lt;td&gt;LOF&lt;/td&gt;&lt;td&gt;compares with local neighbourhood&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;clean training set of normal data only&lt;/td&gt;&lt;td&gt;One-Class SVM / Autoencoder&lt;/td&gt;&lt;td&gt;learns the normal region (novelty detection)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;images, logs, sequences&lt;/td&gt;&lt;td&gt;Autoencoder / LSTM-AE&lt;/td&gt;&lt;td&gt;reconstruction in a learned space&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;time series&lt;/td&gt;&lt;td&gt;model residuals + rolling Z (⑦)&lt;/td&gt;&lt;td&gt;remove trend / season first&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;some labelled anomalies&lt;/td&gt;&lt;td&gt;supervised classifier + class weights&lt;/td&gt;&lt;td&gt;labels beat unsupervised guesses&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="4850.0" width="640.0" height="210.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1858" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which method should I trust here?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ best precision@8 here = 0.88; no method wins everywhere — LOF is the only one that ranks the local anomaly near the top (#9). Ensemble several scores in practice&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2030.0" y="4880.0" width="350.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1859" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2030.0" y="4880.0" as="sourcePoint" />
            <mxPoint x="1818.0" y="4720.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-1860" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Scale features before distance / density methods&lt;/li&gt;&lt;li&gt;Evaluate with injected or labelled anomalies (precision@k, PR-AUC)&lt;/li&gt;&lt;li&gt;Threshold = business decision (alerts per day you can review)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="5080.0" width="600.0" height="85.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
