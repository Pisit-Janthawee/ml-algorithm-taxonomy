        <mxCell id="rl-239" value="⑥ Q-Learning Algorithm &amp;amp; Learning Curve" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1754.0" y="930.0" width="632.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-240" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Q = zeros(states, actions)&lt;br&gt;for episode in range(N):&lt;br&gt;&amp;nbsp;&amp;nbsp;s = env.reset()&lt;br&gt;&amp;nbsp;&amp;nbsp;while not done:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;a = random() if rand() &amp;lt; ε else argmax(Q[s])&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s2, r, done = env.step(a)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Q[s,a] += α·(r + γ·max(Q[s2]) − Q[s,a])&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s = s2&lt;br&gt;&amp;nbsp;&amp;nbsp;ε = max(ε_min, ε·decay)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="980.0" width="600.0" height="190.0" as="geometry" />
        </mxCell>
