        <mxCell id="clustering-324" value="squared distances → inertia" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="730.0" y="1040.0" width="170.0" height="18.0" as="geometry" />
