        <mxCell id="ensemble-514" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Day&lt;/th&gt;&lt;th&gt;actual&lt;/th&gt;&lt;th&gt;T1&lt;/th&gt;&lt;th&gt;T2&lt;/th&gt;&lt;th&gt;T3&lt;/th&gt;&lt;th&gt;T4&lt;/th&gt;&lt;th&gt;T5&lt;/th&gt;&lt;th&gt;votes Up&lt;/th&gt;&lt;th&gt;bagged ŷ&lt;/th&gt;&lt;th&gt;OOB ŷ&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;1&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;4/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;3/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;1&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;1&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;&lt;u&gt;&lt;b&gt;0&lt;/b&gt;&lt;/u&gt;&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2/5&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
