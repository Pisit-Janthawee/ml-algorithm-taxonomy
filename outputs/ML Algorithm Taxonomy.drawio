        <mxCell id="tstests-555" value="Restricted: \(y_t = \sum a_i y_{t-i} + e_t\)&lt;br&gt;Unrestricted: \(y_t = \sum a_i y_{t-i} + \sum b_i x_{t-i} + e_t\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1870.0" y="2640.0" width="500.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-556" value="$$F = \frac{(RSS_R - RSS_U)/p}{RSS_U/(n-2p-1)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1910.0" y="2690.0" width="360.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-557" value="H₀: all bᵢ = 0 (x does not Granger-cause y). &amp;#x27;Predictive&amp;#x27;, not true causation; both series must be stationary." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1870.0" y="2740.0" width="500.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-558" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can I model this series as it is?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only if mean &amp; spread stay constant (AR(1) ✓); the five ✗ series need a transform first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="806.0" width="430.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-559" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1380.0" y="806.0" as="sourcePoint" />
            <mxPoint x="1380.0" y="710.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-560" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Do shocks to this series ever fade away?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ φ = 0.5 yes (stationary); φ = 1 never (unit root); φ = 1.02 they grow (explosive)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2120.0" y="595.0" width="240.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-561" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2120.0" y="629.0" as="sourcePoint" />
            <mxPoint x="2097.0" y="597.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-562" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is this price series stationary?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ τ = −2.22 &gt; −2.86 → cannot reject a unit root: difference it first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1368.0" y="1175.0" width="128.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-563" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1368.0" y="1223.0" as="sourcePoint" />
            <mxPoint x="1290.0" y="1182.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-564" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How do I make a non-stationary series usable?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ apply the matching fix (difference / detrend / seasonal diff / log) until ADF says stationary&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
