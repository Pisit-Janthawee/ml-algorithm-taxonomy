        <mxCell id="tstests-249" value="γ̂ = -0.014&lt;br&gt;τ = &lt;b&gt;-2.22&lt;/b&gt; &amp;gt; −2.86&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;fail to reject H₀&lt;/b&gt;&lt;/font&gt;&lt;br&gt;→ unit root" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
