        <mxCell id="recsys-213" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;user&lt;/th&gt;&lt;th&gt;\(\bar{r}_u\)&lt;/th&gt;&lt;th&gt;I1&lt;/th&gt;&lt;th&gt;I2&lt;/th&gt;&lt;th&gt;I3&lt;/th&gt;&lt;th&gt;I4&lt;/th&gt;&lt;th&gt;I5&lt;/th&gt;&lt;th&gt;I6&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;U1&lt;/td&gt;&lt;td&gt;3.00&lt;/td&gt;&lt;td&gt;+2.00&lt;/td&gt;&lt;td&gt;+1.00&lt;/td&gt;&lt;td&gt;·&lt;/td&gt;&lt;td&gt;-2.00&lt;/td&gt;&lt;td&gt;·&lt;/td&gt;&lt;td&gt;-1.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;U2&lt;/td&gt;&lt;td&gt;2.67&lt;/td&gt;&lt;td&gt;+1.33&lt;/td&gt;&lt;td&gt;+2.33&lt;/td&gt;&lt;td&gt;-1.67&lt;/td&gt;&lt;td&gt;-0.67&lt;/td&gt;&lt;td&gt;+0.33&lt;/td&gt;&lt;td&gt;-1.67&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;U3&lt;/td&gt;&lt;td&gt;2.80&lt;/td&gt;&lt;td&gt;+2.20&lt;/td&gt;&lt;td&gt;+1.20&lt;/td&gt;&lt;td&gt;-0.80&lt;/td&gt;&lt;td&gt;-1.80&lt;/td&gt;&lt;td&gt;-0.80&lt;/td&gt;&lt;td&gt;·&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;U4&lt;/td&gt;&lt;td&gt;3.50&lt;/td&gt;&lt;td&gt;-2.50&lt;/td&gt;&lt;td&gt;-1.50&lt;/td&gt;&lt;td&gt;+1.50&lt;/td&gt;&lt;td&gt;+0.50&lt;/td&gt;&lt;td&gt;+0.50&lt;/td&gt;&lt;td&gt;+1.50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;U5&lt;/td&gt;&lt;td&gt;4.00&lt;/td&gt;&lt;td&gt;-2.00&lt;/td&gt;&lt;td&gt;·&lt;/td&gt;&lt;td&gt;+0.00&lt;/td&gt;&lt;td&gt;+1.00&lt;/td&gt;&lt;td&gt;+1.00&lt;/td&gt;&lt;td&gt;+0.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;U6&lt;/td&gt;&lt;td&gt;3.20&lt;/td&gt;&lt;td&gt;+0.80&lt;/td&gt;&lt;td&gt;+1.80&lt;/td&gt;&lt;td&gt;-1.20&lt;/td&gt;&lt;td&gt;·&lt;/td&gt;&lt;td&gt;-0.20&lt;/td&gt;&lt;td&gt;-1.20&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
