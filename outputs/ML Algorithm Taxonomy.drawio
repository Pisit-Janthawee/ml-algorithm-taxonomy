        </mxCell>
        <mxCell id="statistics-727" value="&lt;b&gt;Example:&lt;/b&gt; μ₀ = 50, n = 25, x̄ = 55, σ = 10 → z = (55 − 50)/2 = 2.5 → two-tailed p = 2·(1 − Φ(2.5)) = 0.012 ≤ 0.05 → &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;reject H₀&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
