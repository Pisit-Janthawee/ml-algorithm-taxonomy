        <mxCell id="ensemble-1236" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is combining the models better than the best single one?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ stacked 92% vs best base model 92% and soft vote 93%; gains are usually small — use it when base models are diverse&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
