        <mxCell id="deeplearning-408" value="(a) Learning-rate range test" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
