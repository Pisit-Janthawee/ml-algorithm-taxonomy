        <mxCell id="classification-207" value="y = 1:  −log(p̂)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
