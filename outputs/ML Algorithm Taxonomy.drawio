        <mxCell id="timeseries-369" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;ACF = correlation with lag k (including indirect effects through lags in between)&lt;/li&gt;&lt;li&gt;PACF = direct correlation with lag k after removing lags 1 … k−1&lt;/li&gt;&lt;li&gt;Here: PACF has one significant bar → choose &lt;b&gt;p = 1&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="760.0" width="620.0" height="85.0" as="geometry" />
