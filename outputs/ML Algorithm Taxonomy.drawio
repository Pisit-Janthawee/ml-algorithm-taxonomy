          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-832" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Decision ↓ / Truth →&lt;/th&gt;&lt;th&gt;H₀ true&lt;/th&gt;&lt;th&gt;H₀ false&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reject H₀&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;Type I error (α)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;Correct (power)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fail to reject H₀&lt;/td&gt;&lt;td&gt;Correct (1 − α)&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#3333FF&quot;&gt;Type II error (β)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="1740.0" width="300.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-833" value="&lt;b&gt;Trade-off:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Lower α → fewer false alarms but more misses (higher β)&lt;/li&gt;&lt;li&gt;Power ↑ with larger n, larger effect size, higher α&lt;/li&gt;&lt;li&gt;Typical target: power ≥ 0.8&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="1870.0" width="300.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-834" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How likely am I to detect an effect that really exists?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ power = green area = 0.80; grow it with larger n or a bigger effect size&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="1975.0" width="300.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-835" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060.0" y="1975.0" as="sourcePoint" />
            <mxPoint x="854.9" y="1884.4" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-836" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;ML analogy: Type I = &lt;b&gt;false positive&lt;/b&gt;, Type II = &lt;b&gt;false negative&lt;/b&gt; (confusion matrix on the Logistic Regression page)&lt;/li&gt;&lt;li&gt;p-value = probability of data at least this extreme &lt;i&gt;if H₀ is true&lt;/i&gt; — it is not the probability that H₀ is true&lt;/li&gt;&lt;li&gt;Statistically significant ≠ practically important: always report the effect size / confidence interval&lt;/li&gt;&lt;li&gt;Running many tests inflates false positives → Bonferroni correction (α / m)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2070.0" width="940.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-837" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1640.0" width="980.0" height="600.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-838" value="⑦ Choosing a Test  ·  t vs Normal" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1434.0" y="1650.0" width="952.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-839" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Test&lt;/th&gt;&lt;th&gt;Question&lt;/th&gt;&lt;th&gt;Statistic&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Z-test&lt;/td&gt;&lt;td&gt;mean vs μ₀, σ known / large n&lt;/td&gt;&lt;td&gt;\(z=\frac{\bar{x}-\mu_0}{\sigma/\sqrt{n}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;One-sample t&lt;/td&gt;&lt;td&gt;mean vs μ₀, σ unknown&lt;/td&gt;&lt;td&gt;\(t=\frac{\bar{x}-\mu_0}{s/\sqrt{n}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Two-sample t&lt;/td&gt;&lt;td&gt;two group means differ?&lt;/td&gt;&lt;td&gt;\(t=\frac{\bar{x}_1-\bar{x}_2}{\sqrt{s_1^2/n_1+s_2^2/n_2}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Paired t&lt;/td&gt;&lt;td&gt;before vs after (same subjects)&lt;/td&gt;&lt;td&gt;\(t=\frac{\bar{d}}{s_d/\sqrt{n}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Chi-square&lt;/td&gt;&lt;td&gt;categorical variables independent?&lt;/td&gt;&lt;td&gt;\(\chi^2=\sum\frac{(O-E)^2}{E}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ANOVA&lt;/td&gt;&lt;td&gt;3+ group means differ?&lt;/td&gt;&lt;td&gt;\(F=\frac{MS_{between}}{MS_{within}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Pearson r&lt;/td&gt;&lt;td&gt;linear correlation ≠ 0?&lt;/td&gt;&lt;td&gt;\(t=\frac{r\sqrt{n-2}}{\sqrt{1-r^2}}\)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="1690.0" width="600.0" height="330.0" as="geometry" />
        </mxCell>
