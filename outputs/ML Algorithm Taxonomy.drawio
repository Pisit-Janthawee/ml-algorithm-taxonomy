            <mxPoint x="923.6" y="1120.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-217" value="x (thousand)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1152.0" width="100.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-218" value="&lt;b&gt;Read it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;font color='#3333FF'&gt;Blue band&lt;/font&gt; = μ ± 1σ (≈ 68% of normal data)&lt;/li&gt;&lt;li&gt;&lt;font color='#FF8000'&gt;Orange&lt;/font&gt; = μ ± 2σ (≈ 95%),  &lt;font color='#FF0000'&gt;red&lt;/font&gt; = μ ± 3σ (≈ 99.7%)&lt;/li&gt;&lt;li&gt;Points outside μ ± 3σ are flagged as anomalies&lt;/li&gt;&lt;li&gt;Multivariate version: Mahalanobis distance \(\sqrt{(x-\mu)^T\Sigma^{-1}(x-\mu)}\)&lt;/li&gt;&lt;li&gt;Rolling z-score (moving μ, σ) for time series / price returns&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1190.0" width="580.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-219" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is the 85 day inside the normal range?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ No: it lies beyond μ + 3σ (z = 3.27) while every other day stays within ±1σ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1300.0" width="580.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-220" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="923.6" y="1300.0" as="sourcePoint" />
            <mxPoint x="923.6" y="1114.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-221" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="900.0" width="620.0" height="600.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-222" value="⑤ Robust variant: Modified Z-score (median &amp;amp; MAD)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1074.0" y="910.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-223" value="$$M_i = \frac{0.6745\,(x_i - \tilde{x})}{MAD}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="960.0" width="540.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-224" value="$$MAD = \text{median}\left(|x_i - \tilde{x}|\right)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1025.0" width="540.0" height="40.0" as="geometry" />
        </mxCell>
