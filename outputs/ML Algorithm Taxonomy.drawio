        <mxCell id="clustering-553" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Where do extra clusters stop paying off?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ at k = 4: WCSS falls 239 to reach k=4, then only 16 more&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780.0" y="1754.0" width="220.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-554" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780.0" y="1822.0" as="sourcePoint" />
            <mxPoint x="691.1" y="1956.3" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-555" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;k&lt;/th&gt;&lt;th&gt;1&lt;/th&gt;&lt;th&gt;2&lt;/th&gt;&lt;th&gt;3&lt;/th&gt;&lt;th&gt;4&lt;/th&gt;&lt;th&gt;5&lt;/th&gt;&lt;th&gt;6&lt;/th&gt;&lt;th&gt;7&lt;/th&gt;&lt;th&gt;8&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;WCSS&lt;/td&gt;&lt;td&gt;1282&lt;/td&gt;&lt;td&gt;630&lt;/td&gt;&lt;td&gt;337&lt;/td&gt;&lt;td&gt;98&lt;/td&gt;&lt;td&gt;81&lt;/td&gt;&lt;td&gt;73&lt;/td&gt;&lt;td&gt;56&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;drop&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;652&lt;/td&gt;&lt;td&gt;294&lt;/td&gt;&lt;td&gt;239&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="2015.0" width="580.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-556" value="&lt;b&gt;Read it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Big drops until k = 4, then small gains → adding clusters only splits real groups&lt;/li&gt;&lt;li&gt;Knee rule (Kneedle): normalise both axes, pick the point farthest from the chord&lt;/li&gt;&lt;li&gt;Weakness: the bend is often vague → confirm with Silhouette / Gap ⑦ ⑧&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2095.0" width="600.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-557" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="1560.0" width="1320.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-558" value="⑦ Silhouette Method" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="1570.0" width="1292.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-559" value="How well each point sits in its own cluster vs the nearest other cluster" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="1596.0" width="1292.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-560" value="$$s(i) = \frac{b(i) - a(i)}{\max\{a(i),\ b(i)\}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1110.0" y="1620.0" width="300.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-561" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(a(i)\) = mean distance to points in its &lt;b&gt;own&lt;/b&gt; cluster (cohesion)&lt;/li&gt;&lt;li&gt;\(b(i)\) = mean distance to points of the &lt;b&gt;nearest other&lt;/b&gt; cluster (separation)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1618.0" width="560.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-562" value="&lt;b&gt;Range:&lt;/b&gt; &lt;font color=&quot;#009900&quot;&gt;+1 well clustered&lt;/font&gt; · 0 on the border · &lt;font color=&quot;#FF0000&quot;&gt;−1 probably in the wrong cluster&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
