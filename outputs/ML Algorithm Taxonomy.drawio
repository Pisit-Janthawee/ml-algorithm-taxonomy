        <mxCell id="statistics-547" value="$$\bar{X} \;\sim\; N\!\left(\mu,\ \frac{\sigma^2}{n}\right)\quad \text{as } n \to \infty$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1230.0" y="800.0" width="520.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-548" value="$$Z = \frac{\bar{X}-\mu}{\sigma/\sqrt{n}} \;\to\; N(0,1)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="800.0" width="330.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-549" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can I use normal-based tests on a non-normal variable?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes, for the mean: at n = 30 even bimodal data gives a bell-shaped x̄ (black curve fits)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2045.0" y="795.0" width="345.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-550" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2212.5" y="795.0" as="sourcePoint" />
            <mxPoint x="2212.5" y="680.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-551" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Rule of thumb: &lt;b&gt;n ≥ 30&lt;/b&gt; is usually enough (skewed populations need more; already-normal populations need any n)  ·  Black curve = normal predicted by the CLT, red line = population mean μ&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
