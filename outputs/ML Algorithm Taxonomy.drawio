        <mxCell id="featureeng-808" value="$$EMA_t=\alpha p_t+(1-\alpha)EMA_{t-1},\ \alpha=\tfrac{2}{n+1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2120.0" width="330.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-809" value="$$RSI=100-\frac{100}{1+\overline{gain}/\overline{loss}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2120.0" width="260.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-810" value="$$BB=SMA_{20}\pm2\sigma_{20}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2060.0" y="2120.0" width="300.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-811" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;t&lt;/th&gt;&lt;th&gt;close&lt;/th&gt;&lt;th&gt;ret&lt;/th&gt;&lt;th&gt;ret_lag1&lt;/th&gt;&lt;th&gt;roll_mean3 (shift 1)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;100.36&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;99.46&lt;/td&gt;&lt;td&gt;-0.89%&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;99.84&lt;/td&gt;&lt;td&gt;+0.39%&lt;/td&gt;&lt;td&gt;-0.89%&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;100.01&lt;/td&gt;&lt;td&gt;+0.17%&lt;/td&gt;&lt;td&gt;+0.39%&lt;/td&gt;&lt;td&gt;NaN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;99.29&lt;/td&gt;&lt;td&gt;-0.72%&lt;/td&gt;&lt;td&gt;+0.17%&lt;/td&gt;&lt;td&gt;-0.11%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;98.06&lt;/td&gt;&lt;td&gt;-1.24%&lt;/td&gt;&lt;td&gt;-0.72%&lt;/td&gt;&lt;td&gt;-0.06%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2170.0" width="470.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-812" value="first rows are NaN → drop them; never back-fill from the future" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2325.0" width="470.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-813" value="&lt;b&gt;Leakage checklist:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Features at time t use data up to t (shift(1) for anything built from the target)&lt;/li&gt;&lt;li&gt;Rolling windows must be trailing, never centered&lt;/li&gt;&lt;li&gt;Scale / impute with statistics from the training window only&lt;/li&gt;&lt;li&gt;Missing values: forward-fill prices; median for tabular; add an 'is_missing' flag&lt;/li&gt;&lt;li&gt;Re-check after every new feature: train score ≫ test score ⇒ suspect leakage&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1950.0" y="2165.0" width="430.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-814" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How unusual is this row compared with the others?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ row 3: price z = +3.53 → 3.5 σ above the mean, a likely outlier&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="862.0" width="420.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-815" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="657.0" y="862.0" as="sourcePoint" />
            <mxPoint x="657.0" y="772.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="featureeng-816" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which scaler should I use when the data has outliers?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Robust (median / IQR): the outlier doesn't inflate its spread; Min-Max squashes the rest into ~[0, 0.2]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="822.0" width="255.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-817" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1653.0" y="822.0" as="sourcePoint" />
            <mxPoint x="1653.0" y="760.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="featureeng-818" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Did the transform make the feature roughly symmetric?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: skewness +2.33 → −0.02 (log, Box-Cox) and +0.07 (Yeo-Johnson); |g₁| &lt; 0.5 ≈ symmetric&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000.0" y="1565.0" width="365.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-819" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1145.0" y="1565.0" as="sourcePoint" />
            <mxPoint x="1145.0" y="1455.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="featureeng-820" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can the model use the order Low &lt; Mid &lt; High?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes — ordinal codes 1, 2, 3 keep the order; nominal sectors need one-hot so no fake order is implied&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2050.0" y="1225.0" width="330.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-821" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2110.0" y="1225.0" as="sourcePoint" />
            <mxPoint x="2110.0" y="1125.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="featureeng-822" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why add the product x₁·x₂ as a new column?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ on z = x₁x₂ one threshold (z = 0) separates red from blue, so a linear model can solve it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="840.0" y="2290.0" width="200.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-823" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="879.0" y="2290.0" as="sourcePoint" />
            <mxPoint x="879.0" y="2138.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="featureeng-824" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can this feature be computed at prediction time without the future?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: ret_lag1 and roll_mean3 are shifted one bar, so row t only uses data up to t−1 (first rows NaN)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1830.0" y="2262.0" width="540.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-825" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1830.0" y="2262.0" as="sourcePoint" />
            <mxPoint x="1755.0" y="2199.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
