            <mxPoint x="1318.7" y="2563.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-439" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#009900;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1227.0" y="2670.1" width="10.0" height="10.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-440" value="train" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="1666.0" y="2777.8" width="120.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-441" value="validation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF8000;" vertex="1" parent="1">
          <mxGeometry x="1676.0" y="2561.0" width="120.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-442" value="best epoch 24 (val loss 0.537) → restore these weights" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2490.0" width="270.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-443" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1450.0" y="2499.0" as="sourcePoint" />
            <mxPoint x="1232.0" y="2675.1" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-444" value="stop at epoch 64 after 40 epochs without improvement" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="2840.0" width="290.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-445" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420.0" y="2849.0" as="sourcePoint" />
            <mxPoint x="1318.7" y="2685.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-446" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Small noisy train set (50 rows, 12 % flipped labels) + 12 hidden units → the net starts to memorize&lt;/li&gt;&lt;li&gt;Validation loss rises while train loss keeps falling = &lt;b&gt;overfitting&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Keep the weights of the best validation epoch; patience = how long to wait&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="2870.0" width="600.0" height="66.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-447" value="(c) Search the remaining hyperparameters" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2484.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-448" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Hyperparameter&lt;/th&gt;&lt;th&gt;Typical range&lt;/th&gt;&lt;th&gt;Effect&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Learning rate α&lt;/td&gt;&lt;td&gt;from range test (1e-4 … 1)&lt;/td&gt;&lt;td&gt;speed / stability&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Batch size&lt;/td&gt;&lt;td&gt;16, 32, 64, 128&lt;/td&gt;&lt;td&gt;small = noisy, regularizing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hidden width&lt;/td&gt;&lt;td&gt;8 … 512&lt;/td&gt;&lt;td&gt;capacity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Depth (layers)&lt;/td&gt;&lt;td&gt;1 … 4 for tabular&lt;/td&gt;&lt;td&gt;capacity, harder to train&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Dropout p&lt;/td&gt;&lt;td&gt;0 … 0.5&lt;/td&gt;&lt;td&gt;randomly zero units → less co-adaptation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Weight decay λ&lt;/td&gt;&lt;td&gt;1e-6 … 1e-2&lt;/td&gt;&lt;td&gt;L2 penalty \(\lambda\lVert W\rVert^2\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Epochs&lt;/td&gt;&lt;td&gt;early stopping decides&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2512.0" width="590.0" height="230.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-449" value="$$J = L + \lambda\sum W^2,\qquad h_{drop} = h\odot m,\ m_k\sim Bernoulli(1-p)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2755.0" width="590.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-450" value="&lt;b&gt;Procedure:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Order: fix α (range test) → early stopping → random search over the rest&lt;/li&gt;&lt;li&gt;&lt;b&gt;Random search&lt;/b&gt; beats grid search when few hyperparameters matter; &lt;b&gt;Bayesian optimization&lt;/b&gt; (Optuna) uses past trials&lt;/li&gt;&lt;li&gt;Evaluate every trial on the same validation split (time-ordered for trading data!)&lt;/li&gt;&lt;li&gt;Report the final score once on an untouched test set&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2810.0" width="590.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-451" value="Beyond the MLP: the ANN family (CNN, RNN, LSTM / GRU, Transformer)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3080.0" width="1600.0" height="35.2" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-452" value="Every architecture keeps the MLP core  z = Wx + b → g(z), trained by backpropagation + gradient descent; they only change HOW neurons are connected and which weights are shared." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3114.0" width="2000.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-453" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3150.0" width="760.0" height="760.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-454" value="⑨ ANN family tree: ★ MLP is the base" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="3160.0" width="732.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-455" value="Each child adds one idea to the MLP" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="3186.0" width="732.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-456" value="Artificial Neural Network (ANN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="630.0" y="3220.0" width="300.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-457" value="★ MLP — feed-forward, fully connected" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFF00;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="605.0" y="3300.0" width="350.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-458" value="simplest deep ANN" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="deeplearning-456" target="deeplearning-457">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-459" value="&lt;b&gt;CNN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;local, shared filters (space)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3440.0" width="220.0" height="64.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-460" value="&lt;b&gt;RNN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;hidden state loop (time)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="670.0" y="3440.0" width="220.0" height="64.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-461" value="&lt;b&gt;Autoencoder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;MLP encoder → bottleneck → decoder&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="3440.0" width="220.0" height="64.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-462" value="+ convolution" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="deeplearning-457" target="deeplearning-459">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-463" value="+ recurrence" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="deeplearning-457" target="deeplearning-460">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-464" value="+ bottleneck" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="deeplearning-457" target="deeplearning-461">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-465" value="&lt;b&gt;ResNet / U-Net&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;+ skip connections (very deep)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3570.0" width="220.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-466" value="&lt;b&gt;LSTM / GRU&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;+ gates → long memory&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="670.0" y="3570.0" width="220.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-467" value="&lt;b&gt;VAE / GAN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;generative models&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="3570.0" width="220.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-468" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="deeplearning-459" target="deeplearning-465">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-469" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="deeplearning-460" target="deeplearning-466">
