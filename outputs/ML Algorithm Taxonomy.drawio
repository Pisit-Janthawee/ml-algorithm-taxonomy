es&lt;/td&gt;&lt;td&gt;Time Series Hypothesis Tests &amp; Stationarity&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Augmented Dickey-Fuller (ADF)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Time Series&lt;/td&gt;&lt;td&gt;Time Series Data Labelling&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Fixed-Time Horizon&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Model Evaluation &amp; Validation&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Hold-out (Train / Validation / Test)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Feature Engineering&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Standardization (Z-score)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Explainability (XAI)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Permutation Importance&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Overfitting &amp; Underfitting&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Bias–Variance Trade-off&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Versatile Uses (Hidden Tricks)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;KNN Pixel Inpainting&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Recommender Systems&lt;/td&gt;&lt;td&gt;Recommendation Systems&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;User-based Collaborative Filtering&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ML Workflow&lt;/td&gt;&lt;td&gt;Common Data Problems&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Curse of Dimensionality&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvet