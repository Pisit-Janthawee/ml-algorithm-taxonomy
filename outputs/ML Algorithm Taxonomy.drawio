        <mxCell id="recsys-295" value="red = similar, blue = opposite (adjusted cosine)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1386.0" width="340.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-296" value="$$sim(i,j)=\frac{\sum_u (r_{ui}-\bar r_u)(r_{uj}-\bar r_u)}{\sqrt{\sum_u (r_{ui}-\bar r_u)^2}\sqrt{\sum_u (r_{uj}-\bar r_u)^2}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1420.0" width="440.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-297" value="Predict r(Ann, I5) from items Ann rated that are similar to I5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1840.0" y="1070.0" width="540.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-298" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;item j&lt;/th&gt;&lt;th&gt;sim(I5, j)&lt;/th&gt;&lt;th&gt;Ann's r(j)&lt;/th&gt;&lt;th&gt;use?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;I1&lt;/td&gt;&lt;td&gt;-0.791&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;I2&lt;/td&gt;&lt;td&gt;-0.360&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;I4&lt;/td&gt;&lt;td&gt;+0.785&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;✔ top-2&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;I6&lt;/td&gt;&lt;td&gt;+0.144&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;✔ top-2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1840.0" y="1095.0" width="340.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-299" value="$$\hat r_{ui} = \frac{\sum_{j \in N_k(i)} sim(i,j)\, r_{uj}}{\sum_{j\in N_k(i)} |sim(i,j)|}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1840.0" y="1225.0" width="400.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-300" value="\(\hat r = \frac{0.785\cdot1 + 0.144\cdot2}{0.785+0.144} = \) &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;1.16&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1840.0" y="1290.0" width="520.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-301" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Do the items most like I5 tell us anything about Ann?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: I5's closest items (I4, I6) got only 1 and 2 from Ann → predicted 1.16; same verdict as user-based (2.47)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1980.0" y="1350.0" width="380.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-302" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1980.0" y="1350.0" as="sourcePoint" />
            <mxPoint x="1678.0" y="1306.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="recsys-303" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;User-based ★&lt;/th&gt;&lt;th&gt;Item-based&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Neighbours&lt;/td&gt;&lt;td&gt;similar users&lt;/td&gt;&lt;td&gt;similar items&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Stability&lt;/td&gt;&lt;td&gt;user tastes drift, many users&lt;/td&gt;&lt;td&gt;item similarities change slowly → precompute&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Scale&lt;/td&gt;&lt;td&gt;#users usually ≫ #items → costly&lt;/td&gt;&lt;td&gt;cheaper online lookup (Amazon, 2003)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Explanation&lt;/td&gt;&lt;td&gt;'people like you liked…'&lt;/td&gt;&lt;td&gt;'because you liked I4…'&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1500.0" width="900.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-304" value="Both are k-NN on the rating matrix (see k-NN page) — only the axis differs." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1635.0" width="900.0" height="18.0" as="geometry" />
