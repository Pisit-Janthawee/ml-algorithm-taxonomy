        </mxCell>
        <mxCell id="datanature-706" value="Missing data mechanisms" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1370.0" y="1832.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-707" value="&lt;b&gt;MCAR&lt;/b&gt; — Missing Completely At Random&lt;br&gt;&lt;br&gt;&lt;i&gt;e.g.&lt;/i&gt; Sensor glitch drops random ticks&lt;br&gt;&lt;b&gt;Handle:&lt;/b&gt; Drop rows or mean / median impute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1370.0" y="1858.0" width="320.0" height="124.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-708" value="&lt;b&gt;MAR&lt;/b&gt; — Missing At Random (depends on observed data)&lt;br&gt;&lt;br&gt;&lt;i&gt;e.g.&lt;/i&gt; Volume missing more often for small-cap stocks&lt;br&gt;&lt;b&gt;Handle:&lt;/b&gt; Model-based / KNN / iterative impute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1710.0" y="1858.0" width="320.0" height="124.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-709" value="&lt;b&gt;MNAR&lt;/b&gt; — Missing Not At Random (depends on the missing value itself)&lt;br&gt;&lt;br&gt;&lt;i&gt;e.g.&lt;/i&gt; Firms hide bad earnings → missing&lt;br&gt;&lt;b&gt;Handle:&lt;/b&gt; Add an &amp;#x27;is_missing&amp;#x27; flag, domain modelling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2050.0" y="1858.0" width="320.0" height="124.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-710" value="Outliers &amp;amp; class imbalance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
