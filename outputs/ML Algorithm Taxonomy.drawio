        <mxCell id="deeplearning-226" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#FF0000;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1555.0" y="1068.0" as="sourcePoint" />
            <mxPoint x="1500.0" y="1068.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-227" value="forward: compute values" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="1002.0" width="260.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-228" value="backward: pass gradients (error) back" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1380.0" y="1142.0" width="290.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-229" value="$$\frac{\partial z^{(2)}}{\partial W^{(2)}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="1086.0" width="70.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-230" value="$$\frac{\partial \hat{y}}{\partial z^{(2)}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1350.0" y="1086.0" width="70.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-231" value="$$\frac{\partial L}{\partial \hat{y}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1495.0" y="1086.0" width="70.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-232" value="$$\frac{\partial L}{\partial W^{(2)}} = \frac{\partial L}{\partial \hat{y}}\cdot\frac{\partial \hat{y}}{\partial z^{(2)}}\cdot\frac{\partial z^{(2)}}{\partial W^{(2)}} = (\hat{y}-y)\,a^{(1)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1165.0" width="580.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-233" value="sigmoid + log-loss simplify to ŷ − y" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="1225.0" width="220.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-234" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1560.0" y="1234.0" as="sourcePoint" />
            <mxPoint x="1560.0" y="1208.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-235" value="Continue the example (α = 0.1):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1240.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-236" value="$$\hat{y}-y = 0.846-1 = -0.154$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1265.0" width="580.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-237" value="$$\frac{\partial L}{\partial W^{(2)}} = -0.154\,[0,\;3] = [0,\;-0.46]$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1300.0" width="580.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-238" value="$$W^{(2)} := W^{(2)} - \alpha\frac{\partial L}{\partial W^{(2)}} = [1,\;0.5] - 0.1[0,\;-0.46]$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1345.0" width="580.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-239" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does neuron 1's weight change?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ No: its ReLU output was 0 → gradient 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1545.0" y="1260.0" width="150.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-240" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1545.0" y="1301.0" as="sourcePoint" />
            <mxPoint x="1458.0" y="1336.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-241" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;\(W^{(2)} = [1,\;0.546]\)&lt;/span&gt; → ŷ moves closer to 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1390.0" width="580.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-242" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Gradients flow from the loss back to every layer, re-using values from the forward pass&lt;/li&gt;&lt;li&gt;Neuron 1 had ReLU output 0 → its weight gets gradient 0 (it 'did not fire')&lt;/li&gt;&lt;li&gt;Same update rule as Linear Regression's Gradient Descent — only the cost function differs&lt;/li&gt;&lt;li&gt;Optimizers: SGD, Momentum, &lt;b&gt;Adam&lt;/b&gt; (see Optimization page)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1440.0" width="580.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-243" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1740.0" y="920.0" width="660.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-244" value="⑥ Training: Loss vs. Epochs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1754.0" y="930.0" width="632.0" height="26.0" as="geometry" />
