          <mxGeometry x="1760.0" y="2260.0" width="640.0" height="720.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1227" value="⑩ Compare Methods &amp;amp; Choose k" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
