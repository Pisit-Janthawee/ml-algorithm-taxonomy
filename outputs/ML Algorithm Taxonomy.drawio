            <mxPoint x="2070.0" y="4000.8" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-1170" value="&lt;b&gt;When to use:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Hard&lt;/b&gt;: robust, needs only labels; ties need an odd number of models&lt;/li&gt;&lt;li&gt;&lt;b&gt;Soft&lt;/b&gt;: uses confidence; needs calibrated probabilities (Platt / isotonic)&lt;/li&gt;&lt;li&gt;Weighted voting: give better models more weight (e.g. by validation score)&lt;/li&gt;&lt;li&gt;Works best with &lt;b&gt;diverse&lt;/b&gt; models whose errors are not correlated&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="4140.0" width="600.0" height="105.0" as="geometry" />
