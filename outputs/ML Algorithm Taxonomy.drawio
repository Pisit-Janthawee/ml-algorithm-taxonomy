        <mxCell id="dimred-650" value="$$z_1 = 0.6x_1 + 0.5x_2 + \dots + 0.1x_6$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2050.0" y="1800.0" width="300.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-651" value="new meaning: combinations (PCA, LDA, autoencoder)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2040.0" y="1828.0" width="320.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-652" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Approach&lt;/th&gt;&lt;th&gt;How&lt;/th&gt;&lt;th&gt;Examples&lt;/th&gt;&lt;th&gt;Pros&lt;/th&gt;&lt;th&gt;Cons&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Filter (selection)&lt;/td&gt;&lt;td&gt;score each feature alone&lt;/td&gt;&lt;td&gt;correlation, χ², ANOVA F, mutual information, variance threshold&lt;/td&gt;&lt;td&gt;fast, model-free&lt;/td&gt;&lt;td&gt;ignores interactions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Wrapper (selection)&lt;/td&gt;&lt;td&gt;search subsets with a model&lt;/td&gt;&lt;td&gt;RFE, forward / backward selection&lt;/td&gt;&lt;td&gt;finds interactions&lt;/td&gt;&lt;td&gt;slow, overfit risk&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Embedded (selection)&lt;/td&gt;&lt;td&gt;selection inside training&lt;/td&gt;&lt;td&gt;Lasso (L1), tree / RF importance&lt;/td&gt;&lt;td&gt;efficient, model-aware&lt;/td&gt;&lt;td&gt;model-specific&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Extraction&lt;/td&gt;&lt;td&gt;new combined features&lt;/td&gt;&lt;td&gt;PCA, LDA, ICA, t-SNE, UMAP, autoencoder&lt;/td&gt;&lt;td&gt;compact, removes redundancy&lt;/td&gt;&lt;td&gt;harder to interpret&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="1865.0" width="920.0" height="170.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-653" value="&lt;b&gt;Which one?&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Need to explain which &lt;b&gt;original&lt;/b&gt; variables matter (e.g. which indicator drives the price) → &lt;b&gt;selection&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Many correlated features, only prediction matters (e.g. 50 technical indicators) → &lt;b&gt;extraction&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Fit any selection / PCA on the &lt;b&gt;training fold only&lt;/b&gt;, then apply to validation / test (avoid leakage)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="2055.0" width="920.0" height="85.0" as="geometry" />
        </mxCell>
