            <Array as="points">
              <mxPoint x="1320.0" y="4900.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-752" value="× tanh(c) → hₜ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="1260.0" y="4910.0" width="110.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-753" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910.0" y="5030.0" as="sourcePoint" />
            <mxPoint x="1330.0" y="5030.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-754" value="[hₜ₋₁, xₜ] feeds every gate (each gate = a small MLP layer with σ)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="950.0" y="5034.0" width="400.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-755" value="$$f_t=\sigma(W_f[h_{t-1},x_t]+b_f),\ \ i_t=\sigma(W_i[\cdot]+b_i),\ \ o_t=\sigma(W_o[\cdot]+b_o)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="5080.0" width="470.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-756" value="$$c_t = f_t\odot c_{t-1} + i_t\odot\tanh(W_c[\cdot]+b_c),\quad h_t = o_t\odot\tanh(c_t)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="5120.0" width="470.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-757" value="&amp;#x27;+&amp;#x27; path: gradient flows without repeated squashing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="5165.0" width="290.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-758" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1180.0" y="5174.0" as="sourcePoint" />
            <mxPoint x="1180.0" y="4842.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-759" value="&lt;b&gt;GRU&lt;/b&gt; (simpler, 2 gates): \(z_t\) update and \(r_t\) reset gate, no separate cell state: \(h_t=(1-z_t)\odot h_{t-1}+z_t\odot\tilde{h}_t\) — fewer parameters, often similar accuracy." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="5200.0" width="470.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-760" value="&lt;b&gt;Parameters&lt;/b&gt; per layer (input d, hidden h): RNN \(h(h+d+1)\), GRU \(3h(h+d+1)\), LSTM \(4h(h+d+1)\).  e.g. d = 5, h = 32 → RNN 1,216 · GRU 3,648 · LSTM 4,864" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="5260.0" width="470.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-761" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="4710.0" width="960.0" height="680.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-762" value="⑭ Choosing an architecture: MLP vs CNN vs RNN vs LSTM vs Transformer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1454.0" y="4720.0" width="932.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-763" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;★ MLP&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;CNN&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;RNN&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;LSTM / GRU&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;Transformer&lt;/b&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Best input&lt;/td&gt;&lt;td&gt;tabular vector&lt;/td&gt;&lt;td&gt;grid: image, 1-D signal&lt;/td&gt;&lt;td&gt;short sequences&lt;/td&gt;&lt;td&gt;long sequences&lt;/td&gt;&lt;td&gt;long sequences, text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Connection&lt;/td&gt;&lt;td&gt;all-to-all&lt;/td&gt;&lt;td&gt;local filters&lt;/td&gt;&lt;td&gt;loop over time&lt;/td&gt;&lt;td&gt;gated loop&lt;/td&gt;&lt;td&gt;attention all-to-all&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Weight sharing&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;across space&lt;/td&gt;&lt;td&gt;across time&lt;/td&gt;&lt;td&gt;across time&lt;/td&gt;&lt;td&gt;across positions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Inductive bias&lt;/td&gt;&lt;td&gt;none (most general)&lt;/td&gt;&lt;td&gt;locality, shift invariance&lt;/td&gt;&lt;td&gt;order, recency&lt;/td&gt;&lt;td&gt;order, long memory&lt;/td&gt;&lt;td&gt;pairwise relevance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Memory / context&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;receptive field&lt;/td&gt;&lt;td&gt;short (vanishing)&lt;/td&gt;&lt;td&gt;long (100s of steps)&lt;/td&gt;&lt;td&gt;whole window (quadratic cost)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Training&lt;/td&gt;&lt;td&gt;fast, parallel&lt;/td&gt;&lt;td&gt;fast, parallel (GPU)&lt;/td&gt;&lt;td&gt;sequential, slow&lt;/td&gt;&lt;td&gt;sequential, slower&lt;/td&gt;&lt;td&gt;parallel, data hungry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trading example&lt;/td&gt;&lt;td&gt;features → up/down&lt;/td&gt;&lt;td&gt;1-D conv on OHLCV, chart images&lt;/td&gt;&lt;td&gt;next-bar return&lt;/td&gt;&lt;td&gt;multi-day price + indicators&lt;/td&gt;&lt;td&gt;news headlines (BERT), long context&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Key assumption&lt;/td&gt;&lt;td&gt;i.i.d. rows, fixed-size input&lt;/td&gt;&lt;td&gt;local patterns matter, stationarity of features&lt;/td&gt;&lt;td&gt;Markov-like recent dependence&lt;/td&gt;&lt;td&gt;ordered, regularly sampled&lt;/td&gt;&lt;td&gt;large data, positional encoding&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="4760.0" width="920.0" height="360.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-764" value="&lt;b&gt;Rules of thumb:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Start with the &lt;b&gt;MLP&lt;/b&gt; (or gradient boosting) on engineered lag features → it is the baseline every deeper model must beat&lt;/li&gt;&lt;li&gt;Use &lt;b&gt;CNN&lt;/b&gt; when nearby values form patterns (images, local price shapes); &lt;b&gt;RNN/LSTM/GRU&lt;/b&gt; when order and memory matter&lt;/li&gt;&lt;li&gt;Use &lt;b&gt;Transformers&lt;/b&gt; for text or very long contexts with lots of data; hybrids (CNN-LSTM, LSTM + attention) are common&lt;/li&gt;&lt;li&gt;All of them: scale inputs, use time-ordered / purged validation for time series, early stopping &amp; dropout (panel ⑧)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="5150.0" width="920.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-765" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which network should I try first on tabular data?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the MLP (or gradient boosting) on lag features: the baseline that CNN / LSTM must beat&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2090.0" y="5160.0" width="290.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-766" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2090.0" y="5194.0" as="sourcePoint" />
            <mxPoint x="2065.0" y="5178.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
