          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-872" value="Average silhouette vs k" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2080.0" y="1980.0" width="280.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-873" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which k separates the groups best?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ k = 4: highest mean s = 0.71 (&gt; 0.7 = strong structure)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2085.0" y="2002.0" width="290.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-874" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2170.0" y="2002.0" as="sourcePoint" />
            <mxPoint x="2170.0" y="1763.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-875" value="&lt;b&gt;Read it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Pick the k with the &lt;b&gt;highest average silhouette&lt;/b&gt;, and check the knife plot: all clusters should pass the average and have similar thickness&lt;/li&gt;&lt;li&gt;Thin clusters or many negative bars (k = 5) → a real group was split; one very thick cluster (k = 3) → two groups were merged&lt;/li&gt;&lt;li&gt;Rule of thumb: s̄ &gt; 0.7 strong, 0.5–0.7 reasonable, 0.25–0.5 weak, &lt; 0.25 no real structure  ·  cost O(n²) → sample for big data&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="2090.0" width="1280.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-876" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="2260.0" width="1000.0" height="760.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-877" value="⑧ Gap Statistic · Calinski-Harabasz · Davies-Bouldin" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="2270.0" width="972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-878" value="Three more scores on the same k-means runs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
