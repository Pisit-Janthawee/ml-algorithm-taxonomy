        </mxCell>
        <mxCell id="tstests-168" value="φ = 1 → persists forever (unit root)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF8000;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="524.0" width="240.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-169" value="φ = 1.02 → grows (1.81 at t = 30)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="558.0" width="240.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-170" value="$$y_t = y_{t-1} + \varepsilon_t \;\Rightarrow\; y_t = y_0 + \sum_{i=1}^{t}\varepsilon_i,\quad Var(y_t) = t\,\sigma^2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="720.0" width="800.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-171" value="&lt;b&gt;Key idea:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Unit root&lt;/b&gt;: the root of \(1-\phi z = 0\) is \(z = 1\) → variance grows with t → &lt;b&gt;non-stationary&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Prices are usually unit-root (random walk); &lt;b&gt;returns&lt;/b&gt; \(\Delta \log p_t\) are usually stationary&lt;/li&gt;&lt;li&gt;Regressing one unit-root series on another gives &lt;b&gt;spurious&lt;/b&gt; results (see ⑤)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="770.0" width="820.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-172" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="920.0" width="1100.0" height="680.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-173" value="③ ★ Augmented Dickey-Fuller (ADF) Test" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="930.0" width="1072.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-174" value="Is there a unit root? Regress the change on the previous level" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="956.0" width="1072.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-175" value="$$\Delta y_t = \alpha + \beta t + \gamma\, y_{t-1} + \sum_{i=1}^{p}\delta_i\,\Delta y_{t-i} + \varepsilon_t$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="995.0" width="640.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-176" value="constant (drift)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460.0" y="1060.0" width="110.0" height="18.0" as="geometry" />
        </mxCell>
