        <mxCell id="problems-541" value="β₁ + β₂ ≈ 3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#808080;" vertex="1" parent="1">
