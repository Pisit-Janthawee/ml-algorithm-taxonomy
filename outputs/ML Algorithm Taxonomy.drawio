        <mxCell id="tstests-131" value="✘ variance changes (heteroscedastic)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="772.0" width="320.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-132" value="Most ML / statistical models assume the data-generating process does not change over time → test first, transform if needed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="840.0" width="1060.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-133" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1540.0" y="240.0" width="860.0" height="640.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-134" value="② Weak Stationarity &amp;amp; the Unit Root" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1554.0" y="250.0" width="832.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-135" value="What exactly must stay constant?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1554.0" y="276.0" width="832.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-136" value="$$E[y_t] = \mu$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="310.0" width="220.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-137" value="$$Var(y_t) = \sigma^2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="310.0" width="240.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-138" value="$$Cov(y_t, y_{t-k}) = \gamma_k$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2060.0" y="310.0" width="300.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-139" value="constant mean" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="344.0" width="220.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-140" value="constant variance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="344.0" width="240.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-141" value="depends only on lag k, not on t" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="2060.0" y="344.0" width="300.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-142" value="&lt;b&gt;Weak (covariance) stationarity&lt;/b&gt; = the 3 conditions above.&lt;br&gt;&lt;b&gt;Strict stationarity&lt;/b&gt; = the whole joint distribution is shift-invariant (stronger, rarely tested)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="370.0" width="800.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-143" value="Shock response: y₀ = 1, then yₜ = φ·yₜ₋₁ (no new noise)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="425.0" width="800.0" height="20.0" as="geometry" />
        </mxCell>
