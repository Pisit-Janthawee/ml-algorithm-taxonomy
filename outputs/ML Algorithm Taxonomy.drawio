        <mxCell id="featureeng-487" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;sector&lt;/th&gt;&lt;th&gt;\(n_c\)&lt;/th&gt;&lt;th&gt;\(\bar{y}_c\)&lt;/th&gt;&lt;th&gt;enc (m = 2)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tech&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.75&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Energy&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.25&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bank&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0.50&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.50&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="1340.0" width="300.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-488" value="global mean ȳ = 0.50; smoothing m pulls rare categories toward it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="1405.0" width="300.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-489" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;⚠ Leakage:&lt;/font&gt;&lt;/b&gt; compute it &lt;b&gt;out-of-fold&lt;/b&gt; (K-fold on train) — using the row's own target leaks the label" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2080.0" y="1340.0" width="300.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-490" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Encoding&lt;/th&gt;&lt;th&gt;Data type&lt;/th&gt;&lt;th&gt;Pros&lt;/th&gt;&lt;th&gt;Cons&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;One-Hot&lt;/td&gt;&lt;td&gt;nominal, low cardinality&lt;/td&gt;&lt;td&gt;no false order&lt;/td&gt;&lt;td&gt;many columns, sparse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ordinal&lt;/td&gt;&lt;td&gt;ordinal&lt;/td&gt;&lt;td&gt;1 column, keeps order&lt;/td&gt;&lt;td&gt;assumes equal spacing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Target / Mean&lt;/td&gt;&lt;td&gt;nominal, high cardinality&lt;/td&gt;&lt;td&gt;1 column, strong signal&lt;/td&gt;&lt;td&gt;leakage risk → out-of-fold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hashing / Binary&lt;/td&gt;&lt;td&gt;very high cardinality (tickers, IDs)&lt;/td&gt;&lt;td&gt;fixed size&lt;/td&gt;&lt;td&gt;collisions, not interpretable&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
