        <mxCell id="dimred-2847" value="Tight (σ = 0.3) vs wide (σ = 3)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2020.0" y="3938.0" width="350.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2848" value="true spread ratio 10× → in t-SNE only 1.0×" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2020.0" y="4184.0" width="350.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2849" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Do these clumps prove real clusters?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ no: t-SNE invents clumps in pure noise at low perplexity; confirm with other seeds / methods&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1630.0" y="4220.0" width="350.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2850" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1836.6" y="4220.0" as="sourcePoint" />
            <mxPoint x="1836.6" y="4140.8" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-2851" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is the big cluster really more spread out?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ you can't tell: t-SNE equalises density, a 10× difference shows as 1.0×&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2020.0" y="4220.0" width="350.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2852" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2195.0" y="4220.0" as="sourcePoint" />
            <mxPoint x="2195.0" y="4184.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-2853" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;✔ Do&lt;/th&gt;&lt;th&gt;✘ Don't&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Scale features; reduce to ~50 dims with PCA first&lt;/td&gt;&lt;td&gt;Read cluster sizes as real spreads&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Try several perplexities / n_neighbors and seeds&lt;/td&gt;&lt;td&gt;Read distances between clusters as similarity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Colour by known labels to check what you see&lt;/td&gt;&lt;td&gt;Trust a single run or a single setting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Use for exploration &amp; presentation&lt;/td&gt;&lt;td&gt;Feed t-SNE axes into a model (it can't transform new data)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1630.0" y="4330.0" width="740.0" height="140.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2854" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Use PCA when you need meaningful axes, variance and new-data transforms; t-SNE / UMAP to &lt;i&gt;see&lt;/i&gt; neighbourhoods&lt;/li&gt;&lt;li&gt;Simplified UMAP here: fuzzy kNN graph + UMAP's attract/repel SGD with negative sampling, PCA instead of spectral initialisation&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1630.0" y="4490.0" width="740.0" height="65.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
