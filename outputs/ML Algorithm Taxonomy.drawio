        <mxCell id="anomaly-127" value="|z| &amp;gt; 3 : outlier" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="620.0" width="100.0" height="18.0" as="geometry" />
