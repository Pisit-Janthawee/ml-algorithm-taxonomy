        <mxCell id="ensemble-288" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
