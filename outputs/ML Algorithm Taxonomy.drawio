          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-662" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3333FF;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1275.4" y="1382.7" width="6.0" height="6.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-663" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does each 95 % interval really contain μ?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ 20 of 20 do here; over many samples ≈ 95 % will — that is what '95 % confidence' means&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1505.0" y="1150.0" width="180.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-664" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1505.0" y="1198.0" as="sourcePoint" />
            <mxPoint x="1300.0" y="1228.6" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-665" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110.0" y="1410.0" as="sourcePoint" />
            <mxPoint x="1500.0" y="1410.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-666" value="42" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1095.0" y="1414.0" width="30.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-667" value="46" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1190.0" y="1414.0" width="30.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-668" value="50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1285.0" y="1414.0" width="30.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-669" value="54" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1380.0" y="1414.0" width="30.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-670" value="58" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1475.0" y="1414.0" width="30.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-671" value="20 samples (n = 25): 20 intervals contain μ, 0 miss (red) — on average 1 in 20 misses" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1435.0" width="560.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-672" value="&lt;b&gt;Example:&lt;/b&gt; n = 25, x̄ = 52, σ = 10 → SE = 2 → 95 % CI = 52 ± 1.96·2 = &lt;span style=&quot;background:#FFFF00&quot;&gt;[48.08, 55.92]&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1090.0" y="1465.0" width="580.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-673" value="&lt;b&gt;Interpretation:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;95 % is about the &lt;i&gt;method&lt;/i&gt;: 95 % of such intervals contain μ (not '95 % chance μ is inside this one')&lt;/li&gt;&lt;li&gt;Wider for higher confidence (99 % → z = 2.576) and narrower for larger n&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="1500.0" width="600.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-674" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1740.0" y="940.0" width="660.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-675" value="⑤ Hypothesis Testing (Z-test / t-test)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1754.0" y="950.0" width="632.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-676" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;1. State \(H_0: \mu = \mu_0\) and \(H_1: \mu \ne \mu_0\) (or \(\gt, \lt\))&lt;/li&gt;&lt;li&gt;2. Choose significance level \(\alpha\) (usually 0.05)&lt;/li&gt;&lt;li&gt;3. Compute the test statistic from the sample&lt;/li&gt;&lt;li&gt;4. Find the p-value (or compare with the critical value)&lt;/li&gt;&lt;li&gt;5. If \(p \le \alpha\) → reject \(H_0\); else fail to reject&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="985.0" width="380.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-677" value="$$z = \frac{\bar{x}-\mu_0}{\sigma/\sqrt{n}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2160.0" y="985.0" width="220.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-678" value="$$t = \frac{\bar{x}-\mu_0}{s/\sqrt{n}},\ df=n-1$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="1040.0" width="250.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-679" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1796.0" y="1335.0" as="sourcePoint" />
            <mxPoint x="2348.0" y="1335.0" as="targetPoint" />
