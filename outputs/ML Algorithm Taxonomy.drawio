        <mxCell id="anomaly-285" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;t&lt;/th&gt;&lt;th&gt;Close&lt;/th&gt;&lt;th&gt;Return \(r_t\)&lt;/th&gt;&lt;th&gt;\(\mu_{t}\) (prev 20)&lt;/th&gt;&lt;th&gt;\(\sigma_{t}\) (prev 20)&lt;/th&gt;&lt;th&gt;\(z_t\)&lt;/th&gt;&lt;th&gt;Flag |z|&amp;gt;3&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;47&lt;/td&gt;&lt;td&gt;103.15&lt;/td&gt;&lt;td&gt;-0.49%&lt;/td&gt;&lt;td&gt;+0.036%&lt;/td&gt;&lt;td&gt;0.481%&lt;/td&gt;&lt;td&gt;-1.08&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;48&lt;/td&gt;&lt;td&gt;102.74&lt;/td&gt;&lt;td&gt;-0.40%&lt;/td&gt;&lt;td&gt;+0.003%&lt;/td&gt;&lt;td&gt;0.493%&lt;/td&gt;&lt;td&gt;-0.82&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;49&lt;/td&gt;&lt;td&gt;103.00&lt;/td&gt;&lt;td&gt;+0.26%&lt;/td&gt;&lt;td&gt;-0.001%&lt;/td&gt;&lt;td&gt;0.497%&lt;/td&gt;&lt;td&gt;+0.52&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;102.51&lt;/td&gt;&lt;td&gt;-0.47%&lt;/td&gt;&lt;td&gt;-0.013%&lt;/td&gt;&lt;td&gt;0.488%&lt;/td&gt;&lt;td&gt;-0.94&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;51&lt;/td&gt;&lt;td&gt;102.67&lt;/td&gt;&lt;td&gt;+0.15%&lt;/td&gt;&lt;td&gt;-0.039%&lt;/td&gt;&lt;td&gt;0.498%&lt;/td&gt;&lt;td&gt;+0.38&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;104.70&lt;/td&gt;&lt;td&gt;+1.98%&lt;/td&gt;&lt;td&gt;-0.038%&lt;/td&gt;&lt;td&gt;0.498%&lt;/td&gt;&lt;td&gt;&lt;b&gt;+4.04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;ANOMALY&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;53&lt;/td&gt;&lt;td&gt;104.63&lt;/td&gt;&lt;td&gt;-0.06%&lt;/td&gt;&lt;td&gt;+0.049%&lt;/td&gt;&lt;td&gt;0.671%&lt;/td&gt;&lt;td&gt;-0.17&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;54&lt;/td&gt;&lt;td&gt;105.54&lt;/td&gt;&lt;td&gt;+0.87%&lt;/td&gt;&lt;td&gt;+0.059%&lt;/td&gt;&lt;td&gt;0.667%&lt;/td&gt;&lt;td&gt;+1.22&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;55&lt;/td&gt;&lt;td&gt;105.70&lt;/td&gt;&lt;td&gt;+0.15%&lt;/td&gt;&lt;td&gt;+0.100%&lt;/td&gt;&lt;td&gt;0.691%&lt;/td&gt;&lt;td&gt;+0.07&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1630.0" width="620.0" height="214.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-286" value="$$z_t = \frac{r_t - \mu_t}{\sigma_t},\quad \mu_t = \frac{1}{w}\sum_{i=t-w}^{t-1} r_i$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1890.0" width="620.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-287" value="only past data → no look-ahead bias" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="780.0" y="1945.0" width="230.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-288" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870.0" y="1954.0" as="sourcePoint" />
            <mxPoint x="870.0" y="1922.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-289" value="&lt;b&gt;How the algorithm reads the table:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Prices are non-stationary → work on &lt;b&gt;returns&lt;/b&gt; \(r_t = \frac{P_t}{P_{t-1}} - 1\)&lt;/li&gt;&lt;li&gt;A &lt;b&gt;rolling&lt;/b&gt; window adapts μ and σ to the current volatility regime&lt;/li&gt;&lt;li&gt;The current value is excluded from its own window, so a big spike cannot hide itself&lt;/li&gt;&lt;li&gt;Row t = 52: the return is 4.0 rolling σ away from the mean → flagged&lt;/li&gt;&lt;li&gt;&lt;b&gt;Masking&lt;/b&gt;: after a spike enters the window, σ stays inflated for w days (band bulges)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1980.0" width="620.0" height="125.0" as="geometry" />
        </mxCell>
