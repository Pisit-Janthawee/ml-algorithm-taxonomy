          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-429" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Kurtosis measures the &lt;b&gt;tails&lt;/b&gt; (extreme values) more than the peak&lt;/li&gt;&lt;li&gt;Financial returns are usually leptokurtic → extreme moves happen more often than a normal model predicts&lt;/li&gt;&lt;li&gt;High kurtosis → check outliers (Z-score / IQR) and use robust models / losses&lt;/li&gt;&lt;li&gt;Fourth power (vs. third for skewness, second for variance) makes far-away points dominate&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1380.0" width="960.0" height="105.0" as="geometry" />
        </mxCell>
