        <mxCell id="classification-380" value="&lt;font color=&quot;#3333FF&quot;&gt;● actual Up&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#FF0000&quot;&gt;● actual Down&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="490.0" y="2150.0" width="220.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-381" value="&lt;b&gt;Reading the plot:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Every row becomes one point on the sigmoid&lt;/li&gt;&lt;li&gt;Right of z = 0 → predicted Up, left → Down&lt;/li&gt;&lt;li&gt;Points of the wrong colour on a side are the errors&lt;/li&gt;&lt;li&gt;Distance from 0.5 = confidence; use p̂ for position sizing, not only the class&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2180.0" width="340.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-382" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How sure is the model about each day?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ distance of p̂ from 0.5: day 8 (p̂ = 0.02) is the most confident; points near the 0.5 line are coin-flips → bet smaller&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2315.0" width="340.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-383" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
