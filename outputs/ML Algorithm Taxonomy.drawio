        <mxCell id="featureeng-470" value="$$\text{Box-Cox: } y=\begin{cases}\frac{x^{\lambda}-1}{\lambda} &amp; \lambda\neq0\\ \ln x &amp; \lambda=0\end{cases}\quad (x\gt 0)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1505.0" width="460.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-471" value="$$\text{Yeo-Johnson: same idea on } (x+1)\text{, also works for } x \le 0$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1505.0" width="460.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-472" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;λ is chosen by maximum likelihood (here on a grid −1 … 1); λ = 0 ⇒ log, λ = 1 ⇒ no change, λ = 0.5 ⇒ ≈ √x&lt;/li&gt;&lt;li&gt;Check with a Q-Q plot / skewness (see Distributions page); trees don't need it, linear models &amp; z-score do&lt;/li&gt;&lt;li&gt;Returns are already ~symmetric → use log-returns instead of prices; fit λ on training data only&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1565.0" width="920.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-473" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="980.0" width="980.0" height="680.0" as="geometry" />
        </mxCell>
