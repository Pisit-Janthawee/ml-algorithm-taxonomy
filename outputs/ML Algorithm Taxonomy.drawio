        <mxCell id="ensemble-587" value="&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;— training error&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;— validation error&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
