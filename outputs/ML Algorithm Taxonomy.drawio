        <mxCell id="recsys-480" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Problem&lt;/th&gt;&lt;th&gt;Why it hurts&lt;/th&gt;&lt;th&gt;Fix&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cold start — new user&lt;/td&gt;&lt;td&gt;no ratings → no neighbours&lt;/td&gt;&lt;td&gt;popularity, onboarding questions, demographics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cold start — new item&lt;/td&gt;&lt;td&gt;nobody rated it yet&lt;/td&gt;&lt;td&gt;content-based (TF-IDF / embeddings) ②&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sparsity (14 % here, &gt; 99 % real)&lt;/td&gt;&lt;td&gt;few co-rated items → noisy similarity&lt;/td&gt;&lt;td&gt;matrix factorization ⑤, implicit feedback (clicks)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Popularity bias&lt;/td&gt;&lt;td&gt;rich get richer, filter bubble&lt;/td&gt;&lt;td&gt;re-ranking for diversity / novelty&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hybrid&lt;/td&gt;&lt;td&gt;each method has blind spots&lt;/td&gt;&lt;td&gt;weighted / switching / feature-combined models&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="2210.0" width="900.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-481" value="Offline metrics ≠ online success: confirm with an A/B test (Hypothesis Tests page)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="2380.0" width="900.0" height="18.0" as="geometry" />
        </mxCell>
      </root>
