          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-289" value="vertical barrier  \(t_1 = t_0 + h\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="962.0" width="170.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-290" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1052.4" y="971.0" as="sourcePoint" />
            <mxPoint x="1052.4" y="1207.7" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-291" value="A touches the upper barrier first → +1 · B touches the lower barrier first → −1 · C reaches t₁ without a touch → 0 (or sign of r)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="470.0" y="1400.0" width="780.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-292" value="Resulting labelled events (pt = sl = 1, h = 15 bars, σ = EWMA(span = 20) of log-returns)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1435.0" width="800.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-293" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;event&lt;/th&gt;&lt;th&gt;\(t_0\)&lt;/th&gt;&lt;th&gt;\(P_{t_0}\)&lt;/th&gt;&lt;th&gt;\(\sigma_{t_0}\)&lt;/th&gt;&lt;th&gt;upper&lt;/th&gt;&lt;th&gt;lower&lt;/th&gt;&lt;th&gt;\(t_1\)&lt;/th&gt;&lt;th&gt;first touch&lt;/th&gt;&lt;th&gt;barrier&lt;/th&gt;&lt;th&gt;return&lt;/th&gt;&lt;th&gt;label&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;A&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;97.73&lt;/td&gt;&lt;td&gt;1.06%&lt;/td&gt;&lt;td&gt;101.75&lt;/td&gt;&lt;td&gt;93.72&lt;/td&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;upper (profit-take)&lt;/td&gt;&lt;td&gt;+6.37%&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;font color=&quot;#009900&quot;&gt;+1&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;B&lt;/td&gt;&lt;td&gt;27&lt;/td&gt;&lt;td&gt;104.04&lt;/td&gt;&lt;td&gt;0.90%&lt;/td&gt;&lt;td&gt;107.68&lt;/td&gt;&lt;td&gt;100.40&lt;/td&gt;&lt;td&gt;42&lt;/td&gt;&lt;td&gt;33&lt;/td&gt;&lt;td&gt;lower (stop-loss)&lt;/td&gt;&lt;td&gt;-3.64%&lt;/td&gt;&lt;td&gt;&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;-1&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;41&lt;/td&gt;&lt;td&gt;102.53&lt;/td&gt;&lt;td&gt;1.19%&lt;/td&gt;&lt;td&gt;107.26&lt;/td&gt;&lt;td&gt;97.81&lt;/td&gt;&lt;td&gt;56&lt;/td&gt;&lt;td&gt;56&lt;/td&gt;&lt;td&gt;vertical (time)&lt;/td&gt;&lt;td&gt;+3.74%&lt;/td&gt;&lt;td&gt;&lt;b&gt;0&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1460.0" width="820.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-294" value="&lt;b&gt;Why it is better than the fixed horizon:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Label reflects what a real trade with take-profit, stop-loss and max holding time would do (path-dependent)&lt;/li&gt;&lt;li&gt;Barrier width follows volatility → balanced labels in calm and volatile regimes&lt;/li&gt;&lt;li&gt;Also returns the exit time t_touch: the label &lt;i&gt;span&lt;/i&gt; [t₀, t_touch] needed for sample weights &amp; purging ⑥&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1580.0" width="820.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-295" value="Daily volatility (EWMA)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="985.0" width="420.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-296" value="$$\sigma_t^2 = (1-\lambda)\,\sigma_{t-1}^2 + \lambda\, r_t^2,\quad \lambda=\frac{2}{span+1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1008.0" width="420.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-297" value="Label rule (first touch)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1055.0" width="420.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-298" value="$$y=\begin{cases}+1 &amp; \text{upper first}\\ -1 &amp; \text{lower first}\\ \ \ 0 \text{ or } \mathrm{sign}(r_{t_0,t_1}) &amp; \text{vertical first}\end{cases}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1078.0" width="420.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-299" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;parameter&lt;/th&gt;&lt;th&gt;meaning&lt;/th&gt;&lt;th&gt;here&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;pt&lt;/td&gt;&lt;td&gt;profit-take multiple of σ&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sl&lt;/td&gt;&lt;td&gt;stop-loss multiple of σ&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;h (t₁)&lt;/td&gt;&lt;td&gt;max holding period&lt;/td&gt;&lt;td&gt;15 bars&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;min ret&lt;/td&gt;&lt;td&gt;skip events with tiny σ&lt;/td&gt;&lt;td&gt;0.5 %&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;side&lt;/td&gt;&lt;td&gt;long / short (from primary model)&lt;/td&gt;&lt;td&gt;long&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1170.0" width="420.0" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-300" value="Barrier configurations [pt, sl, t₁]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1330.0" width="420.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-301" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;[pt, sl, t₁]&lt;/th&gt;&lt;th&gt;barriers active&lt;/th&gt;&lt;th&gt;use&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[1, 1, 1]&lt;/td&gt;&lt;td&gt;all three&lt;/td&gt;&lt;td&gt;standard labelling&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[0, 1, 1]&lt;/td&gt;&lt;td&gt;stop-loss + time&lt;/td&gt;&lt;td&gt;exit at t₁ unless stopped&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[1, 0, 1]&lt;/td&gt;&lt;td&gt;profit-take + time&lt;/td&gt;&lt;td&gt;take profit or time out&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[1, 1, 0]&lt;/td&gt;&lt;td&gt;no time limit&lt;/td&gt;&lt;td&gt;rare: may never finish&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1355.0" width="420.0" height="109.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-302" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;σ = ewma_std(log_returns, span=20)&lt;br&gt;for t0 in events:  # e.g. CUSUM&lt;br&gt;&amp;nbsp;&amp;nbsp;up = P[t0]·(1 + pt·σ[t0]·√h)&lt;br&gt;&amp;nbsp;&amp;nbsp;lo = P[t0]·(1 − sl·σ[t0]·√h)&lt;br&gt;&amp;nbsp;&amp;nbsp;path = P[t0+1 : t0+h]&lt;br&gt;&amp;nbsp;&amp;nbsp;t_up = first(path ≥ up); t_lo = first(path ≤ lo)&lt;br&gt;&amp;nbsp;&amp;nbsp;t_touch = min(t_up, t_lo, t0+h)&lt;br&gt;&amp;nbsp;&amp;nbsp;y = +1 if t_touch==t_up else −1 if t_touch==t_lo else 0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1290.0" y="1500.0" width="420.0" height="180.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-303" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="900.0" width="620.0" height="800.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-304" value="⑤ Meta-Labelling &amp;amp; Trend-Scanning" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1794.0" y="910.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-305" value="Features X (price, indicators, news)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="950.0" width="300.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-306" value="Primary model (rule / MA crossover) → side ±1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1012.0" width="300.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-307" value="Triple barrier using that side → meta-label: 1 = profit-take hit, 0 = otherwise" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1074.0" width="300.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-308" value="Secondary ML model (e.g. Random Forest) on X + side → P(success)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1136.0" width="300.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-309" value="Bet size = f(P), e.g. 2P − 1; skip trade if P &amp;lt; 0.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFF00;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1198.0" width="300.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-310" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="labelling-305" target="labelling-306">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labelling-311" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="labelling-306" target="labelling-307">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labelling-312" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="labelling-307" target="labelling-308">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labelling-313" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="labelling-308" target="labelling-309">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="labelling-314" value="&lt;b&gt;Why two models?&lt;/b&gt;&lt;br&gt;Primary: decides the &lt;i&gt;side&lt;/i&gt;, tuned for high &lt;b&gt;recall&lt;/b&gt; (catch most opportunities).&lt;br&gt;Secondary: decides &lt;i&gt;whether / how much&lt;/i&gt;, filters false positives → higher &lt;b&gt;precision&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2120.0" y="955.0" width="265.0" height="130.0" as="geometry" />
