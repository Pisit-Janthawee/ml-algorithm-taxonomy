        </mxCell>
        <mxCell id="explain-171" value="$$I_j = s_0 - \frac{1}{K}\sum_{k=1}^{K} s_{j,k}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1090.0" y="685.0" width="360.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-172" value="score with column j shuffled (k-th repeat)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="745.0" width="230.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-173" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1350.0" y="754.0" as="sourcePoint" />
            <mxPoint x="1360.0" y="718.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-174" value="baseline score on held-out data" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="660.0" width="200.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-175" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1185.0" y="669.0" as="sourcePoint" />
            <mxPoint x="1185.0" y="702.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-176" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;s0 = score(model, X_test, y_test)&lt;br&gt;for j in features:&lt;br&gt;&amp;nbsp;&amp;nbsp;for k in range(K):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Xp = X_test.copy(); shuffle(Xp[:, j])&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s[j, k] = score(model, Xp, y_test)&lt;br&gt;&amp;nbsp;&amp;nbsp;I[j] = s0 − mean(s[j])&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1490.0" y="670.0" width="470.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-177" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Model-agnostic: needs only predict() and a metric&lt;/li&gt;&lt;li&gt;Use &lt;b&gt;held-out&lt;/b&gt; data: on train it rewards overfitting&lt;/li&gt;&lt;li&gt;No retraining (cheap) — K × p extra predictions&lt;/li&gt;&lt;li&gt;Train accuracy 0.90 vs test 0.83&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1990.0" y="680.0" width="390.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-178" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Metric choice changes the ranking: use the metric you care about (accuracy, AUC, log loss, Sharpe of the signal) · negative I_j = shuffling helped by chance → treat as 0&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="840.0" width="1300.0" height="26.0" as="geometry" />
