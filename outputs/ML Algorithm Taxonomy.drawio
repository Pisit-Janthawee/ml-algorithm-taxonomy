        <mxCell id="dimred-1289" value="2 components with λ &amp;gt; 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2208.3" y="2582.7" width="150.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1290" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How many components do I need?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ k = 2 keeps 81% (Kaiser); ≤ 5% error needs k = 5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1880.0" y="2545.0" width="170.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1291" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1896.7" y="2613.0" as="sourcePoint" />
            <mxPoint x="1896.7" y="2679.8" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-1292" value="Data: 6 standardized features built from 2 hidden factors → eigenvalues 3.43, 1.45, 0.48, 0.24, 0.21, 0.19&lt;br&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;Kaiser → k = 2&lt;/b&gt; (81 % kept)&lt;/span&gt; · error ≤ 5 % → k = 5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2090.0" y="2730.0" width="290.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1293" value="&lt;b&gt;Choosing k:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Reconstruction error = share of variance thrown away; strict thresholds keep more PCs than Kaiser&lt;/li&gt;&lt;li&gt;Kaiser: on standardized data keep PCs that explain more than one original feature (λ &gt; 1)&lt;/li&gt;&lt;li&gt;Or: cumulative variance ≥ 90–95 % (scree, ⑤) · or tune k by downstream CV score&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2805.0" width="600.0" height="81.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1294" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3040.0" width="1000.0" height="780.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1295" value="⑪ t-SNE step by step (computed on 90 points in 10-D)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="3050.0" width="972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1296" value="t-distributed Stochastic Neighbour Embedding: keep each point&amp;#x27;s neighbours as neighbours in 2-D" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="3076.0" width="972.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1297" value="1. High-D similarities (Gaussian around each point)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3102.0" width="480.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1298" value="$$p_{j|i} = \frac{\exp\left(-\lVert x_i - x_j\rVert^2 / 2\sigma_i^2\right)}{\sum_{k\neq i}\exp\left(-\lVert x_i - x_k\rVert^2 / 2\sigma_i^2\right)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3126.0" width="480.0" height="64.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1299" value="$$p_{ij} = \frac{p_{j|i} + p_{i|j}}{2n}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3192.0" width="240.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1300" value="σᵢ found by binary search so that 2^H(Pᵢ) = perplexity" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="670.0" y="3200.0" width="230.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1301" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760.0" y="3209.0" as="sourcePoint" />
            <mxPoint x="760.0" y="3172.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-1302" value="Here perplexity = 30 → σᵢ ranges 1.41 … 2.77 (small σ in dense regions)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3242.0" width="480.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1303" value="2. Low-D similarities (Student-t, 1 degree of freedom)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3268.0" width="480.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1304" value="$$q_{ij} = \frac{\left(1 + \lVert y_i - y_j\rVert^2\right)^{-1}}{\sum_{k\neq l}\left(1 + \lVert y_k - y_l\rVert^2\right)^{-1}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3292.0" width="480.0" height="60.0" as="geometry" />
        </mxCell>
