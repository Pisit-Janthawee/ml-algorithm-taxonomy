        <mxCell id="featureeng-781" value="23 h and 0 h are neighbours (raw 23 vs 0 looks far)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2267.0" width="300.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-782" value="$$x_{sin}=\sin\frac{2\pi h}{24},\ \ x_{cos}=\cos\frac{2\pi h}{24}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2300.0" width="320.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="featureeng-783" value="&lt;b&gt;More feature ideas:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Polynomial terms x², x³ let linear models fit curves (see Regression page)&lt;/li&gt;&lt;li&gt;Ratios &amp; differences: price / EMA, high − low (range), volume / avg volume&lt;/li&gt;&lt;li&gt;Same idea for weekday (7), month (12), day-of-year (365)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
