        <mxCell id="ensemble-34" value="&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Base learner is unstable (high variance, low bias)&lt;/li&gt;&lt;li&gt;i.i.d. observations&lt;/li&gt;&lt;li&gt;Bootstrap samples represent the population&lt;/li&gt;&lt;li&gt;Base models&amp;#x27; errors not perfectly correlated&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
