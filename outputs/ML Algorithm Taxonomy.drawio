          <mxGeometry x="1540.0" y="920.0" width="860.0" height="680.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-254" value="④ ADF vs KPSS  ·  Making a Series Stationary" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1554.0" y="930.0" width="832.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-255" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;ADF (H₀: unit root)&lt;/th&gt;&lt;th&gt;KPSS (H₀: stationary)&lt;/th&gt;&lt;th&gt;Conclusion&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;reject&lt;/td&gt;&lt;td&gt;do not reject&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;Stationary&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;do not reject&lt;/td&gt;&lt;td&gt;reject&lt;/td&gt;&lt;td&gt;Unit root → difference it&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;reject&lt;/td&gt;&lt;td&gt;reject&lt;/td&gt;&lt;td&gt;Difference-stationary / check breaks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;do not reject&lt;/td&gt;&lt;td&gt;do not reject&lt;/td&gt;&lt;td&gt;Inconclusive (too little data)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="970.0" width="520.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-256" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;KPSS&lt;/b&gt;: \(y_t = \xi t + r_t + \varepsilon_t\), LM test that the random-walk variance is 0&lt;/li&gt;&lt;li&gt;&lt;b&gt;Phillips-Perron&lt;/b&gt;: like ADF but corrects autocorrelation non-parametrically&lt;/li&gt;&lt;li&gt;&lt;b&gt;Zivot-Andrews&lt;/b&gt;: unit-root test allowing one unknown structural break&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2100.0" y="970.0" width="280.0" height="140.0" as="geometry" />
        </mxCell>
