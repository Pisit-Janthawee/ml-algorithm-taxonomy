        <mxCell id="distributions-423" value="$$\text{Kurtosis: } g_2 = \frac{\frac{1}{n}\sum_{i=1}^{n}(x_i-\bar{x})^4}{s^4}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2000.0" y="1050.0" width="380.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-424" value="$$\text{Excess kurtosis} = g_2 - 3$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2000.0" y="1110.0" width="380.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-425" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Excess&lt;/th&gt;&lt;th&gt;Tails&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Leptokurtic&lt;/td&gt;&lt;td&gt;&amp;gt; 0&lt;/td&gt;&lt;td&gt;heavy&lt;/td&gt;&lt;td&gt;Laplace, Student t, stock returns&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mesokurtic&lt;/td&gt;&lt;td&gt;= 0&lt;/td&gt;&lt;td&gt;normal&lt;/td&gt;&lt;td&gt;Normal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Platykurtic&lt;/td&gt;&lt;td&gt;&amp;lt; 0&lt;/td&gt;&lt;td&gt;light&lt;/td&gt;&lt;td&gt;Uniform (−1.2)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2010.0" y="1160.0" width="370.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-426" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Do extreme values happen more often than a normal curve predicts?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes if leptokurtic (excess &gt; 0, heavy tails), e.g. stock returns → expect more outliers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
