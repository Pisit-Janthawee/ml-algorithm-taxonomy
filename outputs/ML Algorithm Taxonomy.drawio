        <mxCell id="hypotests-210" value="same subject measured twice (S1 … S6)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2100.0" y="620.0" width="270.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-211" value="&lt;b&gt;Linkage types:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Independent&lt;/b&gt;: different people / assets / days in each group (A/B test, two strategies on different stocks)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Paired&lt;/b&gt;: same unit measured twice or matched pairs (before/after, two models on the &lt;i&gt;same&lt;/i&gt; CV folds)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Repeated measures&lt;/b&gt;: same unit measured 3+ times (model A, B, C on the same folds)&lt;/li&gt;&lt;li&gt;Paired designs remove between-subject noise → more power; treating paired data as independent is a common error&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="650.0" width="600.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-212" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="980.0" width="640.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-213" value="③ ★ Z-Test (one-sample &amp;amp; two-proportion)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="990.0" width="612.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-214" value="σ known or large n → statistic ~ N(0, 1)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1016.0" width="612.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-215" value="$$z = \frac{\bar{x}-\mu_0}{\sigma/\sqrt{n}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1040.0" width="200.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-216" value="&lt;b&gt;Example:&lt;/b&gt; IQ claim μ₀ = 100, σ = 15, n = 36, x̄ = 105&lt;br&gt;SE = 15/√36 = 2.5 → z = (105 − 100)/2.5 = &lt;b&gt;2.00&lt;/b&gt;&lt;br&gt;two-tailed p = 2(1 − Φ(2.00)) = &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;0.0455&lt;/b&gt; &amp;lt; 0.05 → reject H₀&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="630.0" y="1038.0" width="400.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-217" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
