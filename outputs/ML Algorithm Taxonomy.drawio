        </mxCell>
        <mxCell id="labelling-228" value="&lt;b&gt;2. Path is ignored&lt;/b&gt;&lt;br&gt;the price may hit your stop-loss before ending above +τ, but the label still says +1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
