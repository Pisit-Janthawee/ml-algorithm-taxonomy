        <mxCell id="deeplearning-251" value="0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
