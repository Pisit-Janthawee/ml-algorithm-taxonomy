        <mxCell id="datanature-716" value="&lt;b&gt;Watch out:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Imbalance: accuracy is misleading (95 % by always predicting 0) → precision / recall / F1, class weights, resampling&lt;/li&gt;&lt;li&gt;Outliers: detect with Z-score / IQR (Anomaly page); error → fix / drop, real extreme → keep and use robust models&lt;/li&gt;&lt;li&gt;Data leakage: never build features from future information or from the target itself&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1370.0" y="2060.0" width="1010.0" height="85.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
