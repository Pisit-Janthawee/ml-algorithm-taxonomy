        <mxCell id="deeplearning-742" value="i: input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009900;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="4960.0" width="80.0" height="36.0" as="geometry" />
