        <mxCell id="deeplearning-286" value="2. Standardized mini-batch  \(X_b\)  (4 × 4)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
