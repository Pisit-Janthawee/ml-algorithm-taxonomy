        </mxCell>
        <mxCell id="anomaly-1073" value="$$\text{reach-dist}_k(a,b)=\max\{k\text{-dist}(b),\ d(a,b)\}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="3900.0" width="500.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1074" value="$$lrd_k(a)=\left(\frac{1}{k}\sum_{b\in N_k(a)}\text{reach-dist}_k(a,b)\right)^{-1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="3940.0" width="500.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1075" value="$$LOF_k(a)=\frac{1}{k}\sum_{b\in N_k(a)}\frac{lrd_k(b)}{lrd_k(a)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="3998.0" width="500.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1076" value="≈ 1: as dense as neighbours · &amp;gt; 1.5: much sparser → outlier" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
