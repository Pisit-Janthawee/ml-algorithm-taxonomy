        </mxCell>
        <mxCell id="tstests-565" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2085.0" y="1498.0" as="sourcePoint" />
            <mxPoint x="2085.0" y="1480.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-566" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;When do I enter and exit a pairs trade?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ spread above +2σ → short y / long x; below −2σ → reverse; exit at the mean (the spread reverts)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010.0" y="2170.0" width="460.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-567" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1010.0" y="2170.0" as="sourcePoint" />
            <mxPoint x="877.0" y="2030.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-568" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How fast does the pair return to equilibrium?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ γ = −0.25 → 25 % of the gap closes each period; half-life ≈ 2.4 periods = holding time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
