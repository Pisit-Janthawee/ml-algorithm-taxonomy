        <mxCell id="tstests-309" value="&lt;b&gt;Fractional differencing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3333FF&quot;&gt;— memory kept&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;— stationarity&lt;/font&gt;&lt;br&gt;pick the smallest d that passes ADF (often 0.3–0.5)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
