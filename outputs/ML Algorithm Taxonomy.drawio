        <mxCell id="tstests-473" value="long-run equilibrium y = βx" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="2009.0" width="180.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-474" value="$$\text{half-life} = \frac{\ln 0.5}{\ln(1+\gamma)} = \frac{\ln 0.5}{\ln 0.75} = 2.41$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2100.0" y="1870.0" width="280.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-475" value="γ = −0.25 → 25 % of the gap closes each period" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2100.0" y="1930.0" width="280.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-476" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;γ&lt;/th&gt;&lt;th&gt;meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;−1 &lt; γ &lt; 0&lt;/td&gt;&lt;td&gt;converges (cointegrated)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;γ = 0&lt;/td&gt;&lt;td&gt;no correction (not cointegrated)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;γ &gt; 0&lt;/td&gt;&lt;td&gt;diverges (unstable)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2100.0" y="1975.0" width="280.0" height="90.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-477" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Granger representation theorem&lt;/b&gt;: if x and y are cointegrated, an ECM exists (and vice versa)&lt;/li&gt;&lt;li&gt;Estimate in 2 steps: (1) long-run β from the cointegrating regression, (2) OLS of Δy on û&lt;sub&gt;t−1&lt;/sub&gt;, Δx&lt;sub&gt;t&lt;/sub&gt; and lags&lt;/li&gt;&lt;li&gt;All terms are stationary (differences + stationary spread) → standard t / F inference is valid&lt;/li&gt;&lt;li&gt;Multivariate version: &lt;b&gt;VECM&lt;/b&gt; (Vector ECM) after a Johansen test&lt;/li&gt;&lt;li&gt;Trading: |γ| tells how fast a spread reverts; half-life sets the holding period / look-back window&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="2090.0" width="820.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-478" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="2400.0" width="2000.0" height="470.0" as="geometry" />
        </mxCell>
