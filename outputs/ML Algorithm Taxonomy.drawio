        </mxCell>
        <mxCell id="ensemble-289" value="Bagging = average of deep trees" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="335.0" width="120.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-290" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1880.0" y="344.0" as="sourcePoint" />
            <mxPoint x="1920.0" y="365.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-291" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#009900;strokeWidth=2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1900.0" y="540.0" as="sourcePoint" />
            <mxPoint x="1900.0" y="440.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-292" value="$$Var\left(\frac{1}{B}\sum_{b=1}^{B} f_b\right) = \rho\,\sigma^2 + \frac{1-\rho}{B}\,\sigma^2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="660.0" width="580.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-293" value="ρ = correlation between trees" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1860.0" y="720.0" width="170.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-294" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2030.0" y="729.0" as="sourcePoint" />
            <mxPoint x="2140.0" y="696.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-295" value="shrinks as B grows" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2180.0" y="720.0" width="120.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-296" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2285.0" y="729.0" as="sourcePoint" />
            <mxPoint x="2285.0" y="700.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-297" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Expected error = \(Bias^2 + Variance + Noise\)&lt;/li&gt;&lt;li&gt;Deep trees: low bias, high variance → averaging B of them keeps the bias and cuts the variance&lt;/li&gt;&lt;li&gt;Correlated trees limit the gain (ρσ² stays) → Random Forest de-correlates them with random features&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="750.0" width="620.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-298" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why does averaging many deep trees help?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ each deep tree is unbiased but noisy (scattered dots); averaging B of them keeps the low bias and pulls the prediction to the centre&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
