        <mxCell id="datanature-182" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Discrete&lt;/b&gt; = you &lt;i&gt;count&lt;/i&gt; it (0, 1, 2…);  &lt;b&gt;Continuous&lt;/b&gt; = you &lt;i&gt;measure&lt;/i&gt; it (any value in a range)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Binary&lt;/b&gt; is a special nominal variable with 2 levels — usually stored as 0 / 1&lt;/li&gt;&lt;li&gt;Ordinal codes (1–5 stars) &lt;i&gt;look&lt;/i&gt; numeric, but the gap 1→2 need not equal 4→5: avoid the mean, use the median&lt;/li&gt;&lt;li&gt;Numbers are not always quantitative: zip code, ticker ID, account number are &lt;b&gt;nominal&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="720.0" width="1020.0" height="105.0" as="geometry" />
        </mxCell>
