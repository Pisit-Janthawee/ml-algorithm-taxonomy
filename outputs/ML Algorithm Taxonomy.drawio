        <mxCell id="versatile-2835" value="&lt;b&gt;Proximity&lt;/b&gt; = share of trees where two rows land in the same leaf&lt;br&gt;Row 5 has x₂ = &lt;b&gt;NaN&lt;/b&gt; (start: column mean 4.68)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1170.0" y="1820.0" width="210.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2836" value="$$\hat{x}_{5} = \frac{\sum_j prox_{5j}\,x_j}{\sum_j prox_{5j}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1170.0" y="1890.0" width="210.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2837" value="iterations: 4.68 → 2.86 → 2.83 → &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;2.94&lt;/b&gt;&lt;/span&gt;&lt;br&gt;row 5 shares leaves mostly with r1, r2 (same class y = 0, x₂ ≈ 2.1–2.4)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1170.0" y="1938.0" width="210.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2838" value="trees are trained on the target y, so &amp;#x27;similar&amp;#x27; means similar for the prediction" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
