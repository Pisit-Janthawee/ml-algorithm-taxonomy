        <mxCell id="tree-360" value="Rain&lt;br&gt;[3+,2−]&lt;br&gt;H=0.97" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2316.0" y="3112.0" width="62.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-361" value="one child pure, others less mixed → useful split" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="2000.0" y="3154.0" width="380.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-362" value="&lt;b&gt;Interpretation:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Entropy is measured in &lt;b&gt;bits&lt;/b&gt;: H = 1 means you need one yes/no question to know the class&lt;/li&gt;&lt;li&gt;IG = 0 → the feature tells nothing about the target;  IG = H(parent) → the split makes every child pure&lt;/li&gt;&lt;li&gt;Log base 2 for bits; natural log (nats) only rescales — the chosen split stays the same&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="3150.0" width="940.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-363" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is this node pure enough to stop splitting?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ read its entropy: 0 = pure → make a leaf; ≈ 1 (2 classes) = coin flip → keep splitting; the maximum grows to log₂K for K classes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="3255.0" width="940.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-364" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1720.0" y="3255.0" as="sourcePoint" />
            <mxPoint x="1720.0" y="3091.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
