        </mxCell>
        <mxCell id="timeseries-365" value="Sample values: ρ₁ = 0.77, ρ₂ = 0.61, PACF₂ = 0.03" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="595.0" width="600.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-366" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;ACF&lt;/th&gt;&lt;th&gt;PACF&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;AR(p)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tails off gradually&lt;/td&gt;&lt;td&gt;&lt;b&gt;cuts off after lag p&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;MA(q)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;cuts off after lag q&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tails off gradually&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ARMA(p, q)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tails off&lt;/td&gt;&lt;td&gt;tails off&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="630.0" width="540.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-367" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How many AR lags (p) should the model use?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ p = 1: only the lag-1 PACF bar (0.77) is outside the red band → AR(1)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2222.0" y="615.0" width="170.0" height="96.0" as="geometry" />
