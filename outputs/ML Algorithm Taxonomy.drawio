        <mxCell id="deeplearning-739" value="$$c_{t-1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="4818.0" width="50.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-740" value="$$c_t$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1385.0" y="4808.0" width="40.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-741" value="f: forget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF0000;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="970.0" y="4960.0" width="80.0" height="36.0" as="geometry" />
