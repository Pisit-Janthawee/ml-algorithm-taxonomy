        <mxCell id="dimred-398" value="&lt;font color='#3333FF'&gt;■ explained variance ratio \(\lambda_j / \sum\lambda\)&lt;/font&gt;&lt;br&gt;&lt;font color='#FF0000'&gt;● cumulative&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
