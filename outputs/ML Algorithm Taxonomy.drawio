          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-270" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How much information does PC1 keep?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ PC1 carries 93% of the variance: the cloud is almost a line&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1815.0" y="328.0" width="190.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-271" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2005.0" y="396.0" as="sourcePoint" />
            <mxPoint x="2100.1" y="439.9" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-272" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;PC1&lt;/b&gt; = direction of the largest variance (longest spread of the cloud)&lt;/li&gt;&lt;li&gt;&lt;b&gt;PC2&lt;/b&gt; ⟂ PC1, captures what is left;  arrow length ∝ \(\sqrt{\lambda}\)&lt;/li&gt;&lt;li&gt;Projection = keep the shadow of every point on PC1 → 2D becomes 1D&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1740.0" y="750.0" width="640.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-273" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="900.0" width="620.0" height="600.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-274" value="④ Project: Z = X · Wₖ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="910.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-275" value="Reduce dimensions by keeping the top k components" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="936.0" width="592.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-276" value="$$Z_{(n\times k)} = X_{(n\times p)}\; W_{(p\times k)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="970.0" width="580.0" height="44.0" as="geometry" />
        </mxCell>
