        </mxCell>
        <mxCell id="tree-111" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Entropy = average number of bits needed to encode the class → 0 when certain, 1 when 50/50 (2 classes)&lt;/li&gt;&lt;li&gt;Max entropy for K classes = \(\log_2 K\)&lt;/li&gt;&lt;li&gt;CART uses &lt;b&gt;Gini&lt;/b&gt; instead (no logarithm, faster, very similar shape)&lt;/li&gt;&lt;li&gt;Regression trees use &lt;b&gt;variance&lt;/b&gt; of the target instead of entropy&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="720.0" width="580.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-112" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How uncertain is 'Play?' before looking at any feature?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ H = 0.940 bits: close to the 1-bit maximum (50/50), so the label is still very uncertain&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
