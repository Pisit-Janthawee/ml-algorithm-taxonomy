        <mxCell id="clustering-287" value="$$d = 5$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
