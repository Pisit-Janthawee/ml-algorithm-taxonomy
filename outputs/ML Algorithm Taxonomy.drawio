        <mxCell id="fitting-402" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2162.0" y="2214.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-403" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#808080;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2162.0" y="2240.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-404" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2162.0" y="2266.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-405" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#808080;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2242.0" y="2162.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-406" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2242.0" y="2188.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-407" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#808080;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2242.0" y="2214.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-408" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2242.0" y="2240.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-409" value="✕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#808080;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2242.0" y="2266.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-410" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2322.0" y="2214.0" width="16.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-411" value="random neurons switched off each step → no single path can memorise" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="2292.0" width="300.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-412" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;More rows&lt;/b&gt; lowers variance (overfit gap shrinks, see ④); &lt;b&gt;augmentation&lt;/b&gt; (noise, bootstraps, synthetic samples) helps when real rows are scarce&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="2345.0" width="940.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-413" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="2420.0" width="2000.0" height="470.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-414" value="⑥ Remedy decision table: problem → fix → what to check in the data table" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="2430.0" width="1972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-415" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Problem&lt;/th&gt;&lt;th&gt;Fix&lt;/th&gt;&lt;th&gt;Tabular check (look at the data table)&lt;/th&gt;&lt;th&gt;Typical knob&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;Underfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Add richer / missing features&lt;/td&gt;&lt;td&gt;Is the real driver a column at all? correlation / MI of each column with y&lt;/td&gt;&lt;td&gt;new data source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;Underfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Better representation&lt;/td&gt;&lt;td&gt;Timestamps → hour / weekday; nominal → one-hot; skewed → log&lt;/td&gt;&lt;td&gt;encoders, transforms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;Underfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;More complex model / interactions&lt;/td&gt;&lt;td&gt;Do residuals still show a pattern vs any column?&lt;/td&gt;&lt;td&gt;degree, max_depth ↑, hidden units ↑&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;Underfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Less regularization, train longer&lt;/td&gt;&lt;td&gt;Train error still high and flat&lt;/td&gt;&lt;td&gt;λ ↓, epochs ↑, C ↑&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;More rows / augmentation&lt;/td&gt;&lt;td&gt;rows ÷ columns ratio (aim ≫ 10); learning curve still dropping?&lt;/td&gt;&lt;td&gt;collect data, bootstrap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Drop ID / leaky / duplicate columns &amp; rows&lt;/td&gt;&lt;td&gt;Unique-value count per column = rows? features computed after time t? duplicate rows across split?&lt;/td&gt;&lt;td&gt;drop, shift(1), dedupe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Fewer / cleaner features&lt;/td&gt;&lt;td&gt;Many weak, correlated columns; rare levels with 1–2 rows&lt;/td&gt;&lt;td&gt;feature selection, group rare levels&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Regularization&lt;/td&gt;&lt;td&gt;Large coefficients with alternating signs&lt;/td&gt;&lt;td&gt;λ (L1/L2), weight decay&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Prune / limit trees&lt;/td&gt;&lt;td&gt;Leaves with 1–2 rows&lt;/td&gt;&lt;td&gt;max_depth, min_samples_leaf, ccp_alpha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Early stopping, dropout&lt;/td&gt;&lt;td&gt;Validation loss rising while train loss falls&lt;/td&gt;&lt;td&gt;patience, dropout p&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Overfit&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Honest validation &amp; ensembling&lt;/td&gt;&lt;td&gt;Is the split by time / group? Is the test set untouched?&lt;/td&gt;&lt;td&gt;CV, purged CV, bagging&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2470.0" width="1960.0" height="258.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-416" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;Rule of thumb:&lt;/b&gt;&lt;/span&gt; first make the model able to fit the training rows (fix underfitting), then make it generalise (fix overfitting) — and always judge on rows it has never seen." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2740.0" width="1960.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-417" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Overfitting is mostly a &lt;b&gt;data-table&lt;/b&gt; problem (too few rows, too many / leaky columns, noisy labels) before it is a model problem&lt;/li&gt;&lt;li&gt;Underfitting is mostly a &lt;b&gt;feature&lt;/b&gt; problem: the information is not in the columns, or not in a form the model can use&lt;/li&gt;&lt;li&gt;Related pages: Model Evaluation (validation, learning curves), Feature Engineering (representation), Explainability (suspicious top feature = leakage)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2772.0" width="1960.0" height="66.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-418" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is the model memorising rows instead of learning the pattern?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ overfit: train MSE 0.00 but test 2.63; the cubic (0.05 / 0.51) has the smallest gap, so it generalises&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="700.0" width="540.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-419" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2149.0" y="700.0" as="sourcePoint" />
            <mxPoint x="2149.0" y="627.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fitting-420" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why is the test score suspiciously good?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the test row (62, 0.9) duplicates a training row, so it was already seen; dedupe before splitting&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1562.0" width="1000.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-421" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1012.0" y="1562.0" as="sourcePoint" />
            <mxPoint x="1012.0" y="1473.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fitting-422" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why can't a linear model learn this table?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the signal lives in the product x₁·x₂ (each alone = 50 %); adding that column makes it linear&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1660.0" y="1560.0" width="720.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-423" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1856.0" y="1560.0" as="sourcePoint" />
            <mxPoint x="1856.0" y="1381.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fitting-424" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Will collecting more rows fix the overfitting?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ partly: the depth-12 gap shrinks as n grows (variance); depth-1 curves stay high, so data won't fix underfit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1175.0" y="2190.0" width="195.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-425" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1184.0" y="2190.0" as="sourcePoint" />
            <mxPoint x="1184.0" y="2081.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fitting-426" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which features does L1 switch off?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the solution lands on a corner (β₁ = 0), so L1 drops weak features; L2 only shrinks them&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2025.0" y="2047.0" width="360.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-427" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2218.0" y="2047.0" as="sourcePoint" />
            <mxPoint x="2218.0" y="1853.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fitting-428" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What should I check in my table when validation looks too good?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ unique values per column (IDs), features computed after time t, and duplicate rows across splits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="2490.0" width="440.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-429" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880.0" y="2558.0" as="sourcePoint" />
            <mxPoint x="933.0" y="2605.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="25. KNN Pixel Inpainting" id="versatile">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="versatile-1" value="KNN Pixel Inpainting" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=32;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="0.0" width="1400.0" height="51.2" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2" value="ML Workflow  ›  Versatile Uses (Hidden Tricks)  ›  ★ Base algorithm" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="52.0" width="1400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-3" value="Familiar algorithms used for unexpected jobs: imputation, image editing, compression, features, signals." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="74.0" width="1400.0" height="20.0" as="geometry" />
        </mxCell>
        <UserObject label="◀ Back to Overview" link="data:page/id,overview" id="versatile-4">
          <mxCell style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
            <mxGeometry x="2200.0" y="8.0" width="200.0" height="24.0" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Distributions &amp;amp; Statistics ▶" link="data:page/id,distributions" id="versatile-5">
          <mxCell style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
            <mxGeometry x="2140.0" y="34.0" width="260.0" height="22.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="versatile-6" value="Algorithm Family" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="120.0" width="340.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0.0" y="146.0" as="sourcePoint" />
            <mxPoint x="330.0" y="146.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="versatile-8" value="Nearest-Neighbour Tricks" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="0.0" y="156.0" width="340.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-9" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;★ KNN Pixel Inpainting&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:9px&quot;&gt;Fill missing pixels from the closest colours&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="12.0" y="178.0" width="320.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4.0" y="187.0" as="sourcePoint" />
            <mxPoint x="9.0" y="187.0" as="targetPoint" />
          </mxGeometry>
