        <mxCell id="versatile-2243" value="pixels in colour space (R vs B); squares = k = 4 centroids" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
