        </mxCell>
        <mxCell id="anomaly-151" value="… measured in standard deviations" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1630.0" y="615.0" width="210.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-152" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1630.0" y="624.0" as="sourcePoint" />
            <mxPoint x="1602.0" y="585.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-153" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;z = 0 → exactly at the mean;  z = +2 → 2σ above the mean&lt;/li&gt;&lt;li&gt;Variance = \(\sigma^2\);  σ is in the same unit as x&lt;/li&gt;&lt;li&gt;Rule: flag \(|z_i| &gt; 3\) (or 2.5 / 2 for stricter screening)&lt;/li&gt;&lt;li&gt;Assumes the data is roughly &lt;b&gt;normal&lt;/b&gt; — check the histogram first&lt;/li&gt;&lt;li&gt;Same formula is used for &lt;b&gt;feature scaling&lt;/b&gt; (standardization)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="660.0" width="480.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-154" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can I trust the |z| &gt; 3 rule on any data?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only if the data is roughly normal&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1610.0" y="772.0" width="240.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-155" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1690.0" y="772.0" as="sourcePoint" />
            <mxPoint x="1690.0" y="743.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-156" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="240.0" width="500.0" height="620.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-157" value="③ Worked Example (n = 12)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1914.0" y="250.0" width="472.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-158" value="Daily trade volume (thousand)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1914.0" y="276.0" width="472.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-159" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;i&lt;/th&gt;&lt;th&gt;\(x_i\)&lt;/th&gt;&lt;th&gt;\(x_i-\mu\)&lt;/th&gt;&lt;th&gt;\(z_i\)&lt;/th&gt;&lt;th&gt;flag&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;-3&lt;/td&gt;&lt;td&gt;-0.31&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;-1&lt;/td&gt;&lt;td&gt;-0.10&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;48&lt;/td&gt;&lt;td&gt;-5&lt;/td&gt;&lt;td&gt;-0.51&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;51&lt;/td&gt;&lt;td&gt;-2&lt;/td&gt;&lt;td&gt;-0.20&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;49&lt;/td&gt;&lt;td&gt;-4&lt;/td&gt;&lt;td&gt;-0.41&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;-3&lt;/td&gt;&lt;td&gt;-0.31&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;td&gt;+0&lt;/td&gt;&lt;td&gt;+0.00&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;47&lt;/td&gt;&lt;td&gt;-6&lt;/td&gt;&lt;td&gt;-0.61&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;-3&lt;/td&gt;&lt;td&gt;-0.31&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;-1&lt;/td&gt;&lt;td&gt;-0.10&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;49&lt;/td&gt;&lt;td&gt;-4&lt;/td&gt;&lt;td&gt;-0.41&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;85&lt;/td&gt;&lt;td&gt;+32&lt;/td&gt;&lt;td&gt;+3.27&lt;/td&gt;&lt;td&gt;&lt;b&gt;outlier&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1930.0" y="305.0" width="440.0" height="277.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-160" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which day is abnormal?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ day 12 (85): z = 3.27 &gt; 3 → outlier; all other days have |z| &lt; 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2240.0" y="330.0" width="150.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-161" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2240.0" y="412.0" as="sourcePoint" />
            <mxPoint x="2232.0" y="575.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-162" value="$$\mu = \frac{636}{12} = 53$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="605.0" width="220.0" height="48.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-163" value="$$\sigma = \sqrt{\frac{1150}{12}} = 9.79$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="605.0" width="240.0" height="48.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-164" value="&lt;span style='background:#FFFF00'&gt;\(z_{12} = \frac{85 - 53}{9.79} = 3.27 &gt; 3\) → outlier&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="665.0" width="460.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-165" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Note: the outlier itself inflates σ (without it σ ≈ 1.7) → &lt;b&gt;masking&lt;/b&gt;&lt;/li&gt;&lt;li&gt;With small n, |z| can never be very large: \(|z| \le \sqrt{n-1}\)&lt;/li&gt;&lt;li&gt;→ robust alternatives ⑤ ⑥ use the median instead of the mean&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="720.0" width="460.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-166" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="900.0" width="620.0" height="600.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-167" value="④ The data on a z-scale" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
