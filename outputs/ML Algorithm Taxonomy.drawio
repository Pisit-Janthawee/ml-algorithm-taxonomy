        </mxCell>
        <mxCell id="association-154" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="972.0" y="1100.0" as="sourcePoint" />
            <mxPoint x="972.0" y="1073.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="association-155" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;L1 = {items with support ≥ min_sup}&lt;br&gt;k = 2&lt;br&gt;while L(k−1) not empty:&lt;br&gt;&amp;nbsp;&amp;nbsp;Ck = join(L(k−1), L(k−1))&amp;nbsp;&amp;nbsp;# candidates of size k&lt;br&gt;&amp;nbsp;&amp;nbsp;Ck = prune(Ck)&amp;nbsp;&amp;nbsp;# drop if any (k−1)-subset not in L(k−1)&lt;br&gt;&amp;nbsp;&amp;nbsp;Lk = {c in Ck : support(c) ≥ min_sup}&amp;nbsp;&amp;nbsp;# one scan of the data&lt;br&gt;&amp;nbsp;&amp;nbsp;k += 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1260.0" width="680.0" height="160.0" as="geometry" />
        </mxCell>
        <mxCell id="association-156" value="&lt;b&gt;Cost:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;One full database scan per level → slow on big data (FP-Growth needs only 2 scans)&lt;/li&gt;&lt;li&gt;Low min support → many candidates;  high min support → miss rare but useful rules&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1435.0" width="680.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="association-157" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1160.0" y="940.0" width="620.0" height="600.0" as="geometry" />
        </mxCell>
