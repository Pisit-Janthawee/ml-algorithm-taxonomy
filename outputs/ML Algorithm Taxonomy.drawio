        <mxCell id="evaluation-326" value="Type II error" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
