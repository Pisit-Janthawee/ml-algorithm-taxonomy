          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-326" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Where should the cluster centre move?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ to the mean of its points, (2, 2), the spot with the smallest squared distances&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="1062.0" width="250.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-327" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760.0" y="1062.0" as="sourcePoint" />
            <mxPoint x="580.0" y="1031.4" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-328" value="$$\mu_j = \frac{1}{|C_j|}\sum_{x_i \in C_j} x_i$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="1145.0" width="540.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-329" value="$$\mu = \left(\frac{1+2+3}{3},\ \frac{2+1+3}{3}\right) = (2,\,2)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="1210.0" width="540.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-330" value="$$J = \sum_{j=1}^{k}\sum_{x_i \in C_j}\lVert x_i-\mu_j\rVert^2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="1265.0" width="540.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-331" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;\(J = (1+0) + (0+1) + (1+1) = 4\)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="1335.0" width="540.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-332" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(C_j\) = set of points in cluster j,  \(|C_j|\) = how many&lt;/li&gt;&lt;li&gt;J (inertia / WCSS) = within-cluster sum of squares — K-Means minimizes it&lt;/li&gt;&lt;li&gt;The mean is exactly the point that minimizes the squared distances&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1390.0" width="580.0" height="85.0" as="geometry" />
        </mxCell>
