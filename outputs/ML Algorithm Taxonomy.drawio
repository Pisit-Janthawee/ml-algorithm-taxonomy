        <mxCell id="labelling-201" value="$$S^-_t = \min(0,\ S^-_{t-1} + \Delta y_t)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
