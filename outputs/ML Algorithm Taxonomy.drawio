        <mxCell id="problems-448" value="best F1, t = 0.31" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
