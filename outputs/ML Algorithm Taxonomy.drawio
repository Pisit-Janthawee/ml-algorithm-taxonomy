        <mxCell id="clustering-506" value="DBSCAN / Spectral: inner vs outer ✔" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
