          <mxGeometry x="935.0" y="1050.0" width="100.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-262" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#FF0000;strokeWidth=2;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900.0" y="1090.0" as="sourcePoint" />
            <mxPoint x="930.0" y="1090.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="optimization-263" value="Adam" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="935.0" y="1080.0" width="100.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-264" value="Momentum" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1240.0" width="200.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-265" value="$$v_t = \beta v_{t-1} + \alpha\nabla J,\quad \theta := \theta - v_t$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1260.0" width="600.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-266" value="RMSProp" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1300.0" width="200.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-267" value="$$s_t = \beta s_{t-1} + (1-\beta)(\nabla J)^2,\quad \theta := \theta - \frac{\alpha}{\sqrt{s_t}+\epsilon}\nabla J$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1320.0" width="600.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-268" value="Adam = Momentum + RMSProp (+ bias correction)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1370.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-269" value="$$m_t = \beta_1 m_{t-1} + (1-\beta_1)\nabla J,\quad v_t = \beta_2 v_{t-1} + (1-\beta_2)(\nabla J)^2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1390.0" width="600.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-270" value="$$\hat{m}_t = \frac{m_t}{1-\beta_1^t},\ \hat{v}_t = \frac{v_t}{1-\beta_2^t},\quad \theta := \theta - \frac{\alpha\,\hat{m}_t}{\sqrt{\hat{v}_t}+\epsilon}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1428.0" width="600.0" height="48.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-271" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Momentum averages past gradients → damps zig-zag, speeds up along the valley&lt;/li&gt;&lt;li&gt;RMSProp divides by recent gradient size → per-parameter learning rate&lt;/li&gt;&lt;li&gt;Adam defaults: \(\alpha=0.001, \beta_1=0.9, \beta_2=0.999, \epsilon=10^{-8}\)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1485.0" width="600.0" height="66.0" as="geometry" />
        </mxCell>
