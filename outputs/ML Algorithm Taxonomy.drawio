        </mxCell>
        <mxCell id="tstests-569" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2340.0" y="2200.0" as="sourcePoint" />
            <mxPoint x="2340.0" y="1898.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tstests-570" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does knowing x's past improve the forecast of y?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ if the F-test rejects H₀ (all bᵢ = 0), lagged x adds predictive information → x Granger-causes y&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1870.0" y="2782.0" width="500.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-571" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
