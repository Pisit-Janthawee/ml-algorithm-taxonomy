        <mxCell id="ensemble-228" value="Row 3 is predicted &lt;b&gt;only&lt;/b&gt; by trees 2, 3 (never trained on it) → average of all such predictions = &lt;b&gt;OOB error&lt;/b&gt; ≈ test error, no hold-out set needed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1510.0" y="600.0" width="170.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-229" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;scikit-learn: &lt;font face='Courier New'&gt;BaggingClassifier(oob_score=True)&lt;/font&gt; → &lt;font face='Courier New'&gt;.oob_score_&lt;/font&gt;&lt;/li&gt;&lt;li&gt;OOB also gives permutation feature importance in Random Forest&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="760.0" width="580.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-230" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can I estimate test error without a hold-out set?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: predict each row only with the trees that never saw it (OOB cells) and average → OOB error ≈ test error&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="835.0" width="580.0" height="54.0" as="geometry" />
