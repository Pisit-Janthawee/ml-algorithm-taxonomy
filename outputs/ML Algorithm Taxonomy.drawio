        <mxCell id="tree-349" value="&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;■ max entropy = log₂K&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#808080&quot;&gt;&lt;b&gt;■ max Gini = 1 − 1/K&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1980.0" y="2612.0" width="380.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-350" value="$$0 \le H(S) \le \log_2 K \qquad 0 \le Gini \le 1-\tfrac{1}{K} \qquad 0 \le IG \le H(parent)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1890.0" y="2890.0" width="490.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="tree-351" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Entropy (2 classes)&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;th&gt;At a node&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;pure: all samples one class&lt;/td&gt;&lt;td&gt;make a leaf&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0 – 0.3&lt;/td&gt;&lt;td&gt;almost pure&lt;/td&gt;&lt;td&gt;leaf or 1 more split&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.3 – 0.8&lt;/td&gt;&lt;td&gt;mixed&lt;/td&gt;&lt;td&gt;keep splitting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.8 – 1&lt;/td&gt;&lt;td&gt;maximally mixed (≈ coin flip)&lt;/td&gt;&lt;td&gt;feature needed&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2970.0" width="520.0" height="120.0" as="geometry" />
        </mxCell>
