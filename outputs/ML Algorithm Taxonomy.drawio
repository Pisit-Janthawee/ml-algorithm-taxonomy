        <mxCell id="recsys-307" value="Explain every rating with k hidden &amp;#x27;taste&amp;#x27; factors: R ≈ U · Vᵀ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
