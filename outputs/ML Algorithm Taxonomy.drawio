        <mxCell id="recsys-311" value="×" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="640.0" y="1905.0" width="24.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-312" value="Vᵀ  2×6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="670.0" y="1900.0" width="120.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-313" value="each user = 2 numbers (taste), each item = 2 numbers (character)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1988.0" width="380.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-314" value="$$\hat r_{ui} = \mu + b_u + b_i + \mathbf{p}_u^\top \mathbf{q}_i$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="1850.0" width="360.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-315" value="$$\min \sum_{(u,i)\,known}\left(r_{ui}-\hat r_{ui}\right)^2 + \lambda\left(\lVert\mathbf p_u\rVert^2+\lVert\mathbf q_i\rVert^2+b_u^2+b_i^2\right)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="1895.0" width="560.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-316" value="$$e_{ui}=r_{ui}-\hat r_{ui};\quad \mathbf p_u \mathrel{+}= \eta\,(e_{ui}\mathbf q_i-\lambda\mathbf p_u);\quad \mathbf q_i \mathrel{+}= \eta\,(e_{ui}\mathbf p_u-\lambda\mathbf q_i)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
