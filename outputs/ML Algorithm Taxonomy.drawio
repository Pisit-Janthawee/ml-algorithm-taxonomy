        <mxCell id="explain-711" value="this bar: RSI = 72, P(up) = 0.19 → SELL" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="2072.0" width="260.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-712" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2258.8" y="2081.0" as="sourcePoint" />
            <mxPoint x="2258.8" y="1999.9" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-713" value="LIME line (kernel σ = 12): slope +0.110 per 10 RSI points" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="1756.0" width="280.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-714" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2120.1" y="1765.0" as="sourcePoint" />
            <mxPoint x="2120.1" y="2033.6" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-715" value="σ = 4 gives +0.073: the answer depends on kernel width. LIME is local: near RSI 72 small nudges barely matter; it misses the big drop below ≈ 55 that the counterfactual finds." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="1774.0" width="300.0" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-716" value="orange = perturbed samples (bigger = closer = more weight) · blue = true model · green = counterfactual" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="2105.0" width="620.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-717" value="$$\xi(x) = \arg\min_{g \in G}\ \mathcal{L}(f, g, \pi_x) + \Omega(g)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="2136.0" width="540.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-718" value="fit a simple model g (linear) to f near x, weighted by proximity π_x, keeping g simple (Ω)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="2178.0" width="620.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-719" value="&lt;b&gt;Counterfactual:&lt;/b&gt; &quot;If RSI were &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;53&lt;/b&gt;&lt;/span&gt; instead of &lt;b&gt;72&lt;/b&gt; (everything else equal), P(up) = 0.54 → the signal flips &lt;font color=&quot;#FF0000&quot;&gt;SELL&lt;/font&gt; → &lt;font color=&quot;#009900&quot;&gt;BUY&lt;/font&gt;.&quot;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="2205.0" width="620.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-720" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Method&lt;/th&gt;&lt;th&gt;Scope&lt;/th&gt;&lt;th&gt;Agnostic?&lt;/th&gt;&lt;th&gt;Cost&lt;/th&gt;&lt;th&gt;Watch out&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Permutation&lt;/td&gt;&lt;td&gt;global&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;td&gt;correlated features&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PDP / ICE&lt;/td&gt;&lt;td&gt;global / local&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;td&gt;unrealistic rows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SHAP&lt;/td&gt;&lt;td&gt;local → global&lt;/td&gt;&lt;td&gt;yes (Tree: exact)&lt;/td&gt;&lt;td&gt;high&lt;/td&gt;&lt;td&gt;background choice&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIME&lt;/td&gt;&lt;td&gt;local&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;td&gt;unstable, kernel width&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Counterfactual&lt;/td&gt;&lt;td&gt;local&lt;/td&gt;&lt;td&gt;yes&lt;/td&gt;&lt;td&gt;medium&lt;/td&gt;&lt;td&gt;must be realistic&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="2260.0" width="620.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-721" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Should I trust the signals this model uses?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ check the top features are sensible (trend, momentum); a surprising top feature often means leakage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="862.0" y="795.0" width="150.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-722" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="862.0" y="795.0" as="sourcePoint" />
            <mxPoint x="646.0" y="762.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-723" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which feature does the model rely on most?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ EMA_gap: shuffling it drops accuracy by 0.194; Noise and Day_of_week ≈ 0 → candidates to drop&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1980.0" y="864.0" width="400.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-724" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2358.0" y="864.0" as="sourcePoint" />
            <mxPoint x="2358.0" y="470.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-725" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is a high Gini importance proof that a feature matters?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ no: Noise gets 7 % of Gini importance (trees split on randomness) but 0 % permutation on held-out data&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1565.0" width="600.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-726" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="435.0" y="1565.0" as="sourcePoint" />
            <mxPoint x="435.0" y="1434.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-727" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does the effect of the trend depend on volatility?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: at Volatility 2.0 P(up) climbs 0.14 → 0.87 across EMA_gap, at 0.5 only 0.33 → 0.81 → interaction&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1850.0" y="1495.0" width="500.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-728" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2324.0" y="1495.0" as="sourcePoint" />
            <mxPoint x="2324.0" y="1355.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-729" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why did the model say SELL for this bar?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ EMA_gap (−0.167), RSI_copy (−0.159) and RSI 72 (−0.145) push P(up) from 0.636 down to 0.193&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1537.0" y="1825.0" width="158.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-730" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1537.0" y="1880.0" as="sourcePoint" />
            <mxPoint x="1488.0" y="1838.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-731" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What is the smallest change that would flip the signal?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ RSI 72 → 53 (all else equal) lifts P(up) from 0.19 to 0.54: SELL becomes BUY&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1825.0" y="1915.0" width="250.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-732" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2075.0" y="1915.0" as="sourcePoint" />
            <mxPoint x="2099.0" y="1912.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="24. Bias–Variance Trade-off" id="fitting">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="1" shadow="0">
