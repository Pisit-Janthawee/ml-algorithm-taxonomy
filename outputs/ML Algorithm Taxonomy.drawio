        <mxCell id="kernel-1471" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;Hyperparameters&lt;/th&gt;&lt;th&gt;Grid (log scale where ×)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;kNN&lt;/td&gt;&lt;td&gt;k, metric, weights&lt;/td&gt;&lt;td&gt;k ∈ {1,3,5,…,√n}, L1/L2, uniform/distance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SVM (RBF)&lt;/td&gt;&lt;td&gt;C, γ&lt;/td&gt;&lt;td&gt;C ∈ 10⁻²…10³ ×, γ ∈ 10⁻⁴…10¹ ×&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SVM (linear)&lt;/td&gt;&lt;td&gt;C&lt;/td&gt;&lt;td&gt;C ∈ 10⁻³…10² ×&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Kernel ridge&lt;/td&gt;&lt;td&gt;α, γ&lt;/td&gt;&lt;td&gt;α ∈ 10⁻⁴…10¹ ×&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1960.0" y="2125.0" width="420.0" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-1472" value="SVM: good (C, γ) pairs lie on a diagonal ridge — large C with small γ ≈ small C with large γ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1960.0" y="2262.0" width="420.0" height="32.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-1473" value="&lt;b&gt;How to choose:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Always scale &lt;b&gt;inside&lt;/b&gt; each CV fold (Pipeline: scaler → model) so validation folds stay unseen&lt;/li&gt;&lt;li&gt;GridSearchCV for small spaces, RandomizedSearchCV / Bayesian optimization (Optuna) for large ones; use &lt;b&gt;nested CV&lt;/b&gt; to report an unbiased score&lt;/li&gt;&lt;li&gt;Pick the simplest setting within noise of the best (e.g. larger k if accuracy is equal) and refit on all training data&lt;/li&gt;&lt;li&gt;Time series: replace K-fold by walk-forward splits&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="2400.0" width="920.0" height="105.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
