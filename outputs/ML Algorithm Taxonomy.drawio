        <mxCell id="labelling-226" value="Problems" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
