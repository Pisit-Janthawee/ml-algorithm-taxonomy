        <mxCell id="hypotests-162" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Outcome ↓ / Design →&lt;/th&gt;&lt;th&gt;1 sample&lt;/th&gt;&lt;th&gt;2 indep.&lt;/th&gt;&lt;th&gt;2 paired&lt;/th&gt;&lt;th&gt;3+ indep.&lt;/th&gt;&lt;th&gt;3+ paired&lt;/th&gt;&lt;th&gt;Assoc.&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Numeric&lt;/b&gt;&lt;br&gt;(normal)&lt;/td&gt;&lt;td&gt;Z / 1-sample t&lt;/td&gt;&lt;td&gt;Indep. t&lt;br&gt;(Welch)&lt;/td&gt;&lt;td&gt;Paired t&lt;/td&gt;&lt;td&gt;One-way&lt;br&gt;ANOVA&lt;/td&gt;&lt;td&gt;RM-ANOVA&lt;/td&gt;&lt;td&gt;Pearson r&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Numeric non-normal&lt;/b&gt;&lt;br&gt;/ &lt;b&gt;Ordinal&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Wilcoxon&lt;br&gt;signed-rank&lt;/td&gt;&lt;td&gt;Mann-&lt;br&gt;Whitney U&lt;/td&gt;&lt;td&gt;Wilcoxon&lt;br&gt;signed-rank&lt;/td&gt;&lt;td&gt;Kruskal-&lt;br&gt;Wallis&lt;/td&gt;&lt;td&gt;Friedman&lt;/td&gt;&lt;td&gt;Spearman ρ&lt;br&gt;Kendall τ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Binary /&lt;/b&gt;&lt;br&gt;&lt;b&gt;Categorical&lt;/b&gt;&lt;/td&gt;&lt;td&gt;χ² GOF /&lt;br&gt;binomial&lt;/td&gt;&lt;td&gt;χ² / Fisher&lt;br&gt;/ 2-prop Z&lt;/td&gt;&lt;td&gt;McNemar&lt;/td&gt;&lt;td&gt;χ² (r×c)&lt;/td&gt;&lt;td&gt;Cochran's Q&lt;/td&gt;&lt;td&gt;Cramér's V&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
