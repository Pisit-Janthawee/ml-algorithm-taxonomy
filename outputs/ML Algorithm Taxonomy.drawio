        <mxCell id="deeplearning-88" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What does one neuron compute?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ a weighted sum of the inputs + bias, squashed by g&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="840.0" y="282.0" width="190.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-89" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840.0" y="350.0" as="sourcePoint" />
            <mxPoint x="754.0" y="434.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-90" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why add a non-linear activation g(z)?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ stacked linear layers collapse into one line; ReLU / sigmoid let the network bend&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="545.0" width="240.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-91" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1030.0" y="613.0" as="sourcePoint" />
            <mxPoint x="1305.0" y="653.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-92" value="$$z = \sum_{i=1}^{n} w_i x_i + b = \mathbf{w}^T\mathbf{x} + b$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="480.0" y="710.0" width="480.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-93" value="$$\hat{y} = g(z)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="480.0" y="750.0" width="480.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-94" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Rosenblatt's perceptron (1958) uses a step function: output 1 if z &gt; 0 else 0&lt;/li&gt;&lt;li&gt;With sigmoid g, one neuron = &lt;b&gt;Logistic Regression&lt;/b&gt;; stacking neurons in layers = &lt;b&gt;MLP&lt;/b&gt;&lt;/li&gt;&lt;li&gt;One neuron draws only a straight boundary — it cannot solve XOR → need hidden layers&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="790.0" width="600.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-95" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="240.0" width="620.0" height="640.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-96" value="② Activation Functions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
