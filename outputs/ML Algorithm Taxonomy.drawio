        <mxCell id="problems-542" value="&lt;font color=&quot;#3333FF&quot;&gt;● y ~ x₁ + x₂ + x₃&lt;/font&gt;: sd(β₁) = &lt;b&gt;1.80&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;● y ~ x₁ + x₃&lt;/font&gt; (x₂ dropped): sd(β₁) = &lt;b&gt;0.16&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
