        <mxCell id="fitting-177" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;date&lt;/th&gt;&lt;th&gt;RSI&lt;/th&gt;&lt;th&gt;next ret&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mon&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;+2.1%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tue&lt;/td&gt;&lt;td&gt;51&lt;/td&gt;&lt;td&gt;-1.8%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Wed&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;td&gt;+1.9%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Thu&lt;/td&gt;&lt;td&gt;50&lt;/td&gt;&lt;td&gt;-2.2%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fri&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;td&gt;+2.0%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;news?&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;—&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;missing&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1660.0" y="1054.0" width="350.0" height="144.0" as="geometry" />
        </mxCell>
        <mxCell id="fitting-178" value="&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;✘ &lt;/b&gt;returns are driven by news; RSI barely moves → any model predicts ~average&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
