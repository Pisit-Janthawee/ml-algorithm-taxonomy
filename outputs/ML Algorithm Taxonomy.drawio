        <mxCell id="tstests-251" value="(my own OLS on n = 300, constant + 1 lag)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
