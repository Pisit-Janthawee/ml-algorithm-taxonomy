        <mxCell id="rl-237" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;γ = 0.9: the big future reward still counts (6.56 of 10) → patient strategy&lt;/li&gt;&lt;li&gt;γ = 0.5: future reward almost ignored (0.63) → short-term strategy&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
