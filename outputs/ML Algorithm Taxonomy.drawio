        </mxCell>
        <mxCell id="clustering-395" value="&lt;font color='#3333FF'&gt;\(a(i)\) = mean distance to own cluster&lt;/font&gt;&lt;br&gt;&lt;font color='#FF0000'&gt;\(b(i)\) = mean distance to nearest other cluster&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1070.0" width="280.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-396" value="$$s(i) = \frac{b(i) - a(i)}{\max\{a(i),\, b(i)\}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1470.0" y="1120.0" width="280.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-397" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;s(i)&lt;/th&gt;&lt;th&gt;meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;≈ +1&lt;/td&gt;&lt;td&gt;well inside its cluster (good)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;≈ 0&lt;/td&gt;&lt;td&gt;on the border between two clusters&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt; 0&lt;/td&gt;&lt;td&gt;probably in the wrong cluster&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1090.0" y="1250.0" width="640.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-398" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Average silhouette over all points → choose the k with the highest score&lt;/li&gt;&lt;li&gt;Elbow is visual / subjective; silhouette gives a number; both should agree&lt;/li&gt;&lt;li&gt;Business sense matters too (e.g. 3 customer segments are easier to act on)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="1360.0" width="660.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-399" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="860.0" width="600.0" height="640.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-400" value="⑤ Algorithm &amp;amp; Pitfalls" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1814.0" y="870.0" width="572.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-401" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;scale X&lt;br&gt;μ = k-means++ init (k points)&lt;br&gt;repeat:&lt;br&gt;&amp;nbsp;&amp;nbsp;c_i = argmin_j ‖x_i − μ_j‖²&amp;nbsp;&amp;nbsp;# assign&lt;br&gt;&amp;nbsp;&amp;nbsp;μ_j = mean(x_i where c_i = j)&amp;nbsp;# update&lt;br&gt;until c does not change&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="910.0" width="560.0" height="150.0" as="geometry" />
        </mxCell>
