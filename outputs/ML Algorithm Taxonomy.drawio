        <mxCell id="rl-297" value="&lt;font color=&quot;#009900&quot;&gt;●&lt;/font&gt; Buy (greedy policy) &amp;nbsp; &lt;font color=&quot;#FF0000&quot;&gt;●&lt;/font&gt; Sell &amp;nbsp; &lt;font color=&quot;#808080&quot;&gt;- - MA(5)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
