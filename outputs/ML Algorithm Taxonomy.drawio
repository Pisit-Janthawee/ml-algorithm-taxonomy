        <mxCell id="timeseries-590" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF0000;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="2075.0" width="10.0" height="10.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-591" value="now (t)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1180.0" y="2088.0" width="60.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-592" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which rows may the model use to predict the target?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only rows up to now (t), inside the lookback period; the target is h steps ahead — never shuffle rows&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2150.0" width="320.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-593" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1270.0" y="2150.0" as="sourcePoint" />
            <mxPoint x="1270.0" y="2048.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="timeseries-594" value="&lt;b&gt;Definitions:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Time step t&lt;/b&gt; = one observation (one row / one candle). Rows are &lt;b&gt;ordered&lt;/b&gt; — shuffling them destroys the information&lt;/li&gt;&lt;li&gt;&lt;b&gt;Timeframe / interval&lt;/b&gt; = size of one bar (1m, 5m, 1h, 1D). In yfinance: &lt;i&gt;interval=&quot;1h&quot;&lt;/i&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Period&lt;/b&gt; = how much history you download / look back (1wk, 1mo, 1y). In yfinance: &lt;i&gt;period=&quot;1wk&quot;&lt;/i&gt;  → 1 week of 1h bars ≈ 5 days × 24 = 120 rows (FX)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Horizon h&lt;/b&gt; = how many steps ahead the target is (h = 1 → next bar's close)&lt;/li&gt;&lt;li&gt;Unlike normal tabular data, rows are &lt;b&gt;not independent&lt;/b&gt;: y&lt;sub&gt;t&lt;/sub&gt; depends on y&lt;sub&gt;t−1&lt;/sub&gt;, y&lt;sub&gt;t−2&lt;/sub&gt;, … → we must build lag features ⑧&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2150.0" width="600.0" height="190.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-595" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1680.0" width="980.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-596" value="⑧ From Time Steps to Lagged Features (sliding window, N = 3)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1434.0" y="1690.0" width="952.0" height="26.0" as="geometry" />
        </mxCell>
