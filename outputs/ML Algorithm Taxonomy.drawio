        <mxCell id="ensemble-1168" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Do I trust the majority or the confidence?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ day 3: hard vote says Down (1 of 3), soft average 0.58 &gt; 0.5 says Up — correct; soft wins when models are calibrated&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
