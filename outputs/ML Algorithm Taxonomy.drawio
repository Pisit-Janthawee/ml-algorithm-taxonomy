        <mxCell id="labelling-441" value="train (past)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="1983.0" width="300.0" height="28.0" as="geometry" />
