        <mxCell id="anomaly-284" value="Simulated 260 trading days · window w = 20 · 5 volatility regimes (calm ↔ stressed) · 10 injected anomalies" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
