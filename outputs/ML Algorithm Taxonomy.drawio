        <mxCell id="labelling-227" value="&lt;b&gt;1. Fixed τ ignores volatility&lt;/b&gt;&lt;br&gt;calm market → almost all 0; volatile market → all ±1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
