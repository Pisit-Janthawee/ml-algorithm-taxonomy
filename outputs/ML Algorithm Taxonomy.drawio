            <mxPoint x="796.0" y="3535.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-1323" value="Crowding problem: 2-D has far less room than 10-D; heavy tails stop clusters from collapsing together" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3592.0" width="480.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1324" value="3. Cost: Kullback-Leibler divergence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="930.0" y="3102.0" width="440.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1325" value="$$C = KL(P\,\|\,Q) = \sum_{i\neq j} p_{ij}\log\frac{p_{ij}}{q_{ij}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="930.0" y="3126.0" width="440.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1326" value="$$\frac{\partial C}{\partial y_i} = 4\sum_{j}(p_{ij}-q_{ij})(y_i-y_j)\left(1+\lVert y_i-y_j\rVert^2\right)^{-1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="930.0" y="3180.0" width="440.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1327" value="(p − q) &amp;gt; 0 → pull together, &amp;lt; 0 → push apart" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="3236.0" width="260.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1328" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1105.0" y="3245.0" as="sourcePoint" />
            <mxPoint x="1105.0" y="3212.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-1329" value="4. Gradient descent (early exaggeration ×12 for 100 iterations, then momentum 0.8)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
