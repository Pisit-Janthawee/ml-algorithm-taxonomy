        <mxCell id="tstests-184" value="\(H_0: \gamma = 0\) → &lt;b&gt;unit root&lt;/b&gt; (non-stationary)&lt;br&gt;\(H_1: \gamma \lt 0\) → &lt;b&gt;stationary&lt;/b&gt; (left-tailed test)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
