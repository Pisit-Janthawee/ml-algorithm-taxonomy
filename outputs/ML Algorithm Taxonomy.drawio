        <mxCell id="recsys-305" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="1780.0" width="1000.0" height="740.0" as="geometry" />
        </mxCell>
        <mxCell id="recsys-306" value="⑤ Matrix Factorization (latent factors, trained by SGD)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1790.0" width="972.0" height="26.0" as="geometry" />
