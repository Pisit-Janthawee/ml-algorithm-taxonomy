        <mxCell id="timeseries-589" value="horizon h (predict ahead)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1125.0" y="2028.0" width="170.0" height="16.0" as="geometry" />
