        <mxCell id="statistics-726" value="Reject H₀&lt;br&gt;α/2 = 2.5 %" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
