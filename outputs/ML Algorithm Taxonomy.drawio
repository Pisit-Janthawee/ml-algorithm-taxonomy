        <mxCell id="versatile-1107" value="Mean absolute colour error on missing pixels: &lt;b&gt;12.1&lt;/b&gt; / 255  ·  scattered holes &lt;b&gt;10.6&lt;/b&gt;  vs  scratched block &lt;b&gt;20.1&lt;/b&gt; (neighbours are farther away → blurrier)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="546.0" width="912.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1108" value="$$\hat{x}_p = \frac{1}{k}\sum_{q \in N_k(p)} x_q$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="592.0" width="300.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1109" value="$$\hat{x}_p = \frac{\sum_{q} x_q / d_{pq}}{\sum_{q} 1 / d_{pq}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="750.0" y="592.0" width="300.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1110" value="plain average" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="640.0" width="300.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1111" value="distance-weighted (sharper)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="750.0" y="640.0" width="300.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1112" value="&lt;b&gt;Where &amp; why:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(p\) = missing pixel, \(N_k(p)\) = its k closest &lt;b&gt;known&lt;/b&gt; pixels by Euclidean distance on (row, col), \(x_q\) = RGB colour&lt;/li&gt;&lt;li&gt;Works because images are &lt;b&gt;smooth&lt;/b&gt;: neighbouring pixels usually have similar colours (the kNN assumption)&lt;/li&gt;&lt;li&gt;Small k keeps edges sharp but is noisy; large k blurs. Weighting by 1/d helps at edges&lt;/li&gt;&lt;li&gt;Real tools add colour/texture similarity (patch matching) and diffusion — kNN is the simplest baseline&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="667.0" width="840.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-1113" value="Zoom: pixel (10, 10) and its 4 nearest known pixels" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
