        <mxCell id="deeplearning-530" value="&lt;b&gt;Yellow window → yellow output:&lt;/b&gt;&lt;br&gt;10·1 + 10·0 + 0·-1 + 10·1 + 10·0 + 0·-1 + 10·1 + 10·0 + 0·-1 = &lt;b&gt;30&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1240.0" y="3450.0" width="560.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-531" value="$$S(i,j) = (I * K)(i,j) = \sum_{m}\sum_{n} I(i+m,\,j+n)\,K(m,n)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1240.0" y="3505.0" width="560.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-532" value="$$\text{output size} = \frac{n + 2p - k}{s} + 1 = \frac{5 + 0 - 3}{1} + 1 = 3$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1240.0" y="3555.0" width="560.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-533" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;n = input size, k = kernel size, p = padding (zeros around), s = stride (step)&lt;/li&gt;&lt;li&gt;'same' padding p = (k−1)/2 keeps the size; stride 2 halves it&lt;/li&gt;&lt;li&gt;Each filter learns one pattern (edge, corner, texture); a layer has many filters&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1240.0" y="3610.0" width="560.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-534" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why is the feature map smaller than the input?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ a 3×3 filter fits only 3 positions per row → (5 − 3)/1 + 1 = 3; add padding p = 1 to keep 5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1240.0" y="3712.0" width="560.0" height="54.0" as="geometry" />
        </mxCell>
