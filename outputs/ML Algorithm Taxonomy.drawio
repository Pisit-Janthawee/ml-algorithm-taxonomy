        <mxCell id="dimred-2505" value="$$w_{ij} = \exp\left(-\frac{d_{ij} - \rho_i}{\sigma_i}\right),\quad \sum_j w_{ij} = \log_2 k$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
