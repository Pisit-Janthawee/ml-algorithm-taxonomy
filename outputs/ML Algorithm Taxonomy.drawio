        </mxCell>
        <mxCell id="classification-214" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1858.0" y="540.9" width="8.0" height="8.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-215" value="Example (y = 1):  p̂ = 0.9 → loss = 0.105  ·  &lt;span style=&quot;background:#FFFF00&quot;&gt;p̂ = 0.1 → loss = 2.303&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="680.0" width="580.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-216" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Likelihood of one sample (Bernoulli):  \(P(y\mid x) = \hat{p}^{\,y}(1-\hat{p})^{1-y}\);  log + minus sign → log loss&lt;/li&gt;&lt;li&gt;Why not MSE?  Sigmoid + MSE is &lt;b&gt;non-convex&lt;/b&gt; (local minima); log loss is &lt;b&gt;convex&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Regularized: \(J + \frac{\lambda}{2m}\sum_j\beta_j^2\)  (scikit-learn uses \(C = 1/\lambda\))&lt;/li&gt;&lt;li&gt;Objective: \(\min_\beta J(\beta)\) → no closed form → Gradient Descent ④&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="715.0" width="620.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-217" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How much is a confident wrong prediction punished?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ heavily: p̂ = 0.1 for a true 1 costs 2.30 vs 0.105 for p̂ = 0.9 — log loss rewards honest probabilities&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="845.0" width="620.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-218" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1862.0" y="845.0" as="sourcePoint" />
            <mxPoint x="1862.0" y="544.9" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="classification-219" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="980.0" width="1320.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-220" value="④ Training with Gradient Descent (worked example)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="990.0" width="1292.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-221" value="Data: hours studied x = [1, 2, 3, 4], passed y = [0, 0, 1, 1],  α = 0.5,  start β₀ = β₁ = 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1016.0" width="1292.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-222" value="Repeat until convergence:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1060.0" width="380.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-223" value="$$\beta_j := \beta_j - \alpha\,\frac{\partial J}{\partial\beta_j}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1085.0" width="380.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-224" value="$$\frac{\partial J}{\partial\beta_j} = \frac{1}{m}\sum_{i=1}^{m}(\hat{p}_i - y_i)\,x_{ij}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1145.0" width="380.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-225" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;Same form as Linear Regression!&lt;/span&gt;&lt;br&gt;only \(\hat{p} = \sigma(z)\) replaces \(\hat{y} = z\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1210.0" width="380.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-226" value="(prediction − actual) × feature" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="650.0" y="1270.0" width="180.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-227" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700.0" y="1279.0" as="sourcePoint" />
            <mxPoint x="700.0" y="1180.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="classification-228" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;β = zeros(p+1)&lt;br&gt;for epoch in range(N):&lt;br&gt;&amp;nbsp;&amp;nbsp;p̂ = sigmoid(X @ β)&lt;br&gt;&amp;nbsp;&amp;nbsp;grad = Xᵀ(p̂ − y) / m&lt;br&gt;&amp;nbsp;&amp;nbsp;β -= α · grad&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1310.0" width="380.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-229" value="Iteration 1 (β₀ = 0, β₁ = 0)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="1060.0" width="420.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-230" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;\(x\)&lt;/th&gt;&lt;th&gt;\(y\)&lt;/th&gt;&lt;th&gt;\(z\)&lt;/th&gt;&lt;th&gt;\(\hat{p}\)&lt;/th&gt;&lt;th&gt;\(\hat{p}-y\)&lt;/th&gt;&lt;th&gt;\((\hat{p}-y)x\)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;0.500&lt;/td&gt;&lt;td&gt;+0.500&lt;/td&gt;&lt;td&gt;+0.500&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;0.500&lt;/td&gt;&lt;td&gt;+0.500&lt;/td&gt;&lt;td&gt;+1.000&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;0.500&lt;/td&gt;&lt;td&gt;-0.500&lt;/td&gt;&lt;td&gt;-1.500&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;0.500&lt;/td&gt;&lt;td&gt;-0.500&lt;/td&gt;&lt;td&gt;-2.000&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;mean&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.000&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;-0.500&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="1088.0" width="420.0" height="130.0" as="geometry" />
        </mxCell>
