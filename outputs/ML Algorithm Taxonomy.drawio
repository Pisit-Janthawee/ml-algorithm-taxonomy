        <mxCell id="deeplearning-470" value="" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="deeplearning-461" target="deeplearning-467">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-471" value="&lt;b&gt;Transformer&lt;/b&gt; (BERT, GPT)&lt;br&gt;&lt;font style='font-size:10px'&gt;+ self-attention, drops recurrence&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="630.0" y="3690.0" width="300.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-472" value="attention replaces the loop" style="endArrow=classic;endFill=1;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="deeplearning-466" target="deeplearning-471">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-473" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What does the Transformer add to the MLP?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ self-attention: every position weighs all others → no loop, fully parallel training&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="955.0" y="3648.0" width="190.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-474" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="955.0" y="3696.0" as="sourcePoint" />
            <mxPoint x="931.0" y="3720.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-475" value="(Vision Transformer = image patches + attention: CNN and Transformer ideas meet)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="3755.0" width="360.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-476" value="&lt;b&gt;What stays the same, what changes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Shared by all: neurons, activations ②, forward pass ④, loss, backprop + gradient descent ⑤&lt;/li&gt;&lt;li&gt;CNN shares weights across &lt;b&gt;space&lt;/b&gt;; RNN shares weights across &lt;b&gt;time&lt;/b&gt;; Transformer learns which positions to attend to&lt;/li&gt;&lt;li&gt;'ANN' = the whole family; 'MLP' = its plain fully-connected member (also called a dense / feed-forward network)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="3775.0" width="720.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-477" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="3150.0" width="1200.0" height="760.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-478" value="⑩ CNN: the convolution operation (worked example)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1214.0" y="3160.0" width="1172.0" height="26.0" as="geometry" />
        </mxCell>
