        </mxCell>
        <mxCell id="clustering-507" value="&lt;b&gt;Pitfalls:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Must choose k in advance;  sensitive to outliers (mean is pulled) → K-Medoids&lt;/li&gt;&lt;li&gt;Assumes round, similar-size clusters → GMM for elliptical / soft clusters&lt;/li&gt;&lt;li&gt;Complexity ≈ O(n · k · iterations) → fast;  Mini-Batch K-Means for big data&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="1355.0" width="560.0" height="85.0" as="geometry" />
        </mxCell>
