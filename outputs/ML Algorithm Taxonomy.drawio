        </mxCell>
        <mxCell id="recsys-212" value="Step 1 — mean-centre each user (removes &amp;#x27;generous&amp;#x27; vs &amp;#x27;strict&amp;#x27; raters)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
