        <mxCell id="hypotests-624" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does it matter whether my samples are linked?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: the same data gives p = 0.361 treated as independent but p = 0.0030 paired → respect the pairing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1568.0" width="600.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-625" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1640.0" y="1568.0" as="sourcePoint" />
            <mxPoint x="1640.0" y="1448.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hypotests-626" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Are the three strategy means really different?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ F = 11.53 is far beyond the 5 % cut-off 3.68 → p = 0.00093: at least one mean differs (Tukey says which)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1555.0" width="560.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-627" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2340.0" y="1555.0" as="sourcePoint" />
            <mxPoint x="2360.0" y="1432.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hypotests-628" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why use ranks instead of raw values?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ 30 just becomes rank 10: outliers lose their pull, no normality needed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="785.0" y="1712.0" width="230.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-629" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935.0" y="1780.0" as="sourcePoint" />
            <mxPoint x="935.0" y="1820.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hypotests-630" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What would counts be with no link?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ E = row×col/N: 52.5 vs 60 seen&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1485.0" y="1714.0" width="230.0" height="51.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-631" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1550.0" y="1765.0" as="sourcePoint" />
            <mxPoint x="1550.0" y="1798.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hypotests-632" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is r or ρ the right measure here?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ monotonic but curved data: ρ = 0.954 &gt; r = 0.911 → Spearman fits better&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
