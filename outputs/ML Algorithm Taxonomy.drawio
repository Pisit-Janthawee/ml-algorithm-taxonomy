        <mxCell id="rl-119" value="Optimal path from START: 6 steps (red dashed)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
