        <mxCell id="ensemble-1167" value="Day 3: only LR says Up, but it is very sure" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;" vertex="1" parent="1">
