        <mxCell id="kernel-176" value="Minkowski (Lp)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
