        <mxCell id="deeplearning-199" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780.0" y="1089.0" as="sourcePoint" />
            <mxPoint x="740.0" y="1015.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-200" value="Network 2 → 2 (ReLU) → 1 (sigmoid),  input x = [1, 2],  target y = 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1120.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-201" value="1. Hidden" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1155.0" width="90.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-202" value="$$z^{(1)}=\begin{bmatrix}0.5 &amp; -1\\ 1 &amp; 0.5\end{bmatrix}\begin{bmatrix}1\\2\end{bmatrix}+\begin{bmatrix}0\\1\end{bmatrix}=\begin{bmatrix}-1.5\\3\end{bmatrix}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="510.0" y="1155.0" width="510.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-203" value="2. ReLU" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1237.0" width="90.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-204" value="$$a^{(1)}=\max(0,z^{(1)})=\begin{bmatrix}0\\3\end{bmatrix}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="510.0" y="1237.0" width="510.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-205" value="3. Output" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1319.0" width="90.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-206" value="$$z^{(2)}=\begin{bmatrix}1 &amp; 0.5\end{bmatrix}\begin{bmatrix}0\\3\end{bmatrix}+0.2=1.7$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="510.0" y="1319.0" width="510.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-207" value="4. Sigmoid" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1401.0" width="90.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-208" value="$$\hat{y}=\sigma(1.7)=\frac{1}{1+e^{-1.7}}=0.846$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="510.0" y="1401.0" width="510.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-209" value="5. Loss" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1459.0" width="90.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-210" value="$$L=-[y\log\hat{y}+(1-y)\log(1-\hat{y})]=-\log(0.846)=0.167$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="510.0" y="1459.0" width="510.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-211" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What does the network predict for x = [1, 2]?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ ŷ = 0.846 → class 1 (85% sure); small loss 0.167 since y = 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="1245.0" width="210.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-212" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820.0" y="1327.0" as="sourcePoint" />
            <mxPoint x="752.0" y="1428.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-213" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;Prediction ŷ = 0.846 → class 1;  loss = 0.167&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1523.0" width="600.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-214" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="920.0" width="620.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-215" value="⑤ Backpropagation + Gradient Descent" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="930.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-216" value="Background: chain rule of calculus" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="956.0" width="592.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-217" value="\(W^{(2)}\)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="1030.0" width="90.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-218" value="\(z^{(2)}\)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1265.0" y="1030.0" width="90.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-219" value="\(\hat{y}\)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1410.0" y="1030.0" width="90.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-220" value="\(L\)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1555.0" y="1030.0" width="90.0" height="50.0" as="geometry" />
