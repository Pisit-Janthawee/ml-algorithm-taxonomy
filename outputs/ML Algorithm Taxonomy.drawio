          <mxGeometry x="1000.0" y="240.0" width="1400.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="association-58" value="② Itemset Lattice — level-wise search with pruning" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
