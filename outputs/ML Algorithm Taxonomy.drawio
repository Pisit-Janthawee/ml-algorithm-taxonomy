        <mxCell id="dimred-341" value="&lt;span style='background:#FFFF00'&gt;2 features → 1 feature, keeping 93% of the information&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1240.0" width="580.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-342" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;New features (PC scores) are uncorrelated → removes multicollinearity&lt;/li&gt;&lt;li&gt;Reconstruction: \(\hat{X} = Z W^{T}\) (lossy: the PC2 part is thrown away)&lt;/li&gt;&lt;li&gt;Fit μ, σ and W on training data only, then apply to valid / test (no leakage)&lt;/li&gt;&lt;li&gt;Used in your EA pipeline: &lt;i&gt;Data Reduction&lt;/i&gt; step before LSTM&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
