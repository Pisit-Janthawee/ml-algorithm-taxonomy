        <mxCell id="tstests-167" value="φ = 0.5 → shock fades (stationary)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
