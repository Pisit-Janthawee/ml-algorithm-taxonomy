        <mxCell id="hypotests-351" value="$$t = \frac{\bar{d}}{s_d/\sqrt{n}},\ df=n-1$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1265.0" width="280.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-352" value="d = after − before = [3, 4, 2, 2, 4, 1]&lt;br&gt;d̄ = 2.67, s_d = 1.21, n = 6&lt;br&gt;t = &lt;b&gt;5.39&lt;/b&gt;, df = 5 → p = &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;0.0030&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1312.0" width="290.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-353" value="&lt;b&gt;Same before/after data, wrong linkage:&lt;/b&gt; independent t = 0.96, p = 0.361 → &lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;not significant&lt;/b&gt;&lt;/font&gt;&lt;br&gt;The paired t removes the subject-to-subject spread (baselines 68 … 80) and tests only the changes d → p = 0.0030" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FF8000;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1385.0" width="600.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-354" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;One-sample t&lt;/b&gt;: \(t = (\bar{x}-\mu_0)/(s/\sqrt{n})\), df = n − 1&lt;/li&gt;&lt;li&gt;&lt;b&gt;Student's t&lt;/b&gt; pools variances (assumes σ₁ = σ₂); &lt;b&gt;Welch&lt;/b&gt; does not — use Welch by default&lt;/li&gt;&lt;li&gt;Assumptions: normal (or n ≥ 30 per group), independent observations; paired: differences normal&lt;/li&gt;&lt;li&gt;Non-normal / ordinal → Mann-Whitney U (independent) or Wilcoxon signed-rank (paired) ⑥&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1475.0" width="600.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-355" value="&lt;b&gt;Why linkage matters (see ④):&lt;/b&gt; the same 6 before/after pairs give p = 0.0030 with a paired t-test but p = 0.361 if wrongly treated as independent samples." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="800.0" width="600.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-356" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="980.0" width="640.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-357" value="⑤ One-way ANOVA (3+ independent groups)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1774.0" y="990.0" width="612.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-358" value="Is the variation BETWEEN group means large compared with variation WITHIN groups?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
