        <mxCell id="regression-208" value="Convex &amp;#x27;bowl&amp;#x27; → one global minimum" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
