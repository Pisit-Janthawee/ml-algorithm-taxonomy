          <mxGeometry x="880.0" y="2010.0" width="440.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-386" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Features on very different scales (e.g. size 50–500 m² vs rooms 1–6) stretch the cost bowl&lt;/li&gt;&lt;li&gt;Fit μ, σ (or min, max) on the &lt;b&gt;training set only&lt;/b&gt;, then apply the same values to validation / test&lt;/li&gt;&lt;li&gt;Tree-based models do not need scaling; GD-based models (linear, logistic, SVM, NN, k-NN) do&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2060.0" width="920.0" height="66.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-387" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1400.0" y="1620.0" width="1000.0" height="540.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-388" value="⑧ Optimization family at a glance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1414.0" y="1630.0" width="972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-389" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Algorithm&lt;/th&gt;&lt;th&gt;Update idea&lt;/th&gt;&lt;th&gt;Pros&lt;/th&gt;&lt;th&gt;Cons&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;★ Batch GD&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;\(\theta -= \alpha\frac{1}{m}\sum\nabla J_i\)&lt;/td&gt;&lt;td&gt;stable, exact gradient&lt;/td&gt;&lt;td&gt;slow on big data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SGD&lt;/td&gt;&lt;td&gt;\(\theta -= \alpha\nabla J_i\) (one sample)&lt;/td&gt;&lt;td&gt;fast, escapes shallow minima&lt;/td&gt;&lt;td&gt;noisy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mini-batch GD&lt;/td&gt;&lt;td&gt;average over a batch b&lt;/td&gt;&lt;td&gt;GPU friendly, default&lt;/td&gt;&lt;td&gt;batch size to tune&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Momentum / Nesterov&lt;/td&gt;&lt;td&gt;add velocity \(v_t\)&lt;/td&gt;&lt;td&gt;less zig-zag&lt;/td&gt;&lt;td&gt;extra β&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AdaGrad&lt;/td&gt;&lt;td&gt;\(\alpha / \sqrt{\sum g^2}\)&lt;/td&gt;&lt;td&gt;good for sparse features&lt;/td&gt;&lt;td&gt;α decays to 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RMSProp&lt;/td&gt;&lt;td&gt;\(\alpha / \sqrt{E[g^2]}\)&lt;/td&gt;&lt;td&gt;fixes AdaGrad decay&lt;/td&gt;&lt;td&gt;needs β&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Adam&lt;/td&gt;&lt;td&gt;momentum + RMSProp&lt;/td&gt;&lt;td&gt;robust default for DL&lt;/td&gt;&lt;td&gt;may generalize worse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Normal Equation&lt;/td&gt;&lt;td&gt;\(\theta = (X^TX)^{-1}X^Ty\)&lt;/td&gt;&lt;td&gt;no α, exact&lt;/td&gt;&lt;td&gt;\(O(n^3)\), linear only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Newton / L-BFGS&lt;/td&gt;&lt;td&gt;uses curvature (Hessian)&lt;/td&gt;&lt;td&gt;few iterations&lt;/td&gt;&lt;td&gt;expensive per step&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Genetic / PSO / Bayesian Opt.&lt;/td&gt;&lt;td&gt;search without gradients&lt;/td&gt;&lt;td&gt;hyperparameter tuning&lt;/td&gt;&lt;td&gt;slow, many evaluations&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="1670.0" width="960.0" height="235.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-390" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which optimizer should I start with?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Adam (or mini-batch SGD + momentum) for neural nets; Batch GD / Normal Equation for small convex models&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2200.0" y="1805.0" width="190.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-391" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2200.0" y="1846.0" as="sourcePoint" />
            <mxPoint x="2188.0" y="1873.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
