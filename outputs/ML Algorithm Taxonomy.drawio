        <mxCell id="versatile-1139" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;neighbour (r, c)&lt;/th&gt;&lt;th&gt;distance&lt;/th&gt;&lt;th&gt;R&lt;/th&gt;&lt;th&gt;G&lt;/th&gt;&lt;th&gt;B&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(9, 10)&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;200&lt;/td&gt;&lt;td&gt;220&lt;/td&gt;&lt;td&gt;225&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(10, 9)&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;160&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(10, 11)&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;160&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(11, 10)&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;64&lt;/td&gt;&lt;td&gt;150&lt;/td&gt;&lt;td&gt;56&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;&lt;b&gt;average → estimate&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;101&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;172&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;100&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;true colour&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;70&lt;/td&gt;&lt;td&gt;160&lt;/td&gt;&lt;td&gt;60&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
