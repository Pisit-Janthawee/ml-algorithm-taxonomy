        <mxCell id="recsys-309" value="≈" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="558.0" y="1905.0" width="30.0" height="30.0" as="geometry" />
