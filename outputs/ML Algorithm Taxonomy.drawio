        <mxCell id="explain-417" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Coalition S&lt;/th&gt;&lt;th&gt;v(S) = avg prediction&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;∅ (base)&lt;/td&gt;&lt;td&gt;0.636&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{EMA}&lt;/td&gt;&lt;td&gt;0.442&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{RSI}&lt;/td&gt;&lt;td&gt;0.316&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{EMA, RSI}&lt;/td&gt;&lt;td&gt;0.167&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Vol}&lt;/td&gt;&lt;td&gt;0.660&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{EMA, Vol}&lt;/td&gt;&lt;td&gt;0.491&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{RSI, Vol}&lt;/td&gt;&lt;td&gt;0.319&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;{EMA, RSI, Vol}&lt;/td&gt;&lt;td&gt;0.176&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
