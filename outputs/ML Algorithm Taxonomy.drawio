        <mxCell id="distributions-796" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How many orders should I expect per minute?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ λ = 3 on average; 5 or more happens only ≈ 18 % of the time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
