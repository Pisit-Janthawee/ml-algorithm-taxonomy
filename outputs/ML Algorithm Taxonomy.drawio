        <mxCell id="classification-234" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;\(x\)&lt;/th&gt;&lt;th&gt;\(z\)&lt;/th&gt;&lt;th&gt;\(\hat{p}\)&lt;/th&gt;&lt;th&gt;\(\hat{p}-y\)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.25&lt;/td&gt;&lt;td&gt;0.562&lt;/td&gt;&lt;td&gt;+0.562&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0.50&lt;/td&gt;&lt;td&gt;0.622&lt;/td&gt;&lt;td&gt;+0.622&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.679&lt;/td&gt;&lt;td&gt;-0.321&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;0.731&lt;/td&gt;&lt;td&gt;-0.269&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
