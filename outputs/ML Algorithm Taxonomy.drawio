        <mxCell id="recsys-431" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;metric (K = 5)&lt;/th&gt;&lt;th&gt;formula&lt;/th&gt;&lt;th&gt;value&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Precision@5&lt;/td&gt;&lt;td&gt;hits in top-K / K&lt;/td&gt;&lt;td&gt;3/5 = 0.60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Recall@5&lt;/td&gt;&lt;td&gt;hits in top-K / all relevant&lt;/td&gt;&lt;td&gt;3/5 = 0.60&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;NDCG@5&lt;/td&gt;&lt;td&gt;DCG / ideal DCG&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;1.931/2.948 = 0.65&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
