        <mxCell id="evaluation-305" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;MAE&lt;/th&gt;&lt;th&gt;RMSE&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;original&lt;/td&gt;&lt;td&gt;2.33&lt;/td&gt;&lt;td&gt;2.89&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;with outlier&lt;/td&gt;&lt;td&gt;5.00 (×2.1)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;7.85 (×2.7)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="1296.0" width="400.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-306" value="&lt;b&gt;Choose:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;RMSE squares errors → punishes large misses; MAE treats all equally&lt;/li&gt;&lt;li&gt;R² compares with always predicting ȳ (can be negative!)&lt;/li&gt;&lt;li&gt;MAPE explodes when y ≈ 0 (returns!) → use MAE / RMSE or sMAPE&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="1390.0" width="410.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-307" value="For trading, also judge by direction accuracy and P&amp;amp;L, not only price error." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
