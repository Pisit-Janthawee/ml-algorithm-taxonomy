        </mxCell>
        <mxCell id="anomaly-147" value="Z-score of one observation:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="510.0" width="480.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-148" value="$$z_i = \frac{x_i - \mu}{\sigma}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="535.0" width="280.0" height="64.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-149" value="how far is the value from the mean …" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="615.0" width="210.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-150" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1570.0" y="624.0" as="sourcePoint" />
            <mxPoint x="1585.0" y="555.0" as="targetPoint" />
