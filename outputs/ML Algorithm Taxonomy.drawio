        <mxCell id="nlp-10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4.0" y="187.0" as="sourcePoint" />
            <mxPoint x="9.0" y="187.0" as="targetPoint" />
