        <mxCell id="kernel-178" value="$$p=1 → L1,\ p=2 → L2$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="1575.0" y="536.0" width="110.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-179" value="$$\text{cosine: } 1 - \frac{a \cdot b}{\lVert a\rVert\,\lVert b\rVert}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1140.0" y="600.0" width="500.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-180" value="&lt;b&gt;When to use:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Euclidean&lt;/b&gt; — default, straight-line distance (needs scaled features ③)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Manhattan&lt;/b&gt; — grid / city-block distance, less sensitive to one large difference&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cosine&lt;/b&gt; — angle between vectors; used for text (Bag-of-Words, TF-IDF)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Hamming&lt;/b&gt; — number of differing positions, for categorical / binary features&lt;/li&gt;&lt;li&gt;The metric defines what 'similar' means → it changes who the neighbours are&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="655.0" width="580.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-181" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does the choice of distance metric matter?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: the same two points are 5 (Euclidean), 7 (Manhattan) or 4 (Chebyshev) apart, so neighbour rankings can change&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
