        <mxCell id="distributions-352" value="$$Mo = 30 + \frac{20-12}{(20-12)+(20-10)}\times 10 = 34.44$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="615.0" width="480.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-353" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(L\) = lower limit of the modal class (30–40),  \(h\) = class width (10)&lt;/li&gt;&lt;li&gt;\(f_1\) = frequency of modal class (20),  \(f_0\) = class before (12),  \(f_2\) = class after (10)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="665.0" width="480.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-354" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Measure&lt;/th&gt;&lt;th&gt;Best for&lt;/th&gt;&lt;th&gt;Sensitive to outliers?&lt;/th&gt;&lt;th&gt;Example use in ML&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mean&lt;/td&gt;&lt;td&gt;symmetric numeric data&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;feature scaling (μ), K-Means centroid, imputation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Median&lt;/td&gt;&lt;td&gt;skewed data / outliers&lt;/td&gt;&lt;td&gt;No (robust)&lt;/td&gt;&lt;td&gt;robust imputation, prices, income, MAE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mode&lt;/td&gt;&lt;td&gt;categorical / discrete&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;fill missing categories, majority vote (k-NN, trees)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="770.0" width="960.0" height="88.0" as="geometry" />
