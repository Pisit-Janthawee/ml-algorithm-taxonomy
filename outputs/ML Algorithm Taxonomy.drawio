          <mxGeometry x="1100.0" y="722.0" width="520.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-203" value="&lt;b&gt;Why:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Fewer, more informative samples; labels start at events t₀&lt;/li&gt;&lt;li&gt;Dollar/volume bars have returns closer to i.i.d. normal than time bars&lt;/li&gt;&lt;li&gt;h is often set from volatility (e.g. h = daily σ)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="750.0" width="520.0" height="85.0" as="geometry" />
