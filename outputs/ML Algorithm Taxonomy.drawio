          </mxGeometry>
        </mxCell>
        <mxCell id="problems-885" value="&lt;b&gt;Look-ahead:&lt;/b&gt; signal computed from Close(t) but the trade fills at Open(t) — or a feature uses a revised / centred value. Fix: point-in-time data, &lt;font face='Courier New'&gt;shift(1)&lt;/font&gt;, trade at t+1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FF0000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="2405.0" width="480.0" height="48.0" as="geometry" />
        </mxCell>
        <UserObject label="Non-stationarity (mean / variance drift over time) → tests &amp;amp; fixes on the ADF page" link="data:page/id,tstests" id="problems-886">
          <mxCell style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#3333FF;" vertex="1" parent="1">
            <mxGeometry x="430.0" y="2470.0" width="540.0" height="18.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="problems-887" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1540.0" y="1780.0" width="860.0" height="720.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-888" value="⑥ Problem → Symptom → Detection → Remedy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1554.0" y="1790.0" width="832.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-889" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Problem&lt;/th&gt;&lt;th&gt;Symptom&lt;/th&gt;&lt;th&gt;Detect with&lt;/th&gt;&lt;th&gt;Remedy&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Curse of dimensionality&lt;/td&gt;&lt;td&gt;kNN / K-Means degrade as columns grow&lt;/td&gt;&lt;td&gt;n / p ratio, distance ratio&lt;/td&gt;&lt;td&gt;feature selection, PCA, L1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Small data&lt;/td&gt;&lt;td&gt;scores swing across folds&lt;/td&gt;&lt;td&gt;CV std, learning curve&lt;/td&gt;&lt;td&gt;simpler model, regularize, more rows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Multicollinearity&lt;/td&gt;&lt;td&gt;coefficients flip sign&lt;/td&gt;&lt;td&gt;VIF &amp;gt; 10, correlation matrix&lt;/td&gt;&lt;td&gt;drop / combine, Ridge, PCA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Class imbalance&lt;/td&gt;&lt;td&gt;high accuracy, low recall&lt;/td&gt;&lt;td&gt;class counts, PR curve&lt;/td&gt;&lt;td&gt;class weights, SMOTE (train fold), threshold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Label noise&lt;/td&gt;&lt;td&gt;train error won't drop&lt;/td&gt;&lt;td&gt;inspect errors, label agreement&lt;/td&gt;&lt;td&gt;relabel, robust loss&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Leaky target&lt;/td&gt;&lt;td&gt;validation too good to be true&lt;/td&gt;&lt;td&gt;importance spike, timestamp audit&lt;/td&gt;&lt;td&gt;remove column, time-aware pipeline&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Missing data&lt;/td&gt;&lt;td&gt;NaNs, biased subsets&lt;/td&gt;&lt;td&gt;missingness by column / group&lt;/td&gt;&lt;td&gt;kNN / model impute, is_missing flag&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Outliers&lt;/td&gt;&lt;td&gt;slope / mean jumps&lt;/td&gt;&lt;td&gt;Z-score, IQR, Cook's distance&lt;/td&gt;&lt;td&gt;check, cap, robust models&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Skewed features&lt;/td&gt;&lt;td&gt;mean ≫ median&lt;/td&gt;&lt;td&gt;skewness, histogram&lt;/td&gt;&lt;td&gt;log / Box-Cox&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Non-stationarity&lt;/td&gt;&lt;td&gt;statistics shift over time&lt;/td&gt;&lt;td&gt;ADF / KPSS, rolling stats&lt;/td&gt;&lt;td&gt;differencing, returns, retrain&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Data / concept drift&lt;/td&gt;&lt;td&gt;live metric decays&lt;/td&gt;&lt;td&gt;PSI, KS, monitoring&lt;/td&gt;&lt;td&gt;retrain, sliding window, alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Look-ahead / survivorship&lt;/td&gt;&lt;td&gt;backtest ≫ live results&lt;/td&gt;&lt;td&gt;timestamp audit, delisted data&lt;/td&gt;&lt;td&gt;point-in-time data, shift(1)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="1830.0" width="820.0" height="338.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-890" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What explains 'great backtest, bad live trading'?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Usually leakage, look-ahead or survivorship bias (rows 6 and 12) — audit timestamps and the universe first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1980.0" y="2188.0" width="400.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-891" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1980.0" y="2188.0" as="sourcePoint" />
            <mxPoint x="1650.0" y="2097.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="problems-892" value="&lt;b&gt;Pre-modelling checklist:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Profile every column: type, missing %, unique values, skew&lt;/li&gt;&lt;li&gt;Count rows per class and rows per feature (n / p)&lt;/li&gt;&lt;li&gt;Check timestamps: is every feature known at prediction time?&lt;/li&gt;&lt;li&gt;Split by time / group before any fitting or resampling&lt;/li&gt;&lt;li&gt;Compare train vs recent data (PSI, KS) before deploying&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="2198.0" width="400.0" height="125.0" as="geometry" />
        </mxCell>
      </root>
