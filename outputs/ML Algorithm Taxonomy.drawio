        <mxCell id="recsys-310" value="U&lt;br&gt;6×2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#000000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="595.0" y="1860.0" width="40.0" height="120.0" as="geometry" />
