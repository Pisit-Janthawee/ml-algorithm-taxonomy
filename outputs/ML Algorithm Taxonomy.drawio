        <mxCell id="association-240" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which min_support should I choose?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ 0.08: the knee; below it noise rules explode, above it useful lift-filtered rules start to vanish&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
