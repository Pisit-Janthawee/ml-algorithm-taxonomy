        <mxCell id="association-173" value="&lt;b&gt;Read it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;A ∪ B in the formula = the itemset containing &lt;b&gt;both&lt;/b&gt; A and B (overlap in the Venn)&lt;/li&gt;&lt;li&gt;Lift &gt; 1 positive association · = 1 independent · &lt; 1 negative (substitutes)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
