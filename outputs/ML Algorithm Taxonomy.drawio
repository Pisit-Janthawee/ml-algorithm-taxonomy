        <mxCell id="statistics-853" value="&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;— Normal&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;- - t, df = 1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF8000&quot;&gt;- - t, df = 3&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;- - t, df = 10&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2280.0" y="1710.0" width="120.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-854" value="Smaller df → heavier tails → larger critical values; df ≥ 30 ≈ normal" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="1950.0" width="310.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-855" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why use t instead of z with a small sample?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ s is noisy at small n → t has fatter tails → wider cut-offs (2.57 at df = 5 vs 1.96)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2070.0" y="1988.0" width="310.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-856" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2333.8" y="1988.0" as="sourcePoint" />
            <mxPoint x="2333.8" y="1914.8" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-857" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Non-normal data &amp;amp; small n → non-parametric tests: Mann-Whitney U, Wilcoxon, Kruskal-Wallis&lt;/li&gt;&lt;li&gt;In ML: compare two models' CV scores with a paired t-test; check feature–target dependence with Chi-square (feature selection)&lt;/li&gt;&lt;li&gt;A/B testing = two-sample test on conversion rates (proportions)&lt;/li&gt;&lt;li&gt;All of these rely on the CLT: test statistics are (approximately) normal / t because they are built from means&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="2050.0" width="940.0" height="105.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
