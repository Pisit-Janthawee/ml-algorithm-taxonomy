        <mxCell id="ensemble-1238" value="&lt;b&gt;Rules:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Never&lt;/b&gt; train the meta-learner on in-sample predictions → it trusts overfitted models (leakage)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Blending&lt;/b&gt;: meta-learner trained on one hold-out split instead of K-fold OOF (simpler, wastes data)&lt;/li&gt;&lt;li&gt;Keep Level-1 simple (logistic / ridge); time series → purged / walk-forward folds&lt;/li&gt;&lt;li&gt;The meta-weights show which base model is trusted most&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1000.0" y="4840.0" width="470.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1239" value="$$\hat{y} = g\big(h_1(x), h_2(x), \dots, h_K(x)\big)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="460.0" y="4960.0" width="480.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1240" value="g = Level-1 meta-learner · hₖ = Level-0 base models (trained on full data for prediction time)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
