        <mxCell id="evaluation-268" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Score = &lt;b&gt;mean ± std&lt;/b&gt; over folds → report the uncertainty, not one number&lt;/li&gt;&lt;li&gt;K = 5 or 10 is the usual bias / cost trade-off; LOOCV for tiny data&lt;/li&gt;&lt;li&gt;Tuning on the same folds you report → optimistic; nested CV fixes it&lt;/li&gt;&lt;li&gt;Group K-Fold when rows share an entity (customer, ticker, patient)&lt;/li&gt;&lt;li&gt;Final model: refit on all training data with the chosen hyperparameters&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1880.0" y="650.0" width="500.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-269" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How will the model perform on data it has never seen?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only the Test 20 % score answers this — so read it once, at the very end (golden rule)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
