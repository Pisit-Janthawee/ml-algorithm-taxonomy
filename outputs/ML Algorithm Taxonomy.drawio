        <mxCell id="hypotests-469" value="R_A = 1+2+3+4+7 = 17 → U_A = 17 − 15 = 2&lt;br&gt;U = &lt;b&gt;2&lt;/b&gt; ≤ critical 2 (n = 5, 5, α = 0.05) → &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;medians differ&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
