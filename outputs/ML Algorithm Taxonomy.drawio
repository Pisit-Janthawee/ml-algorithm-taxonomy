            <mxPoint x="680.0" y="1805.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="explain-413" value="marginal contribution of j to coalition S" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
