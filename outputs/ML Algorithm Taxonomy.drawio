        <mxCell id="fitting-186" value="&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;✘ &lt;/b&gt;a linear model on x₁, x₂ alone gets 50 % — the signal is in their product&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
