        <mxCell id="optimization-197" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Batch GD&lt;/th&gt;&lt;th&gt;Mini-batch GD&lt;/th&gt;&lt;th&gt;SGD&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Samples / update&lt;/td&gt;&lt;td&gt;all m&lt;/td&gt;&lt;td&gt;b (32–512)&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Update rule&lt;/td&gt;&lt;td&gt;\(\frac{1}{m}\sum_{i=1}^{m}\nabla J_i\)&lt;/td&gt;&lt;td&gt;\(\frac{1}{b}\sum_{i\in B}\nabla J_i\)&lt;/td&gt;&lt;td&gt;\(\nabla J_i\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Speed / step&lt;/td&gt;&lt;td&gt;slow&lt;/td&gt;&lt;td&gt;fast (GPU)&lt;/td&gt;&lt;td&gt;very fast&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Path&lt;/td&gt;&lt;td&gt;smooth&lt;/td&gt;&lt;td&gt;small noise&lt;/td&gt;&lt;td&gt;noisy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Memory&lt;/td&gt;&lt;td&gt;whole dataset&lt;/td&gt;&lt;td&gt;one batch&lt;/td&gt;&lt;td&gt;one sample&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Typical use&lt;/td&gt;&lt;td&gt;small data, convex&lt;/td&gt;&lt;td&gt;deep learning default&lt;/td&gt;&lt;td&gt;online / streaming&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
