        <mxCell id="rl-268" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Tabular Q-Learning converges to the optimal Q* if all state–action pairs are visited often enough&lt;/li&gt;&lt;li&gt;In your EA: state = signal features, action = Buy / Hold / Sell, reward = PnL after spread &amp; slippage&lt;/li&gt;&lt;li&gt;Validate with backtesting on unseen data — RL overfits to the training period easily&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="1480.0" width="620.0" height="85.0" as="geometry" />
        </mxCell>
