        <mxCell id="classification-486" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Threshold&lt;/th&gt;&lt;th&gt;Precision&lt;/th&gt;&lt;th&gt;Recall&lt;/th&gt;&lt;th&gt;F1&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.20&lt;/td&gt;&lt;td&gt;0.48&lt;/td&gt;&lt;td&gt;0.92&lt;/td&gt;&lt;td&gt;0.63&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.50&lt;/td&gt;&lt;td&gt;0.64&lt;/td&gt;&lt;td&gt;0.65&lt;/td&gt;&lt;td&gt;0.64&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;0.55&lt;/td&gt;&lt;td&gt;0.70&lt;/td&gt;&lt;td&gt;0.62&lt;/td&gt;&lt;td&gt;0.66&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0.80&lt;/td&gt;&lt;td&gt;0.91&lt;/td&gt;&lt;td&gt;0.28&lt;/td&gt;&lt;td&gt;0.43&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2000.0" y="2180.0" width="360.0" height="100.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-487" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How strong should the regularization be?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ C = 10^-0.5: lowest validation log loss; a weaker penalty lets the 12 noise features overfit, a stronger one underfits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="2268.0" width="500.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-488" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1644.2" y="2268.0" as="sourcePoint" />
            <mxPoint x="1644.2" y="1986.3" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="classification-489" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which probability cut-off should trigger a trade?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ t = 0.55 maximises F1 (0.66); with real costs choose the t that minimises c_FP·FP + c_FN·FN&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2000.0" y="2288.0" width="380.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-490" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2340.0" y="2288.0" as="sourcePoint" />
            <mxPoint x="2340.0" y="2252.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="classification-491" value="&lt;b&gt;How to choose:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Tune &lt;b&gt;C&lt;/b&gt; (and penalty L1 / L2) with K-fold CV on a log grid; L1 drives noise-feature weights exactly to 0&lt;/li&gt;&lt;li&gt;Tune the &lt;b&gt;threshold&lt;/b&gt; after C, on validation data: max F1, a target recall / precision, or minimum expected cost&lt;/li&gt;&lt;li&gt;&lt;b&gt;Class imbalance&lt;/b&gt;: accuracy is misleading → use class_weight='balanced', PR-AUC / F1, stratified folds, or resampling (SMOTE)&lt;/li&gt;&lt;li&gt;Time series: tune with walk-forward splits; the base rate of 'Up' days drifts, so re-check the threshold periodically&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="2380.0" width="920.0" height="105.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
