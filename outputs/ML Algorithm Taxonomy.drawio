          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-411" value="bagging, B = 60 deep trees" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="1076.0" width="160.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-412" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#009900;strokeWidth=2;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1520.0" y="1085.0" as="sourcePoint" />
            <mxPoint x="1545.0" y="1085.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-413" value="true function" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1550.0" y="1076.0" width="160.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-414" value="Error vs true function (MSE):  one tree = &lt;b&gt;0.249&lt;/b&gt;  →  &lt;span style=&quot;background:#FFFF00&quot;&gt;bagging = &lt;b&gt;0.104&lt;/b&gt;&lt;/span&gt;  (58% lower)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1405.0" width="600.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-415" value="&lt;b&gt;Demo:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;A fully grown 1-D regression tree is a step function through every training point (high variance)&lt;/li&gt;&lt;li&gt;Averaging trees grown on bootstrap samples smooths the steps → closer to the true curve&lt;/li&gt;&lt;li&gt;Real computation: 30 noisy points of 1.2·sin(0.8x), noise σ = 0.45&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1445.0" width="600.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-416" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does averaging really beat a single deep tree?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: MSE 0.249 → 0.104 (58 % lower) — the blue average follows the true curve, the red tree chases noise&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1560.0" width="600.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-417" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1400.0" y="1560.0" as="sourcePoint" />
            <mxPoint x="1400.0" y="1338.9" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-418" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Works with any unstable model (trees, kNN with small k, neural nets);  little gain for stable models (linear regression)&lt;/li&gt;&lt;li&gt;Embarrassingly parallel: &lt;font face='Courier New'&gt;n_jobs=-1&lt;/font&gt; trains all trees at once&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1560.0" width="640.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-419" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What final answer does the ensemble give?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the majority of the trees' votes: 3 of 4 say A → A; for regression the trees' predictions are averaged&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1645.0" width="640.0" height="54.0" as="geometry" />
