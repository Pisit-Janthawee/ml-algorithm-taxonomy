        <mxCell id="deeplearning-743" value="c̃: candidate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF8000;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
