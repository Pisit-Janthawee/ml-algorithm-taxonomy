        <mxCell id="association-258" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#FF0000;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1401.5" y="2650.0" as="sourcePoint" />
            <mxPoint x="1401.5" y="2365.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="association-259" value="chosen 0.6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1341.5" y="2348.0" width="120.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="association-260" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Confidence alone favours rules whose consequent is simply popular&lt;/li&gt;&lt;li&gt;Always add a &lt;b&gt;lift&lt;/b&gt; (or leverage / conviction) filter: lift &amp;gt; 1 = positive association&lt;/li&gt;&lt;li&gt;Too high confidence keeps only near-certain, often trivial rules&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1120.0" y="2680.0" width="600.0" height="66.0" as="geometry" />
        </mxCell>
        <mxCell id="association-261" value="(c) Final rules: support ≥ 0.08, conf ≥ 0.6, lift &amp;gt; 1.2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2304.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="association-262" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;rule&lt;/th&gt;&lt;th&gt;supp&lt;/th&gt;&lt;th&gt;conf&lt;/th&gt;&lt;th&gt;lift&lt;/th&gt;&lt;th&gt;contains a planted pair?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Chips, Diaper} → {Beer}&lt;/td&gt;&lt;td&gt;0.13&lt;/td&gt;&lt;td&gt;0.98&lt;/td&gt;&lt;td&gt;3.15&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Chips, Milk} → {Beer}&lt;/td&gt;&lt;td&gt;0.12&lt;/td&gt;&lt;td&gt;0.81&lt;/td&gt;&lt;td&gt;2.63&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Beer, Bread} → {Chips}&lt;/td&gt;&lt;td&gt;0.15&lt;/td&gt;&lt;td&gt;0.85&lt;/td&gt;&lt;td&gt;2.59&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Beer, Milk} → {Chips}&lt;/td&gt;&lt;td&gt;0.12&lt;/td&gt;&lt;td&gt;0.83&lt;/td&gt;&lt;td&gt;2.55&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Bread, Chips} → {Beer}&lt;/td&gt;&lt;td&gt;0.15&lt;/td&gt;&lt;td&gt;0.76&lt;/td&gt;&lt;td&gt;2.45&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Bread, Diaper} → {Beer}&lt;/td&gt;&lt;td&gt;0.09&lt;/td&gt;&lt;td&gt;0.76&lt;/td&gt;&lt;td&gt;2.44&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Chips} → {Beer}&lt;/td&gt;&lt;td&gt;0.25&lt;/td&gt;&lt;td&gt;0.76&lt;/td&gt;&lt;td&gt;2.44&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;{Beer} → {Chips}&lt;/td&gt;&lt;td&gt;0.25&lt;/td&gt;&lt;td&gt;0.80&lt;/td&gt;&lt;td&gt;2.44&lt;/td&gt;&lt;td&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2332.0" width="590.0" height="193.0" as="geometry" />
        </mxCell>
        <mxCell id="association-263" value="&lt;b&gt;Business check:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Check the survivors with the business: actionable? (shelf placement, bundles, cross-sell)&lt;/li&gt;&lt;li&gt;Validate on a later period: good rules keep their lift over time&lt;/li&gt;&lt;li&gt;max_len (itemset size) limits long, hard-to-use rules&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2539.0" width="590.0" height="85.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
