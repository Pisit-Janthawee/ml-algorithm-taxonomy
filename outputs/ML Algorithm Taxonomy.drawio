        <mxCell id="dimred-268" value="projection of a point onto PC1 (dashed ⟂)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
