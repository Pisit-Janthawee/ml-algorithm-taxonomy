        </mxCell>
        <mxCell id="datanature-636" value="$$r_{pb} = \frac{\bar{y}_1-\bar{y}_0}{s_y}\sqrt{pq}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
