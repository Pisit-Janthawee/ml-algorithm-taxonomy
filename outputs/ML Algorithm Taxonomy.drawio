        <mxCell id="timeseries-387" value="MA(1), θ = 0.7: shock affects only 1 step ahead (short memory)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF8000;" vertex="1" parent="1">
          <mxGeometry x="460.0" y="1280.0" width="520.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-388" value="ARMA(p, q) — both together" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1315.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-389" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;$$y_t = c + \sum_{i=1}^{p}\varphi_i y_{t-i} + \varepsilon_t + \sum_{j=1}^{q}\theta_j\varepsilon_{t-j}$$&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1340.0" width="600.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-390" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(\varphi_i\) = AR coefficients, \(\theta_j\) = MA coefficients, \(\varepsilon_t \sim N(0,\sigma^2)\) white noise&lt;/li&gt;&lt;li&gt;AR = long memory that fades; MA = shocks that last exactly q steps&lt;/li&gt;&lt;li&gt;ARMA uses fewer parameters than a long pure AR or MA model&lt;/li&gt;&lt;li&gt;Extensions: &lt;b&gt;ARIMA&lt;/b&gt; (+ differencing), &lt;b&gt;SARIMA&lt;/b&gt; (+ seasonality), &lt;b&gt;VAR&lt;/b&gt; (many series), GARCH (volatility)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1415.0" width="380.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-391" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is the series driven by its past values or by past shocks?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ AR terms = memory of past values (fades slowly); MA terms = past surprises lasting q steps; ARMA mixes both&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810.0" y="1412.0" width="215.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-392" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920.0" y="1412.0" as="sourcePoint" />
            <mxPoint x="920.0" y="1390.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="timeseries-393" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="920.0" width="620.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-394" value="⑤ Fitting &amp;amp; Diagnostics" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="930.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-395" value="Background: least squares / maximum likelihood" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="956.0" width="592.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-396" value="AR(1) is just linear regression of yₜ on yₜ₋₁:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="980.0" width="580.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-397" value="$$\hat{\varphi} = \frac{\sum_t (y_t-\bar{y})(y_{t-1}-\bar{y})}{\sum_t (y_{t-1}-\bar{y})^2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1005.0" width="580.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-398" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;\(\hat{\varphi} = 0.779\)&lt;/span&gt;  (true φ = 0.8, n = 200)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1065.0" width="580.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-399" value="General ARMA: maximize the likelihood (MLE) numerically; choose p, q by lowest AIC / BIC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1100.0" width="580.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-400" value="$$AIC = 2k - 2\ln(\hat{L})$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="1125.0" width="580.0" height="32.0" as="geometry" />
