        <mxCell id="ensemble-451" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Bagging&lt;/th&gt;&lt;th&gt;Random Forest&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Rows&lt;/td&gt;&lt;td&gt;bootstrap sample&lt;/td&gt;&lt;td&gt;bootstrap sample&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Features per split&lt;/td&gt;&lt;td&gt;all p&lt;/td&gt;&lt;td&gt;random subset m ≈ √p&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tree correlation ρ&lt;/td&gt;&lt;td&gt;higher&lt;/td&gt;&lt;td&gt;lower → more variance cut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Base model&lt;/td&gt;&lt;td&gt;any model&lt;/td&gt;&lt;td&gt;decision trees&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1790.0" y="1320.0" width="580.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-452" value="&lt;b&gt;Summary:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Hyperparameters:&lt;/b&gt; n_estimators (B), max_samples, max_features, bootstrap, oob_score&lt;/li&gt;&lt;li&gt;&lt;b&gt;Pros:&lt;/b&gt; reduces variance, robust to noise, parallel, OOB estimate for free&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cons:&lt;/b&gt; does not reduce bias, B models → more memory &amp; slower prediction, less interpretable&lt;/li&gt;&lt;li&gt;&lt;b&gt;Family:&lt;/b&gt; Bagging → Random Forest → Extra Trees (random thresholds too)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="1460.0" width="600.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-453" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How many trees are enough?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ until the curve flattens: error drops from 0.312 (1 tree) to ≈ 0.104; extra trees never overfit, they only cost time&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
