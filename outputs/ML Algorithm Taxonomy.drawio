        <mxCell id="rl-133" value="[ … ] = TD error = (TD target) − (old estimate)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="418.0" width="600.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-134" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:13px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;state \ action&lt;/th&gt;&lt;th&gt;Buy&lt;/th&gt;&lt;th&gt;Hold&lt;/th&gt;&lt;th&gt;Sell&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Uptrend&lt;/td&gt;&lt;td&gt;&lt;b&gt;4.00 → 4.16&lt;/b&gt;&lt;/td&gt;&lt;td&gt;1.20&lt;/td&gt;&lt;td&gt;−2.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sideways&lt;/td&gt;&lt;td&gt;0.30&lt;/td&gt;&lt;td&gt;0.80&lt;/td&gt;&lt;td&gt;0.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Downtrend&lt;/td&gt;&lt;td&gt;−1.80&lt;/td&gt;&lt;td&gt;0.40&lt;/td&gt;&lt;td&gt;3.60&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="445.0" width="540.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-135" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which action is best in an Uptrend?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Buy: the highest Q in the row (4.16 after the update) = best guess of future PnL from here&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2195.0" y="435.0" width="190.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-136" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2195.0" y="476.0" as="sourcePoint" />
            <mxPoint x="2178.0" y="507.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rl-137" value="Worked update:  s = Uptrend, a = Buy,  r = +2,  s&amp;#x27; = Uptrend,  α = 0.1,  γ = 0.9" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="578.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-138" value="$$\max_{a'}Q(\text{Uptrend},a') = 4.00$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="602.0" width="600.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-139" value="$$Q \leftarrow 4.00 + 0.1\,[\,2 + 0.9(4.00) - 4.00\,] = 4.00 + 0.1(1.60) = 4.16$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1770.0" y="635.0" width="600.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-140" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Rows = states, columns = actions; start with all zeros&lt;/li&gt;&lt;li&gt;Policy = take the column with the highest value in the current row (greedy)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Off-policy&lt;/b&gt;: target uses the best next action even if the agent explored&lt;/li&gt;&lt;li&gt;SARSA uses the action actually taken instead of max (on-policy)&lt;/li&gt;&lt;li&gt;Too many states for a table → approximate Q with a neural network = &lt;b&gt;DQN&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="690.0" width="620.0" height="125.0" as="geometry" />
        </mxCell>
