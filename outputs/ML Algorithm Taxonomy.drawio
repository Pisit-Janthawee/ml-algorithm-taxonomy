            <mxPoint x="1180.0" y="4030.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-1078" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;point&lt;/th&gt;&lt;th&gt;LOF&lt;/th&gt;&lt;th&gt;rank LOF&lt;/th&gt;&lt;th&gt;rank IF&lt;/th&gt;&lt;th&gt;rank global Z&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;local (3.0, 4.7)&lt;/td&gt;&lt;td&gt;2.44&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;32&lt;/td&gt;&lt;td&gt;90&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blob A centre point&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;td&gt;125&lt;/td&gt;&lt;td&gt;126&lt;/td&gt;&lt;td&gt;95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blob B (sparse) centre point&lt;/td&gt;&lt;td&gt;0.96&lt;/td&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;90&lt;/td&gt;&lt;td&gt;83&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;global (9.5, 9.6)&lt;/td&gt;&lt;td&gt;2.51&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="4085.0" width="500.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1079" value="&lt;b&gt;Why LOF catches it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;The local point is only ~1.7 units from blob A — globally unremarkable&lt;/li&gt;&lt;li&gt;But blob A is very dense (σ = 0.45), so relative to its neighbours it is very sparse&lt;/li&gt;&lt;li&gt;Points in the sparse blob B get LOF ≈ 1: sparse but &lt;i&gt;as sparse as their neighbours&lt;/i&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="4225.0" width="500.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1080" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is this point odd compared with its own neighbourhood?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: LOF = 2.44 ranks it #9 for LOF but only #32 for Isolation Forest and #90 for a global Z rule&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="4330.0" width="300.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-1081" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="568.0" y="4330.0" as="sourcePoint" />
            <mxPoint x="568.0" y="4116.8" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-1082" value="&lt;b&gt;Settings:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;k (n_neighbors) ≈ 10–50: small k = very local, large k = smoother&lt;/li&gt;&lt;li&gt;O(n²) distances → slow for big data; scale features first&lt;/li&gt;&lt;li&gt;novelty=True in sklearn to score new points&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
