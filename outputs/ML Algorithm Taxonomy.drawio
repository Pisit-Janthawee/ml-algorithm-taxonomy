        <mxCell id="hypotests-616" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Check&lt;/th&gt;&lt;th&gt;H₀&lt;/th&gt;&lt;th&gt;If p &lt; 0.05&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Shapiro-Wilk&lt;/td&gt;&lt;td&gt;data are normal&lt;/td&gt;&lt;td&gt;use non-parametric test / transform&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Levene / Bartlett&lt;/td&gt;&lt;td&gt;equal variances&lt;/td&gt;&lt;td&gt;Welch t / Welch ANOVA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Durbin-Watson / Ljung-Box&lt;/td&gt;&lt;td&gt;no autocorrelation&lt;/td&gt;&lt;td&gt;time-series methods (see TS tests page)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2185.0" width="600.0" height="100.0" as="geometry" />
        </mxCell>
        <mxCell id="hypotests-617" value="Large n: tests flag tiny deviations → always look at the Q-Q plot too" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
