          <mxGeometry x="1540.0" y="1640.0" width="860.0" height="720.0" as="geometry" />
        </mxCell>
        <mxCell id="tstests-437" value="⑥ Error Correction Model (ECM)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
