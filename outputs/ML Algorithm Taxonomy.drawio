        </mxCell>
        <mxCell id="problems-449" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is 0.5 the right cut-off for a rare class?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ No: at 0.5 recall is 41%; the best-F1 cut-off t = 0.31 gives recall 65%, precision 80%&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1850.0" y="820.0" width="290.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-450" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2140.0" y="820.0" as="sourcePoint" />
            <mxPoint x="2293.5" y="715.7" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="problems-451" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Remedy&lt;/th&gt;&lt;th&gt;Use when&lt;/th&gt;&lt;th&gt;Watch out&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Class weights&lt;/td&gt;&lt;td&gt;first choice; most models support it&lt;/td&gt;&lt;td&gt;probabilities need recalibration&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Under-sampling&lt;/td&gt;&lt;td&gt;huge majority, fast training&lt;/td&gt;&lt;td&gt;throws data away&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Over-sampling / SMOTE&lt;/td&gt;&lt;td&gt;few minority rows, kNN / linear models&lt;/td&gt;&lt;td&gt;overfits copies; SMOTE blurs boundaries&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Threshold moving&lt;/td&gt;&lt;td&gt;always, at decision time&lt;/td&gt;&lt;td&gt;choose t on validation data&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1400.0" y="890.0" width="640.0" height="95.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-452" value="&lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;⚠ Resample only inside the training fold.&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Never resample before the split or the validation set gets synthetic copies → optimistic scores. Evaluate with recall, F1, PR-AUC on the real class ratio." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FF0000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
