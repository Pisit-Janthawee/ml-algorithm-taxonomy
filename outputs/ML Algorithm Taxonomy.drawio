          <mxGeometry x="715.0" y="4856.5" width="110.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-734" value="&lt;b&gt;Reading:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Gradient is multiplied by the same factor at every step back in time&lt;/li&gt;&lt;li&gt;Factor &lt; 1 → early inputs get ~0 gradient → RNN can't learn long dependencies&lt;/li&gt;&lt;li&gt;Factor &gt; 1 → exploding gradients → fix with &lt;b&gt;gradient clipping&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Fix for vanishing: &lt;b&gt;gated&lt;/b&gt; cells with an additive memory path (LSTM, GRU)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="5110.0" width="460.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-735" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="930.0" y="4790.0" width="440.0" height="270.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-736" value="LSTM cell" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;" vertex="1" parent="1">
