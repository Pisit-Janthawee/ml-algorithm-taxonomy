        </mxCell>
        <mxCell id="ensemble-515" value="&lt;b&gt;Training accuracy&lt;/b&gt; (bagged): 6/8&lt;br&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;OOB accuracy: 2/6&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color='#555555'&gt;underlined = OOB prediction (tree did not see that day)&lt;/font&gt;&lt;br&gt;&lt;br&gt;OOB accuracy is an honest estimate — like a free validation set — because each row is judged only by trees trained without it.&lt;br&gt;&lt;br&gt;&lt;font color='#FF0000'&gt;&lt;b&gt;Gap 6/8 vs 2/6&lt;/b&gt;: 8 rows are far too few — the training score is optimistic, OOB exposes it.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="2230.0" width="300.0" height="230.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-516" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Can I trust the 6/8 training accuracy?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ no: those rows were seen in training; the OOB vote (2/6) judges each row only with trees that never saw it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="2380.0" width="300.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-517" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160.0" y="2380.0" as="sourcePoint" />
            <mxPoint x="1160.0" y="2260.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-518" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Single stumps disagree (different bootstrap samples → different rules); the &lt;b&gt;vote&lt;/b&gt; is more stable than any one tree&lt;/li&gt;&lt;li&gt;Regression bagging averages the trees' numeric predictions instead of voting&lt;/li&gt;&lt;li&gt;Real bagging uses deep trees (high variance) and 100+ estimators; stumps are used here only to keep each rule readable&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2490.0" width="960.0" height="66.0" as="geometry" />
