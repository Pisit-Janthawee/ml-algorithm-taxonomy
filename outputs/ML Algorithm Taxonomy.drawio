        <mxCell id="datanature-704" value="order matters!" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
