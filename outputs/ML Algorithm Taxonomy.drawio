        <mxCell id="timeseries-689" value="PACF(k) = correlation at lag k after removing the effect of lags 1…k−1 (last coefficient of an AR(k) fit)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
