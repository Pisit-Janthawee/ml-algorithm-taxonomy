        </mxCell>
        <mxCell id="evaluation-327" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Metric&lt;/th&gt;&lt;th&gt;Formula&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;th&gt;Question it answers&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Accuracy&lt;/td&gt;&lt;td&gt;\(\frac{TP+TN}{N}\)&lt;/td&gt;&lt;td&gt;0.850&lt;/td&gt;&lt;td&gt;how often correct overall?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Precision&lt;/td&gt;&lt;td&gt;\(\frac{TP}{TP+FP}\)&lt;/td&gt;&lt;td&gt;0.800&lt;/td&gt;&lt;td&gt;when I say 'up', am I right?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Recall (TPR)&lt;/td&gt;&lt;td&gt;\(\frac{TP}{TP+FN}\)&lt;/td&gt;&lt;td&gt;0.667&lt;/td&gt;&lt;td&gt;how many real 'ups' did I catch?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Specificity&lt;/td&gt;&lt;td&gt;\(\frac{TN}{TN+FP}\)&lt;/td&gt;&lt;td&gt;0.929&lt;/td&gt;&lt;td&gt;how many 'downs' did I reject?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;F1&lt;/td&gt;&lt;td&gt;\(\frac{2PR}{P+R}\)&lt;/td&gt;&lt;td&gt;0.727&lt;/td&gt;&lt;td&gt;balance of precision &amp; recall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MCC&lt;/td&gt;&lt;td&gt;\(\frac{TP\,TN-FP\,FN}{\sqrt{\cdots}}\)&lt;/td&gt;&lt;td&gt;0.630&lt;/td&gt;&lt;td&gt;correlation, robust to imbalance&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1720.0" y="1010.0" width="650.0" height="240.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-328" value="Accuracy paradox (imbalanced data: 1 000 days, 20 crashes)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1370.0" y="1320.0" width="700.0" height="22.0" as="geometry" />
