        </mxCell>
        <mxCell id="optimization-259" value="Plain GD (zig-zag)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FF8000;" vertex="1" parent="1">
