        <mxCell id="datanature-198" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Nominal&lt;/th&gt;&lt;th&gt;Ordinal&lt;/th&gt;&lt;th&gt;Interval&lt;/th&gt;&lt;th&gt;Ratio&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Categories  =, ≠&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Order  &lt;, &gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Differences  +, −&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ratios  ×, ÷  ('twice as much')&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#FF0000&quot;&gt;✘&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#009900&quot;&gt;✔&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Central tendency&lt;/td&gt;&lt;td&gt;Mode&lt;/td&gt;&lt;td&gt;Median (+ mode)&lt;/td&gt;&lt;td&gt;Mean (+ median)&lt;/td&gt;&lt;td&gt;Mean, geometric mean&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Dispersion&lt;/td&gt;&lt;td&gt;# categories, entropy&lt;/td&gt;&lt;td&gt;Range, IQR&lt;/td&gt;&lt;td&gt;Std. dev. σ&lt;/td&gt;&lt;td&gt;σ, coefficient of variation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Typical encoding / prep&lt;/td&gt;&lt;td&gt;One-hot, target enc.&lt;/td&gt;&lt;td&gt;Ordinal (0,1,2…)&lt;/td&gt;&lt;td&gt;Standardize&lt;/td&gt;&lt;td&gt;Standardize, log&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1230.0" width="940.0" height="215.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-199" value="&lt;b&gt;Why it matters:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;20 °C is &lt;i&gt;not&lt;/i&gt; 'twice as hot' as 10 °C (interval, zero is arbitrary) — but $20 &lt;i&gt;is&lt;/i&gt; twice $10 (ratio)&lt;/li&gt;&lt;li&gt;The scale decides which statistics, tests and encodings are valid (see the Hypothesis-Tests page)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
