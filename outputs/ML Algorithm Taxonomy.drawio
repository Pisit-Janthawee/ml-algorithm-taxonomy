        <mxCell id="evaluation-329" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;Accuracy&lt;/th&gt;&lt;th&gt;Recall (crash)&lt;/th&gt;&lt;th&gt;Precision&lt;/th&gt;&lt;th&gt;F1&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;'Never crash' (always 0)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;98.0 %&lt;/span&gt;&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;0.00&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Real model (TP 15, FP 45, FN 5)&lt;/td&gt;&lt;td&gt;95.0 %&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.25&lt;/td&gt;&lt;td&gt;0.38&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1370.0" y="1350.0" width="600.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-330" value="&lt;b&gt;Lesson:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;High accuracy can be worthless on rare events&lt;/li&gt;&lt;li&gt;Use precision / recall / F1, PR-AUC or MCC instead&lt;/li&gt;&lt;li&gt;Choose the threshold by the cost of FP vs FN (panel ⑤)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1990.0" y="1346.0" width="390.0" height="85.0" as="geometry" />
