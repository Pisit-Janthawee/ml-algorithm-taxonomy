        <mxCell id="deeplearning-661" value="keeps the strongest response, halves size, adds small shift-invariance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="4496.0" width="300.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-662" value="Why convolution? Parameter sharing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="800.0" y="4334.0" width="560.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-663" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Layer: 28×28×1 → 26×26×8&lt;/th&gt;&lt;th&gt;Weights&lt;/th&gt;&lt;th&gt;Idea&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fully connected (MLP)&lt;/td&gt;&lt;td&gt;4,245,280&lt;/td&gt;&lt;td&gt;every pixel → every neuron&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Convolution 3×3, 8 filters&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;80&lt;/span&gt;&lt;/td&gt;&lt;td&gt;9 weights + 1 bias per filter, reused&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="800.0" y="4360.0" width="560.0" height="90.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-664" value="$$\text{params}_{conv} = (k \cdot k \cdot C_{in} + 1)\cdot C_{out} = (3\cdot3\cdot1+1)\cdot 8 = 80$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="800.0" y="4460.0" width="560.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-665" value="&lt;b&gt;Effects:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;≈ 53,066× fewer weights → less overfitting, works on big images&lt;/li&gt;&lt;li&gt;Local connectivity: each neuron sees only a small patch (receptive field), which grows with depth&lt;/li&gt;&lt;li&gt;Translation equivariance: the same pattern is detected anywhere in the input&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="800.0" y="4510.0" width="580.0" height="85.0" as="geometry" />
        </mxCell>
