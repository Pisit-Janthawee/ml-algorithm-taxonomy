        <mxCell id="nlp-156" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Shape = (number of documents × vocabulary size) = 3 × 6&lt;/li&gt;&lt;li&gt;&lt;b&gt;Binary BoW&lt;/b&gt;: 1 if the word appears, else 0 (good for short texts)&lt;/li&gt;&lt;li&gt;These vectors can feed any classifier — e.g. Multinomial Naive Bayes, Logistic Regression&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="760.0" width="340.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-157" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How is one document turned into numbers?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ D1 = [1, 0, 0, 0, 1, 1]: one count per vocabulary word; the whole corpus is a 3 × 6 matrix&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
