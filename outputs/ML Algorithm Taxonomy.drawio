            <mxPoint x="9.0" y="187.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="evaluation-11" value="K-Fold Cross-Validation&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:9px&quot;&gt;Every row is tested once&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="12.0" y="210.0" width="320.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-12" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4.0" y="219.0" as="sourcePoint" />
            <mxPoint x="9.0" y="219.0" as="targetPoint" />
