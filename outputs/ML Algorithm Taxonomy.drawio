        <mxCell id="distributions-305" value="$$\mu = \frac{\sum_{i=1}^{N} x_i}{N}\ \text{(population)}\qquad \bar{x} = \frac{\sum_{i=1}^{n} x_i}{n}\ \text{(sample)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="320.0" width="480.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-306" value="$$\bar{x} = \frac{2+3+3+5+7+8+9}{7} = \frac{37}{7} = 5.29$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="372.0" width="480.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-307" value="Median (middle value of the SORTED data)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="420.0" width="480.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-308" value="$$n\ \text{odd: } M = x_{\left(\frac{n+1}{2}\right)}\qquad n\ \text{even: } M = \frac{x_{(n/2)} + x_{(n/2+1)}}{2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="440.0" width="480.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-309" value="odd n=7 → 4th value = 5   ·   add 10 (n=8) → (5 + 7)/2 = 6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1900.0" y="492.0" width="480.0" height="18.0" as="geometry" />
        </mxCell>
