        <mxCell id="clustering-288" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How far is this point from the cluster centre?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ d = 5 units; the centroid with the smallest d decides the point's cluster&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2150.0" y="330.0" width="235.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-289" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150.0" y="412.0" as="sourcePoint" />
            <mxPoint x="1955.0" y="470.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-290" value="$$d(x,\mu) = \sqrt{\sum_{j=1}^{p}(x_j-\mu_j)^2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1790.0" y="618.0" width="580.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-291" value="$$= \sqrt{3^2 + 4^2} = 5$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1790.0" y="680.0" width="580.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-292" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Manhattan: \(\sum|x_j-\mu_j|\) = 3 + 4 = 7 (city-block)&lt;/li&gt;&lt;li&gt;Distances depend on units → &lt;b&gt;scale features first&lt;/b&gt; (standardize)&lt;/li&gt;&lt;li&gt;K-Means uses squared distance \(\lVert x-\mu\rVert^2\) (no square root needed)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="715.0" width="600.0" height="85.0" as="geometry" />
