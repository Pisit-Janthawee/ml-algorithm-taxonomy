        <mxCell id="labelling-442" value="test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2228.0" y="1983.0" width="70.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-443" value="train (past)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="2029.0" width="360.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-444" value="test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2288.0" y="2029.0" width="70.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-445" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1920.0" y="2090.0" as="sourcePoint" />
            <mxPoint x="2380.0" y="2090.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-446" value="time →" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="2320.0" y="2092.0" width="60.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-447" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Train only on the past, test on the next block, then roll forward&lt;/li&gt;&lt;li&gt;Closest to live trading; rolling (fixed-length) window adapts to regime change&lt;/li&gt;&lt;li&gt;Single path → noisier estimate than purged K-fold; use both&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="2120.0" width="460.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-448" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is this feature row safe to train on?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ features use data up to t only; the label uses t+1…t+3 → never feed label columns as inputs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860.0" y="585.0" width="170.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-449" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860.0" y="585.0" as="sourcePoint" />
            <mxPoint x="827.0" y="542.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-450" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which bars become training samples?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only CUSUM events (dots): 18 of 120 bars, where a real move accumulated&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1150.0" y="522.0" width="200.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-451" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1205.0" y="590.0" as="sourcePoint" />
            <mxPoint x="1205.0" y="652.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-452" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does the label reflect what my trade really did?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ not always: the path is ignored — the stop-loss can be hit first and the label still says +1 → use Triple Barrier&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1700.0" y="782.0" width="680.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-453" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2315.0" y="782.0" as="sourcePoint" />
            <mxPoint x="2315.0" y="660.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-454" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which barrier decides each event's label?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the FIRST one touched: A upper → +1, B lower → −1, C time → 0&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1075.0" y="1485.0" width="185.0" height="82.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-455" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1075.0" y="1526.0" as="sourcePoint" />
            <mxPoint x="960.0" y="1527.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-456" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which trend label does trend-scanning pick?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the window with the largest |t|: L = 20, t = −7.74 → y = −1 (strong down-trend)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1600.0" width="590.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-457" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2356.0" y="1600.0" as="sourcePoint" />
            <mxPoint x="2356.0" y="1422.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-458" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How much should each overlapping label count?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ weight = average uniqueness ūᵢ: label 3 (ū = 0.37) shares most bars → gets the least weight&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2242.0" width="780.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-459" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130.0" y="2242.0" as="sourcePoint" />
            <mxPoint x="1130.0" y="2150.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
