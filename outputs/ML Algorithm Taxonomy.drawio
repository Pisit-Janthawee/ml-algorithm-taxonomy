        <mxCell id="datanature-550" value="No relationship" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2164.0" y="990.0" width="200.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-551" value="independent" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="2164.0" y="1192.0" width="200.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-552" value="Pearson r = &lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;-0.12&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Spearman ρ = &lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;-0.16&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Mutual info = &lt;b&gt;&lt;font color=&quot;#FF0000&quot;&gt;0.19&lt;/font&gt;&lt;/b&gt; bits" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2184.0" y="1215.0" width="180.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-553" value="$$r = \frac{\sum(x_i-\bar{x})(y_i-\bar{y})}{\sqrt{\sum(x_i-\bar{x})^2\sum(y_i-\bar{y})^2}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="1290.0" width="330.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-554" value="$$\rho = 1 - \frac{6\sum d_i^2}{n(n^2-1)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1290.0" width="250.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-555" value="$$I(X;Y) = \sum\sum p(x,y)\log_2\frac{p(x,y)}{p(x)p(y)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2050.0" y="1290.0" width="340.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-556" value="linear only" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="1345.0" width="330.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-557" value="dᵢ = rank difference → any monotonic" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="1345.0" width="250.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-558" value="any dependence (incl. non-monotonic)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="2050.0" y="1345.0" width="340.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-559" value="&lt;b&gt;Interpretation:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Monotonic&lt;/b&gt;: as x increases, y never changes direction (always ↑ or always ↓) — Spearman ρ / Kendall τ capture it&lt;/li&gt;&lt;li&gt;&lt;b&gt;Non-monotonic&lt;/b&gt;: direction changes (U-shape, cycles) — r ≈ 0 and ρ ≈ 0 even though y depends strongly on x!&lt;/li&gt;&lt;li&gt;Pearson r = 0 means &lt;i&gt;no linear&lt;/i&gt; relation, &lt;b&gt;not&lt;/b&gt; no relation → always plot the data, use MI or tree models&lt;/li&gt;&lt;li&gt;Linear models need linear (or transformed) relations; trees / kNN / neural nets handle non-monotonic ones&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="1375.0" width="920.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-560" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is there ANY relationship even when r ≈ 0?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: the U-shape has r = +0.00 but MI = 1.33 bits → strong non-linear dependence&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
