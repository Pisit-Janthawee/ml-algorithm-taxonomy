        <mxCell id="versatile-2931" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF0000;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
