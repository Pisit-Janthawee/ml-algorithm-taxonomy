            <mxPoint x="687.1" y="1960.3" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="clustering-551" value="chord: first → last point" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800.0" y="1890.0" width="150.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-552" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
