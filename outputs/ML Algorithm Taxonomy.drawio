          </mxGeometry>
        </mxCell>
        <mxCell id="rl-122" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Arrow = best action \(\pi(s)=\arg\max_a Q(s,a)\);  V = value of the state = \(\max_a Q(s,a)\)&lt;/li&gt;&lt;li&gt;Values grow as cells get closer to the goal; cells next to the trap learn to avoid it&lt;/li&gt;&lt;li&gt;Values computed with the Bellman equation (value iteration) — Q-Learning learns the same by trial &amp; error&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="730.0" width="580.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-123" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1740.0" y="240.0" width="660.0" height="640.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-124" value="③ Q-Table &amp;amp; the Bellman Update" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
