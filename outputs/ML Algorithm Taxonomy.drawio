        <mxCell id="rl-300" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;state (trend, position)&lt;/th&gt;&lt;th&gt;Q(Buy)&lt;/th&gt;&lt;th&gt;Q(Hold)&lt;/th&gt;&lt;th&gt;Q(Sell)&lt;/th&gt;&lt;th&gt;greedy action&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(down, flat)&lt;/td&gt;&lt;td&gt;+0.71&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.95&lt;/b&gt;&lt;/td&gt;&lt;td&gt;+0.81&lt;/td&gt;&lt;td&gt;Hold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(down, long)&lt;/td&gt;&lt;td&gt;+0.78&lt;/td&gt;&lt;td&gt;+0.80&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.84&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Sell&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(up, flat)&lt;/td&gt;&lt;td&gt;&lt;b&gt;+1.94&lt;/b&gt;&lt;/td&gt;&lt;td&gt;+1.65&lt;/td&gt;&lt;td&gt;+1.71&lt;/td&gt;&lt;td&gt;Buy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.65&lt;/b&gt;&lt;/td&gt;&lt;td&gt;+2.40&lt;/td&gt;&lt;td&gt;+1.81&lt;/td&gt;&lt;td&gt;Buy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="1770.0" width="600.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-301" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What does the trained bot do in an uptrend while flat?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Buy: Q(Buy) = +1.94 is the largest in that row → highest expected future P&amp;L&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1930.0" y="1772.0" width="440.0" height="54.0" as="geometry" />
        </mxCell>
