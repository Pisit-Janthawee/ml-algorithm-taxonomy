        <mxCell id="labelling-431" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#FF0000;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1765.0" y="2085.0" width="16.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-432" value="embargo (gap after test)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1785.0" y="2082.0" width="130.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-433" value="&lt;b&gt;Rules:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Purge&lt;/b&gt;: drop training samples whose label span overlaps the test period&lt;/li&gt;&lt;li&gt;&lt;b&gt;Embargo&lt;/b&gt;: also drop a small gap (e.g. 1 % of bars) right after the test set — features with memory (moving averages) would otherwise leak&lt;/li&gt;&lt;li&gt;Use with the sample weights from the left&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1260.0" y="2120.0" width="620.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-434" value="Walk-forward (expanding window)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1920.0" y="1810.0" width="460.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-435" value="train (past)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3333FF;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
