        <mxCell id="tstests-252" value="&lt;b&gt;Practice:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Choose lag p by AIC / BIC (residuals must be white noise)&lt;/li&gt;&lt;li&gt;Include trend term only if the series visibly trends (critical value then −3.41 at 5 %)&lt;/li&gt;&lt;li&gt;Low power: near-unit-root (φ = 0.97) often not rejected → cross-check with KPSS ④&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="1430.0" width="460.0" height="85.0" as="geometry" />
        </mxCell>
