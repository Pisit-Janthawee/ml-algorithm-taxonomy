        </mxCell>
        <mxCell id="dimred-399" value="$$\text{explained}_j = \frac{\lambda_j}{\sum_{i=1}^{p}\lambda_i}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
