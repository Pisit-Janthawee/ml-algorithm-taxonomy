        <mxCell id="association-55" value="&lt;span style='background:#FFFF00'&gt;&lt;b&gt;min support = 3 transactions (60%)&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
