        <mxCell id="labelling-238" value="④ Triple Barrier Method (López de Prado) — label by the FIRST barrier touched" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
