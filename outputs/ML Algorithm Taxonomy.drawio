        <mxCell id="featureeng-365" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Scaler&lt;/th&gt;&lt;th&gt;Formula&lt;/th&gt;&lt;th&gt;Range&lt;/th&gt;&lt;th&gt;Outlier effect&lt;/th&gt;&lt;th&gt;Use when&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Standardization&lt;/td&gt;&lt;td&gt;\(\frac{x-\mu}{\sigma}\)&lt;/td&gt;&lt;td&gt;unbounded, mean 0&lt;/td&gt;&lt;td&gt;pulls μ, inflates σ&lt;/td&gt;&lt;td&gt;roughly normal features; linear models, PCA, SVM&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Min-Max&lt;/td&gt;&lt;td&gt;\(\frac{x-x_{min}}{x_{max}-x_{min}}\)&lt;/td&gt;&lt;td&gt;[0, 1]&lt;/td&gt;&lt;td&gt;very sensitive&lt;/td&gt;&lt;td&gt;bounded inputs (images, NN), no big outliers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Robust&lt;/td&gt;&lt;td&gt;\(\frac{x-\tilde{x}}{IQR}\)&lt;/td&gt;&lt;td&gt;unbounded, median 0&lt;/td&gt;&lt;td&gt;resistant&lt;/td&gt;&lt;td&gt;heavy tails / outliers (returns, volume)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Max-Abs&lt;/td&gt;&lt;td&gt;\(\frac{x}{|x|_{max}}\)&lt;/td&gt;&lt;td&gt;[−1, 1]&lt;/td&gt;&lt;td&gt;sensitive&lt;/td&gt;&lt;td&gt;sparse data (keeps zeros)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
