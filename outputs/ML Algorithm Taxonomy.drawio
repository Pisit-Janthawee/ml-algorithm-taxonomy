          </mxGeometry>
        </mxCell>
        <mxCell id="labelling-287" value="lower barrier  \(P_{t_0}(1 - sl\cdot\sigma_{t_0}\sqrt{h})\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
