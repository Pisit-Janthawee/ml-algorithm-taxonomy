        <mxCell id="timeseries-620" value="window of N = 3 past values → target (next value); the window slides one step at a time →" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;" vertex="1" parent="1">
