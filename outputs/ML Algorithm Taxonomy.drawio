        <mxCell id="dimred-1320" value="&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;— Gaussian&lt;/b&gt; (high-D)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;- - Student-t&lt;/b&gt; (low-D)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
