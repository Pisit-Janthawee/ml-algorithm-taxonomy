        <mxCell id="datanature-705" value="→ random shuffle-split CV is fine only for cross-sectional data; time series / panel need time-ordered splits" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
