            <mxPoint x="1390.0" y="4830.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-738" value="cell state c (memory highway)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1190.0" y="4806.0" width="180.0" height="18.0" as="geometry" />
