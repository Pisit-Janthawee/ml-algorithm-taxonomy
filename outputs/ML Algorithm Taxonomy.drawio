          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1930.0" y="1826.0" as="sourcePoint" />
            <mxPoint x="1912.0" y="1838.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rl-303" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Only 4 states × 3 actions → a tiny table; real systems add more features (RSI bucket, volatility…) or use DQN&lt;/li&gt;&lt;li&gt;Actions that do nothing (Buy while long, Sell while flat) behave like Hold&lt;/li&gt;&lt;li&gt;Reward is the next-bar P&amp;L, so Q(s, a) ≈ expected discounted future P&amp;L of taking a in s&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="1910.0" width="920.0" height="66.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-304" value="Episode log (last episode, 8 consecutive rows) — each row is one Q update" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2060.0" width="900.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-305" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;t&lt;/th&gt;&lt;th&gt;price&lt;/th&gt;&lt;th&gt;state s&lt;/th&gt;&lt;th&gt;action a&lt;/th&gt;&lt;th&gt;reward r&lt;/th&gt;&lt;th&gt;next s'&lt;/th&gt;&lt;th&gt;Q(s,a) before&lt;/th&gt;&lt;th&gt;TD target \(r+\gamma\max Q(s',\cdot)\)&lt;/th&gt;&lt;th&gt;Q(s,a) after&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;106.10&lt;/td&gt;&lt;td&gt;(up, flat)&lt;/td&gt;&lt;td&gt;Buy&lt;/td&gt;&lt;td&gt;+0.681&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;+1.894&lt;/td&gt;&lt;td&gt;+3.148&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.019&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;106.87&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;Hold&lt;/td&gt;&lt;td&gt;+0.911&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;+2.741&lt;/td&gt;&lt;td&gt;+3.378&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.805&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;107.85&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;Hold&lt;/td&gt;&lt;td&gt;+0.498&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;+2.805&lt;/td&gt;&lt;td&gt;+3.022&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.827&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;108.38&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;Hold&lt;/td&gt;&lt;td&gt;+0.082&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;+2.827&lt;/td&gt;&lt;td&gt;+2.626&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.806&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;108.47&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;Hold&lt;/td&gt;&lt;td&gt;-0.017&lt;/td&gt;&lt;td&gt;(up, long)&lt;/td&gt;&lt;td&gt;+2.806&lt;/td&gt;&lt;td&gt;+2.508&lt;/td&gt;&lt;td&gt;&lt;b&gt;+2.777&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&