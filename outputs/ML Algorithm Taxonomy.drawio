        <mxCell id="ensemble-1139" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;GBM (classic)&lt;/th&gt;&lt;th&gt;XGBoost&lt;/th&gt;&lt;th&gt;LightGBM&lt;/th&gt;&lt;th&gt;CatBoost&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tree growth&lt;/td&gt;&lt;td&gt;level-wise&lt;/td&gt;&lt;td&gt;level-wise (depth)&lt;/td&gt;&lt;td&gt;leaf-wise (best leaf first)&lt;/td&gt;&lt;td&gt;symmetric (oblivious)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Regularization&lt;/td&gt;&lt;td&gt;shrinkage, subsampling&lt;/td&gt;&lt;td&gt;L1 + L2 on leaf weights, γ split cost&lt;/td&gt;&lt;td&gt;L1 / L2, min data in leaf&lt;/td&gt;&lt;td&gt;ordered boosting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Speed trick&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;sparsity-aware, parallel splits&lt;/td&gt;&lt;td&gt;histogram bins + GOSS + EFB&lt;/td&gt;&lt;td&gt;GPU, symmetric trees&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Categoricals&lt;/td&gt;&lt;td&gt;encode yourself&lt;/td&gt;&lt;td&gt;encode (native in new versions)&lt;/td&gt;&lt;td&gt;native (integer codes)&lt;/td&gt;&lt;td&gt;native target statistics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Best for&lt;/td&gt;&lt;td&gt;small data, teaching&lt;/td&gt;&lt;td&gt;strong default, competitions&lt;/td&gt;&lt;td&gt;large data, speed&lt;/td&gt;&lt;td&gt;many categories&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="960.0" y="4000.0" width="730.0" height="190.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1140" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Boosting reduces &lt;b&gt;bias&lt;/b&gt;: shallow trees (depth 3–6) + many rounds + small η + early stopping on validation&lt;/li&gt;&lt;li&gt;Overfits if rounds grow without validation; noisy labels hurt boosting more than bagging&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
