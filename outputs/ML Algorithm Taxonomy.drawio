        <mxCell id="association-153" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why is {Bread, Milk, Beer} never counted?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ it contains {Bread, Beer} (sup 2 &lt; 3), so it cannot be frequent → pruned&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
