        </mxCell>
        <mxCell id="kernel-177" value="$$d = \left(\sum_j |a_j-b_j|^p\right)^{1/p}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
