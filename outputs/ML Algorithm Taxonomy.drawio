        <mxCell id="anomaly-123" value="|z| &amp;gt; 2 : unusual (4.55%)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF8000;" vertex="1" parent="1">
