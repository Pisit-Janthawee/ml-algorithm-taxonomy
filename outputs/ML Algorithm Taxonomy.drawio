        </mxCell>
        <mxCell id="timeseries-650" value="$$AR(3):\ \hat{y}_t=c+\phi_1y_{t-1}+\phi_2y_{t-2}+\phi_3y_{t-3}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2060.0" y="2125.0" width="330.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-651" value="= the linear version of the same lag window" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
