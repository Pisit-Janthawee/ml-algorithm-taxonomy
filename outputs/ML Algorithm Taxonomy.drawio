        <mxCell id="dimred-608" value="&lt;b&gt;d-D: 10&lt;sup&gt;d&lt;/sup&gt; cells&lt;/b&gt;&lt;br&gt;the same 25 points cover 25 % → 2.5 % of cells&lt;br&gt;&lt;span style=&quot;background:#FFFF00&quot;&gt;data needed grows exponentially&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
