        <mxCell id="fitting-179" value="&lt;font color=&quot;#009900&quot;&gt;&lt;b&gt;✔ Fix: &lt;/b&gt;&lt;/font&gt;add the driving feature (news sentiment, volume, macro data)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
