        <mxCell id="explain-131" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Feature&lt;/th&gt;&lt;th&gt;s₀&lt;/th&gt;&lt;th&gt;mean s_j&lt;/th&gt;&lt;th&gt;I_j = s₀ − s_j&lt;/th&gt;&lt;th&gt;± std&lt;/th&gt;&lt;th&gt;rank&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;EMA_gap&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.639&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.194&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.052&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RSI&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.759&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.075&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.015&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RSI_copy&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.766&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.067&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.017&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Volatility&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.810&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.023&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.014&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Day_of_week&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.827&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.006&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.004&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Noise&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;0.833&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.001&lt;/b&gt;&lt;/td&gt;&lt;td&gt;0.007&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
