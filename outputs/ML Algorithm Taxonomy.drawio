        <mxCell id="association-177" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Rule A → B&lt;/th&gt;&lt;th&gt;supp&lt;/th&gt;&lt;th&gt;conf&lt;/th&gt;&lt;th&gt;lift&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bread → Milk&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Milk → Bread&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bread → Diaper&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Diaper → Bread&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Milk → Diaper&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Diaper → Milk&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;0.94&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Diaper → Beer&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;1.25&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;Beer → Diaper&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;1.25&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
