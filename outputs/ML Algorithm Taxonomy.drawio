        <mxCell id="explain-13" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;★ Permutation Importance&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:9px&quot;&gt;Score drop when a feature is shuffled&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
