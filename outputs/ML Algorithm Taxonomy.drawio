        <mxCell id="association-167" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is buying diapers really linked to beer?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: lift = 1.25 &gt; 1 → beer is 1.25× more likely in diaper baskets&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1578.0" y="1032.0" width="160.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="association-168" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1578.0" y="1080.0" as="sourcePoint" />
            <mxPoint x="1450.0" y="1115.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="association-169" value="$$Support(A \cup B) = \frac{|T_{A \cup B}|}{|T|} = \frac{3}{5} = 0.6$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1180.0" y="1225.0" width="580.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="association-170" value="$$Confidence(A \to B) = \frac{Supp(A \cup B)}{Supp(A)} = \frac{0.6}{0.8} = 0.75$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1180.0" y="1280.0" width="580.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="association-171" value="$$Lift(A \to B) = \frac{Conf(A \to B)}{Supp(B)} = \frac{0.75}{0.6} = 1.25$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1180.0" y="1335.0" width="580.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="association-172" value="&lt;span style='background:#FFFF00'&gt;Diaper → Beer: 75% of diaper baskets also have beer, 1.25× more than chance&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
