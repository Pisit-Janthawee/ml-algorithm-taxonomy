            <mxPoint x="971.0" y="658.7" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-254" value="$$f(x)=\frac{1}{\sigma\sqrt{2\pi}}\,e^{-\frac{(x-\mu)^2}{2\sigma^2}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="330.0" width="300.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-255" value="$$X \sim N(\mu,\ \sigma^2)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="395.0" width="300.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-256" value="&lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;Empirical rule 68 – 95 – 99.7&lt;/b&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="440.0" width="300.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-257" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Range&lt;/th&gt;&lt;th&gt;Area&lt;/th&gt;&lt;th&gt;Outside&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;μ ± 1σ&lt;/td&gt;&lt;td&gt;68.27 %&lt;/td&gt;&lt;td&gt;31.73 %&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;μ ± 2σ&lt;/td&gt;&lt;td&gt;95.45 %&lt;/td&gt;&lt;td&gt;4.55 %&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;μ ± 3σ&lt;/td&gt;&lt;td&gt;99.73 %&lt;/td&gt;&lt;td&gt;0.27 %&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="470.0" width="280.0" height="88.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-258" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(\mu\) = mean (center / location)&lt;/li&gt;&lt;li&gt;\(\sigma\) = standard deviation (width / spread)&lt;/li&gt;&lt;li&gt;Symmetric: skewness = 0, kurtosis = 3&lt;/li&gt;&lt;li&gt;Total area under the curve = 1&lt;/li&gt;&lt;li&gt;Sums / averages of many variables → normal (&lt;b&gt;Central Limit Theorem&lt;/b&gt;)&lt;/li&gt;&lt;li&gt;Assumed by Linear Regression residuals, Z-test, GDA, Naive Bayes (Gaussian)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="585.0" width="300.0" height="200.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-259" value="Darker band = more probability mass close to μ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="460.0" y="800.0" width="560.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-260" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Bigger σ → flatter, wider bell;  smaller σ → taller, narrower bell (area stays 1)&lt;/li&gt;&lt;li&gt;Probability of an exact value is 0; probability = area over an interval&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="830.0" width="620.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-261" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Where does most of the data fall?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ 68 % within μ ± 1σ, 95 % within ±2σ, 99.7 % within ±3σ → beyond ±3σ is rare (possible outlier)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050.0" y="792.0" width="300.0" height="68.0" as="geometry" />
