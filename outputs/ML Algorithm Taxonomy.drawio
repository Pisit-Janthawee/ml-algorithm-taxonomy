        <mxCell id="distributions-397" value="$$g_1 \lt 0$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1130.0" y="1310.0" width="90.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-398" value="long tail pulls the mean" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="570.0" y="1170.0" width="130.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-399" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630.0" y="1179.0" as="sourcePoint" />
            <mxPoint x="630.0" y="1250.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-400" value="$$\text{Skewness: } g_1 = \frac{\frac{1}{n}\sum_{i=1}^{n}(x_i-\bar{x})^3}{s^3}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1355.0" width="440.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-401" value="$$\text{Pearson: } Sk = \frac{3(\text{Mean}-\text{Median})}{\sigma}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="880.0" y="1355.0" width="440.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-402" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How do I measure the skew with one number?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ g₁ (or Pearson Sk): &gt; 0 = long right tail, &lt; 0 = long left tail; |g₁| &gt; 1 is highly skewed → try a log&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="1418.0" width="300.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-403" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1100.0" y="1418.0" as="sourcePoint" />
            <mxPoint x="1100.0" y="1408.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-404" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;The &lt;b&gt;mean is pulled toward the long tail&lt;/b&gt;; the median sits between mode and mean&lt;/li&gt;&lt;li&gt;Right skew examples: income, house prices, trading volume, waiting times  →  try a &lt;b&gt;log transform&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Left skew examples: exam scores with an easy test, age at retirement&lt;/li&gt;&lt;li&gt;Rule of thumb: |g₁| &amp;lt; 0.5 ≈ symmetric,  0.5–1 moderate,  &amp;gt; 1 highly skewed&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1420.0" width="600.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-405" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1400.0" y="960.0" width="1000.0" height="620.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-406" value="④ Kurtosis: peakedness &amp;amp; tail weight" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1414.0" y="970.0" width="972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-407" value="Same mean and variance, different shape" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1414.0" y="996.0" width="972.0" height="18.0" as="geometry" />
        </mxCell>
