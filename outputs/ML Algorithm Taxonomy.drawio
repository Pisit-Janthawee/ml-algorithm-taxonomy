        </mxCell>
        <mxCell id="featureeng-486" value="$$enc(c) = \frac{n_c\,\bar{y}_c + m\,\bar{y}}{n_c + m}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
