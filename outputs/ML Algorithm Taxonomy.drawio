        <mxCell id="nlp-179" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2040.0" y="579.0" as="sourcePoint" />
            <mxPoint x="1895.0" y="611.4" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nlp-180" value="(only the &amp;#x27;cat&amp;#x27; and &amp;#x27;dog&amp;#x27; dimensions are drawn)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1810.0" y="680.0" width="320.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-181" value="$$\cos\theta = \frac{\vec{a}\cdot\vec{b}}{\lVert\vec{a}\rVert\,\lVert\vec{b}\rVert}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="360.0" width="240.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-182" value="$$\cos(D1,D3) = \frac{1}{\sqrt{3}\sqrt{3}} = 0.33$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="440.0" width="240.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-183" value="$$\cos(D1,D1) = 1$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2140.0" y="495.0" width="240.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-184" value="1 = same direction (similar)&lt;br&gt;0 = no shared words" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2150.0" y="535.0" width="230.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-185" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How similar are two documents?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ cos(D1, D3) = 0.33: they share only 'cat'; 1 = same words, 0 = nothing in common&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2145.0" y="590.0" width="235.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-186" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2145.0" y="590.0" as="sourcePoint" />
            <mxPoint x="1980.7" y="575.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nlp-187" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Each word is one axis → a 50,000-word vocabulary = a 50,000-dimensional space&lt;/li&gt;&lt;li&gt;Similar documents point in similar directions; length depends on document size, so use the angle&lt;/li&gt;&lt;li&gt;Used for search, duplicate detection, document clustering (K-Means on BoW vectors)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="710.0" width="620.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="nlp-188" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="920.0" width="640.0" height="700.0" as="geometry" />
