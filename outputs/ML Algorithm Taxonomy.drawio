        <mxCell id="hypotests-474" value="$$H = \frac{12}{N(N+1)}\sum_{j}\frac{R_j^2}{n_j} - 3(N+1)\ \sim\ \chi^2_{k-1}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
