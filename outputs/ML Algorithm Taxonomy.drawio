        <mxCell id="anomaly-395" value="best k = 2.8 → F1 = 0.83" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
          <mxGeometry x="700.0" y="2375.0" width="170.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-396" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="717.7" y="2384.0" as="sourcePoint" />
            <mxPoint x="717.7" y="2468.1" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-397" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which threshold k should I use?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ k = 2.8: max F1 = 0.83; lower k → false alarms, higher k → misses&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="2403.0" width="240.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-398" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870.0" y="2437.0" as="sourcePoint" />
            <mxPoint x="723.2" y="2468.1" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-399" value="small k → many false alarms (low precision)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="490.0" y="2745.0" width="300.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-400" value="large k → misses anomalies (low recall)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF8000;" vertex="1" parent="1">
          <mxGeometry x="850.0" y="2745.0" width="280.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-401" value="$$P=\frac{TP}{TP+FP},\ R=\frac{TP}{TP+FN},\ F_1=\frac{2PR}{P+R}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="480.0" y="2780.0" width="620.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-402" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;No labels? Choose k from the tolerated alarm rate: |z|&amp;gt;2 ≈ 4.6 %, |z|&amp;gt;3 ≈ 0.27 % of normal days (if returns were normal)&lt;/li&gt;&lt;li&gt;Fat tails (kurtosis &amp;gt; 3) → normal-based rates are too optimistic → validate on history&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2835.0" width="720.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-403" value="Grid search over (w, k): best F1 for each window" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="2370.0" width="540.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-404" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;w&lt;/th&gt;&lt;th&gt;best k&lt;/th&gt;&lt;th&gt;Precision&lt;/th&gt;&lt;th&gt;Recall&lt;/th&gt;&lt;th&gt;F1&lt;/th&gt;&lt;th&gt;Behaviour&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;4.4&lt;/td&gt;&lt;td&gt;0.78&lt;/td&gt;&lt;td&gt;0.70&lt;/td&gt;&lt;td&gt;0.74&lt;/td&gt;&lt;td&gt;σ very noisy&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;4.1&lt;/td&gt;&lt;td&gt;0.82&lt;/td&gt;&lt;td&gt;0.90&lt;/td&gt;&lt;td&gt;0.86&lt;/td&gt;&lt;td&gt;reacts fast&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;2.8&lt;/td&gt;&lt;td&gt;0.71&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;0.83&lt;/td&gt;&lt;td&gt;balanced&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;60&lt;/td&gt;&lt;td&gt;3.1&lt;/td&gt;&lt;td&gt;0.71&lt;/td&gt;&lt;td&gt;0.50&lt;/td&gt;&lt;td&gt;0.59&lt;/td&gt;&lt;td&gt;slow to adapt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;120&lt;/td&gt;&lt;td&gt;1.7&lt;/td&gt;&lt;td&gt;0.67&lt;/td&gt;&lt;td&gt;0.57&lt;/td&gt;&lt;td&gt;0.62&lt;/td&gt;&lt;td&gt;almost static&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;static&lt;/td&gt;&lt;td&gt;3.1&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;0.50&lt;/td&gt;&lt;td&gt;0.67&lt;/td&gt;&lt;td&gt;one global μ, σ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="2400.0" width="540.0" height="158.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-405" value="Static z uses one σ for all regimes → misses anomalies in calm periods and over-flags normal days in stressed periods." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="2572.0" width="540.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-406" value="&lt;b&gt;Procedure:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Grid-search (k, w) on a &lt;b&gt;validation period&lt;/b&gt;, then confirm on a later test period (walk-forward)&lt;/li&gt;&lt;li&gt;Keep the window strictly in the past; refit nothing on the test period&lt;/li&gt;&lt;li&gt;w trades &lt;b&gt;adaptivity&lt;/b&gt; (small w) against &lt;b&gt;stability of σ&lt;/b&gt; (large w)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="2620.0" width="520.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-407" value="&lt;b&gt;Contamination (expected anomaly rate)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Here: 10 / 260 = 3.8 % of days.&lt;br&gt;Many libraries (Isolation Forest, LOF, One-Class SVM) take &lt;i&gt;contamination&lt;/i&gt; instead of k: they flag the top c % most extreme scores.&lt;br&gt;&lt;br&gt;Equivalent for Z-score: choose k = the (1 − c) quantile of |z| on training data.&lt;br&gt;&lt;br&gt;Set c from domain knowledge (e.g. known fraud rate) — a wrong c directly sets precision / recall." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2370.0" width="590.0" height="200.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-408" value="Quantile rule with c = 3.8 % → &lt;span style=&quot;background:#FFFF00&quot;&gt;k ≈ 3.26&lt;/span&gt; (compare best-F1 k = 2.8)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2585.0" width="590.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-409" value="&lt;b&gt;Pitfalls:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Masking: several anomalies close together inflate σ → use median / MAD (panel ⑤)&lt;/li&gt;&lt;li&gt;Swamping: very low k marks normal neighbours as anomalies&lt;/li&gt;&lt;li&gt;Multivariate data → Mahalanobis distance or Isolation Forest&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1780.0" y="2630.0" width="590.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-410" value="Beyond Z-scores: machine-learning anomaly detectors (same 2-D data for every method)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3000.0" width="1800.0" height="35.2" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-411" value="Data: dense blob A (60 pts), sparse blob B (60 pts), 7 global anomalies on the edges + 1 LOCAL anomaly just above blob A. Everything below is computed in pure Python (seeded)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3034.0" width="2000.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-412" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="3070.0" width="760.0" height="720.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-413" value="⑨ Families of anomaly detectors &amp;amp; types of anomalies" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="3080.0" width="732.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-414" value="Anomaly detection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="680.0" y="3280.0" width="200.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-415" value="&lt;b&gt;Statistical&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Z, IQR, MAD (①–⑧)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="450.0" y="3155.0" width="170.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-416" value="" style="endArrow=none;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="anomaly-414" target="anomaly-415">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-417" value="&lt;b&gt;Distance&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;kNN distance&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="700.0" y="3145.0" width="170.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-418" value="" style="endArrow=none;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="anomaly-414" target="anomaly-417">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-419" value="&lt;b&gt;Density&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;LOF, KDE (⑪)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="950.0" y="3155.0" width="170.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-420" value="" style="endArrow=none;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="anomaly-414" target="anomaly-419">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-421" value="&lt;b&gt;Isolation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Isolation Forest (⑩)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="970.0" y="3285.0" width="170.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="anomaly-422" value="" style="endArrow=none;endFill=1;html=1;rounded=0;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="anomaly-414" target="anomaly-421">
