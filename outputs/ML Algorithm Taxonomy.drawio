          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-99" value="draw n rows at random, put each back" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="610.0" y="375.0" width="260.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-100" value="$$P(\text{row never drawn}) = \left(1-\frac{1}{n}\right)^{n} \xrightarrow{n\to\infty} e^{-1} \approx 0.368$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="635.0" width="600.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-101" value="n = 8:  \((7/8)^8 = 0.344\)  ·  in our 3 samples: 7 of 24 rows OOB = &lt;span style=&quot;background:#FFFF00&quot;&gt;0.292&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="688.0" width="600.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-102" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Each bootstrap sample has the same size n as the original data&lt;/li&gt;&lt;li&gt;≈ 63.2 % unique rows appear (some twice or more), ≈ 36.8 % are left out = &lt;b&gt;out-of-bag (OOB)&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Every sample is a slightly different 'version' of the data → every model learns something different&lt;/li&gt;&lt;li&gt;Bootstrap also estimates confidence intervals of any statistic (mean, median …)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="730.0" width="600.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-103" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How many rows does each tree never see?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ about 1/e ≈ 36.8 % — here 7 of 24 = 0.292; those out-of-bag rows are a free test set for that tree&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="860.0" width="600.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-104" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870.0" y="860.0" as="sourcePoint" />
            <mxPoint x="870.0" y="712.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-105" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="240.0" width="620.0" height="720.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-106" value="② Out-of-Bag (OOB) = free validation set" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
