        <mxCell id="fitting-181" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;timestamp&lt;/th&gt;&lt;th&gt;sector&lt;/th&gt;&lt;th&gt;y&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1715839200&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1715842800&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;1.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1715846400&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;3&lt;/span&gt;&lt;/td&gt;&lt;td&gt;0.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1715850000&lt;/span&gt;&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background:#FFCCCC&quot;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;0.9&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
