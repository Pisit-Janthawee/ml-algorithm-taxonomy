        <mxCell id="rl-415" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which α, γ and ε schedule should I pick?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ the highlighted rows reach the optimal return fastest in each group: α = 0.5, γ = 0.9, ε = 0 (no exploration)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="3120.0" width="780.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="rl-416" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580.0" y="3120.0" as="sourcePoint" />
            <mxPoint x="1228.0" y="3003.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rl-417" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580.0" y="3120.0" as="sourcePoint" />
            <mxPoint x="1228.0" y="3045.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rl-418" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1580.0" y="3120.0" as="sourcePoint" />
            <mxPoint x="1228.0" y="3087.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rl-419" value="&lt;b&gt;Reading the curves:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;α&lt;/b&gt;: too small learns slowly; too large is noisy (fine here because rewards are deterministic)&lt;/li&gt;&lt;li&gt;&lt;b&gt;γ&lt;/b&gt;: small γ is short-sighted — the distant goal is worth almost nothing, so the agent may not find it&lt;/li&gt;&lt;li&gt;&lt;b&gt;ε&lt;/b&gt;: here ε = 0 still works because Q starts at 0, above the true (negative) values → optimistic initialization explores for free; in noisy / trading environments a decaying ε is needed&lt;/li&gt;&lt;li&gt;Tune on &lt;b&gt;learning curves&lt;/b&gt; (several seeds!), pick the setting with the best final return and fastest convergence&lt;/li&gt;&lt;li&gt;For trading: evaluate the learned policy on a later, unseen price period (walk-forward)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1580.0" y="2930.0" width="800.0" height="125.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
