          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960.0" y="3695.0" as="sourcePoint" />
            <mxPoint x="960.0" y="3675.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="anomaly-460" value="&lt;b&gt;Key idea:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Unsupervised (no labels) is the usual case; anomalies are rare and varied&lt;/li&gt;&lt;li&gt;Score first, then pick a threshold from the expected contamination&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
