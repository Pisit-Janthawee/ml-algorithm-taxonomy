        <mxCell id="dimred-2715" value="&lt;font color=&quot;#3333FF&quot;&gt;&lt;b&gt;min_dist 0.1&lt;/b&gt;: tight clumps&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;min_dist 0.8&lt;/b&gt;: spread out&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1000.0" y="4260.0" width="160.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2716" value="target low-D similarity UMAP fits a, b to" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="4412.0" width="280.0" height="16.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2717" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does UMAP keep both the groups and their layout?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ groups yes (0.94 agreement); positions start from a global (here PCA) layout, so arrangement is more faithful than t-SNE&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160.0" y="4240.0" width="380.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-2718" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1160.0" y="4240.0" as="sourcePoint" />
            <mxPoint x="1135.0" y="4075.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-2719" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;t-SNE&lt;/th&gt;&lt;th&gt;UMAP&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Preserves&lt;/td&gt;&lt;td&gt;local neighbourhoods&lt;/td&gt;&lt;td&gt;local + more global structure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Speed&lt;/td&gt;&lt;td&gt;slow (O(n²), Barnes-Hut O(n log n))&lt;/td&gt;&lt;td&gt;fast, scales to millions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Transform new data&lt;/td&gt;&lt;td&gt;no (re-run)&lt;/td&gt;&lt;td&gt;yes (.transform)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Key parameters&lt;/td&gt;&lt;td&gt;perplexity 5–50, learning rate, iterations&lt;/td&gt;&lt;td&gt;n_neighbors 5–50, min_dist 0–0.99, metric&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Use as features?&lt;/td&gt;&lt;td&gt;visualisation only&lt;/td&gt;&lt;td&gt;sometimes (clustering after UMAP, e.g. HDBSCAN)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="4450.0" width="1120.0" height="150.0" as="geometry" />
        </mxCell>
