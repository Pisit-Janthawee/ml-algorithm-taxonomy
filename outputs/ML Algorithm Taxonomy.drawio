        <mxCell id="statistics-187" value="random sampling (n)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="680.0" y="360.0" width="120.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-188" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Population &lt;b&gt;parameter&lt;/b&gt;&lt;/th&gt;&lt;th&gt;Sample &lt;b&gt;statistic&lt;/b&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Size&lt;/td&gt;&lt;td&gt;\(N\)&lt;/td&gt;&lt;td&gt;\(n\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mean&lt;/td&gt;&lt;td&gt;\(\mu = \frac{1}{N}\sum x_i\)&lt;/td&gt;&lt;td&gt;\(\bar{x} = \frac{1}{n}\sum x_i\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Std. dev.&lt;/td&gt;&lt;td&gt;\(\sigma\)&lt;/td&gt;&lt;td&gt;\(s = \sqrt{\frac{\sum(x_i-\bar{x})^2}{n-1}}\)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Proportion&lt;/td&gt;&lt;td&gt;\(p\)&lt;/td&gt;&lt;td&gt;\(\hat{p} = \frac{x}{n}\)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="440.0" y="590.0" width="540.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-189" value="&lt;b&gt;Key idea:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;A &lt;b&gt;statistic&lt;/b&gt; changes from sample to sample → it has its own distribution: the &lt;b&gt;sampling distribution&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Inferential statistics = estimate parameters and test claims using that sampling distribution&lt;/li&gt;&lt;li&gt;Samples must be &lt;b&gt;random&lt;/b&gt; and &lt;b&gt;independent&lt;/b&gt; (otherwise bias, not just noise)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="760.0" width="580.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-190" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;What can I actually compute from my data?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ only statistics (x̄, s, p̂); μ, σ, p stay unknown and must be estimated from them&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="828.0" width="560.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-191" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="925.0" y="828.0" as="sourcePoint" />
            <mxPoint x="925.0" y="718.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="statistics-192" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="240.0" width="1340.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-193" value="② ★ Central Limit Theorem (CLT)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1074.0" y="250.0" width="1312.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="statistics-194" value="Whatever the population shape, the distribution of sample means → Normal as n grows (simulated: 4000 samples each)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
