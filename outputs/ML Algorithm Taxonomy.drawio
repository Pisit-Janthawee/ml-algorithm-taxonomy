        <mxCell id="ensemble-1144" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;day&lt;/th&gt;&lt;th&gt;true&lt;/th&gt;&lt;th&gt;P_LR&lt;/th&gt;&lt;th&gt;P_kNN&lt;/th&gt;&lt;th&gt;P_Tree&lt;/th&gt;&lt;th&gt;hard votes&lt;/th&gt;&lt;th&gt;hard&lt;/th&gt;&lt;th&gt;soft avg&lt;/th&gt;&lt;th&gt;soft&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Up&lt;/td&gt;&lt;td&gt;0.80&lt;/td&gt;&lt;td&gt;0.70&lt;/td&gt;&lt;td&gt;0.65&lt;/td&gt;&lt;td&gt;3/3 Up&lt;/td&gt;&lt;td&gt;Up ✔&lt;/td&gt;&lt;td&gt;0.717&lt;/td&gt;&lt;td&gt;Up ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;Dn&lt;/td&gt;&lt;td&gt;0.30&lt;/td&gt;&lt;td&gt;0.20&lt;/td&gt;&lt;td&gt;0.45&lt;/td&gt;&lt;td&gt;0/3 Up&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;td&gt;0.317&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Up&lt;/td&gt;&lt;td&gt;0.90&lt;/td&gt;&lt;td&gt;0.40&lt;/td&gt;&lt;td&gt;0.45&lt;/td&gt;&lt;td&gt;1/3 Up&lt;/td&gt;&lt;td&gt;Dn ✘&lt;/td&gt;&lt;td&gt;0.583&lt;/td&gt;&lt;td&gt;Up ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;Dn&lt;/td&gt;&lt;td&gt;0.55&lt;/td&gt;&lt;td&gt;0.30&lt;/td&gt;&lt;td&gt;0.35&lt;/td&gt;&lt;td&gt;1/3 Up&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;td&gt;0.400&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Up&lt;/td&gt;&lt;td&gt;0.60&lt;/td&gt;&lt;td&gt;0.55&lt;/td&gt;&lt;td&gt;0.40&lt;/td&gt;&lt;td&gt;2/3 Up&lt;/td&gt;&lt;td&gt;Up ✔&lt;/td&gt;&lt;td&gt;0.517&lt;/td&gt;&lt;td&gt;Up ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Dn&lt;/td&gt;&lt;td&gt;0.45&lt;/td&gt;&lt;td&gt;0.52&lt;/td&gt;&lt;td&gt;0.10&lt;/td&gt;&lt;td&gt;1/3 Up&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;td&gt;0.357&lt;/td&gt;&lt;td&gt;Dn ✔&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;acc.&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;5/6&lt;/td&gt;&lt;td&gt;4/6&lt;/td&gt;&lt;td&gt;4/6&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;5/6&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;6/6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
