        <mxCell id="regression-246" value="Partial derivatives (chain rule):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1200.0" width="360.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-247" value="$$\frac{\partial J}{\partial\beta_0} = \frac{1}{m}\sum_{i=1}^{m}(\hat{y}_i-y_i)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1225.0" width="380.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-248" value="$$\frac{\partial J}{\partial\beta_1} = \frac{1}{m}\sum_{i=1}^{m}(\hat{y}_i-y_i)\,x_i$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1280.0" width="380.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-249" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;β0, β1 = 0, 0&lt;br&gt;for epoch in range(N):&lt;br&gt;&amp;nbsp;&amp;nbsp;ŷ = β0 + β1·x&lt;br&gt;&amp;nbsp;&amp;nbsp;β0 -= α·mean(ŷ − y)&lt;br&gt;&amp;nbsp;&amp;nbsp;β1 -= α·mean((ŷ − y)·x)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="1345.0" width="380.0" height="140.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-250" value="Update β0 and β1 simultaneously!" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
