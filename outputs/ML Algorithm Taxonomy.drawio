        <mxCell id="distributions-252" value="Tails never touch the axis" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
