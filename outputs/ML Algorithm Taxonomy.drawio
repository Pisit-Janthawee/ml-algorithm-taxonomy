        <mxCell id="optimization-256" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why does Adam get down the valley faster?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ it sizes each parameter's step separately: less zig-zag across, faster along the valley&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="890.0" y="1115.0" width="145.0" height="90.0" as="geometry" />
        </mxCell>
        <mxCell id="optimization-257" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
