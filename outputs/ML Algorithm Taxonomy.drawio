        <mxCell id="clustering-1055" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Model&lt;/th&gt;&lt;th&gt;Hyper-parameter&lt;/th&gt;&lt;th&gt;Technique&lt;/th&gt;&lt;th&gt;Rule&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;K-Means / K-Medoids&lt;/td&gt;&lt;td&gt;k&lt;/td&gt;&lt;td&gt;Elbow, Silhouette, Gap, CH, DB&lt;/td&gt;&lt;td&gt;knee / max / 1-SE / max / min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Hierarchical&lt;/td&gt;&lt;td&gt;cut height / k&lt;/td&gt;&lt;td&gt;Dendrogram&lt;/td&gt;&lt;td&gt;largest vertical gap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GMM&lt;/td&gt;&lt;td&gt;n_components&lt;/td&gt;&lt;td&gt;BIC / AIC&lt;/td&gt;&lt;td&gt;minimum (BIC stricter)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DBSCAN&lt;/td&gt;&lt;td&gt;eps, minPts&lt;/td&gt;&lt;td&gt;k-distance plot&lt;/td&gt;&lt;td&gt;knee; minPts ≥ dims + 1 (≈ 2·dims)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HDBSCAN&lt;/td&gt;&lt;td&gt;min_cluster_size&lt;/td&gt;&lt;td&gt;stability / DBCV&lt;/td&gt;&lt;td&gt;smallest meaningful group&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Spectral&lt;/td&gt;&lt;td&gt;k&lt;/td&gt;&lt;td&gt;eigengap of Laplacian&lt;/td&gt;&lt;td&gt;largest gap λₖ₊₁ − λₖ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1880.0" y="2605.0" width="500.0" height="200.0" as="geometry" />
        </mxCell>
        <mxCell id="clustering-1056" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Always scale features first: every method above depends on distances&lt;/li&gt;&lt;li&gt;Internal scores only measure geometry; if true labels exist also check external scores (ARI, NMI)&lt;/li&gt;&lt;li&gt;Final choice = scores + stability across seeds / subsamples + business meaning of the clusters&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1460.0" y="2860.0" width="920.0" height="85.0" as="geometry" />
