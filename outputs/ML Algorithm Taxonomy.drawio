        <mxCell id="dimred-1321" value="heavy tail: moderately far points may sit far apart in 2-D" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
