        <mxCell id="anomaly-923" value="&lt;b&gt;Settings:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;n_estimators ≈ 100–300, max_samples ψ = 256 (64 here)&lt;/li&gt;&lt;li&gt;contamination only sets the threshold, not the scores&lt;/li&gt;&lt;li&gt;fast O(n log ψ), no distances, works in high dimensions&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
