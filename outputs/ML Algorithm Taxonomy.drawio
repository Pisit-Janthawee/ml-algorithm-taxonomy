        <mxCell id="deeplearning-39" value="&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;i.i.d. samples&lt;/li&gt;&lt;li&gt;Scaled numeric inputs&lt;/li&gt;&lt;li&gt;Enough data relative to parameters&lt;/li&gt;&lt;li&gt;Differentiable loss and activations&lt;/li&gt;&lt;li&gt;Fixed-size inputs, no spatial / temporal structure&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
