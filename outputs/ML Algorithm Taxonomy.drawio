        <mxCell id="versatile-2244" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;k&lt;/th&gt;&lt;th&gt;bits / pixel&lt;/th&gt;&lt;th&gt;size vs 24-bit&lt;/th&gt;&lt;th&gt;colour MSE&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;24× smaller&lt;/td&gt;&lt;td&gt;1516&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;12× smaller&lt;/td&gt;&lt;td&gt;186&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;8× smaller&lt;/td&gt;&lt;td&gt;36&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1340.0" width="450.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2245" value="$$J=\sum_{i}\lVert \mathbf{x}_i-\boldsymbol{\mu}_{c(i)}\rVert^2,\quad \mathbf{x}_i=(R,G,B)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="920.0" y="1460.0" width="450.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2246" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Same K-Means as page 6 — the 'points' are pixels, the features are colours&lt;/li&gt;&lt;li&gt;Storage: palette (k colours) + log₂k bits per pixel instead of 24&lt;/li&gt;&lt;li&gt;Also used for vector quantization of audio, embeddings and GIF palettes&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
