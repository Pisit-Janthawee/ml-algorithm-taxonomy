        <mxCell id="timeseries-364" value="$$\rho_k = \frac{\sum_t (y_t-\bar{y})(y_{t-k}-\bar{y})}{\sum_t (y_t-\bar{y})^2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
