        <mxCell id="kernel-1367" value="&lt;b&gt;Reading it:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;No training step: the 'model' &lt;b&gt;is&lt;/b&gt; the stored table&lt;/li&gt;&lt;li&gt;Without scaling, RSI (range 30–72) would dominate EMA gap (range −1.9…1.8) in the distance&lt;/li&gt;&lt;li&gt;Each prediction costs n distance computations → use KD-tree / Ball-tree for large n&lt;/li&gt;&lt;li&gt;Distance-weighted vote: weight = 1/d (closer neighbours count more)&lt;/li&gt;&lt;li&gt;Regression version: ŷ = mean of the neighbours' targets&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="2210.0" width="510.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-1368" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Should the new day be traded as Up or Down?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Up: days 3, 7, 8 are the 3 most similar rows → Up = 2, Down = 1 → P(Up) = 0.67&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870.0" y="2365.0" width="510.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="kernel-1369" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870.0" y="2365.0" as="sourcePoint" />
            <mxPoint x="677.1" y="2308.4" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kernel-1370" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Scale with the &lt;b&gt;training&lt;/b&gt; min/max (or mean/σ) and reuse them for every new query to avoid leakage&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
