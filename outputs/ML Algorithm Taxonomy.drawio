        <mxCell id="deeplearning-274" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;When should training stop?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ at epoch 25, where validation loss is lowest; after that the net memorises&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1960.0" y="1040.0" width="200.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-275" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
