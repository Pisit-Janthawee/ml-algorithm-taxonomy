        <mxCell id="versatile-2315" value="error vs clean signal: raw 0.201 → k = 2: 0.024 (88 % less noise)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2040.0" y="1320.0" width="350.0" height="34.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2316" value="$$\hat{\mathbf{x}} = \boldsymbol{\mu} + \sum_{j=1}^{k} (\mathbf{v}_j^{\top}(\mathbf{x}-\boldsymbol{\mu}))\,\mathbf{v}_j$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="1380.0" width="480.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2317" value="&lt;b&gt;Why it works:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;60 noisy signals of length 24; the true signals live in only 2 dimensions (sin &amp; cos) → eigenvalues 18.38, 12.11, 0.47, 0.41, 0.35 …&lt;/li&gt;&lt;li&gt;k too small loses signal, k too large keeps noise — the error is lowest at k = 2&lt;/li&gt;&lt;li&gt;Compression: store 2 scores + 2 shared components instead of 24 values per signal (12× smaller per signal)&lt;/li&gt;&lt;li&gt;Same idea on images: eigen-faces / eigen-images; on returns: factor models (market, sector)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="1440.0" width="900.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2318" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="1700.0" width="1000.0" height="690.0" as="geometry" />
        </mxCell>
        <mxCell id="versatile-2319" value="⑤ Model-as-a-Tool gallery" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
