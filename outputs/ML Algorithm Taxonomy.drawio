            <mxPoint x="710.0" y="505.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="classification-78" value="$$\hat{p} = P(y=1\mid x) = \sigma(z) = \frac{1}{1+e^{-z}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="460.0" y="645.0" width="520.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-79" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(\sigma\) squashes any real number \(z \in (-\infty, \infty)\) into a probability \((0, 1)\)&lt;/li&gt;&lt;li&gt;\(z\) is the &lt;b&gt;log-odds&lt;/b&gt;:  \(\ln\frac{\hat{p}}{1-\hat{p}} = z\)  →  \(e^{\beta_j}\) = odds ratio of feature j&lt;/li&gt;&lt;li&gt;Prediction:  \(\hat{y} = 1\) if \(\hat{p} \ge 0.5\) (i.e. \(z \ge 0\)), else \(\hat{y} = 0\)&lt;/li&gt;&lt;li&gt;Derivative is simple:  \(\sigma'(z) = \sigma(z)\,(1-\sigma(z))\) — used in gradient descent ④&lt;/li&gt;&lt;li&gt;Example: z = 2  →  \(\hat{p} = 1/(1+e^{-2}) = 0.881\)  →  class 1&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="710.0" width="600.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-80" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How likely is this row to be class 1?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ read σ(z): z = 2 gives p̂ = 0.881; z = 0 is the 50 % boundary; each +1 in z multiplies the odds by e ≈ 2.7&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="845.0" width="600.0" height="54.0" as="geometry" />
        </mxCell>
        <mxCell id="classification-81" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="786.7" y="845.0" as="sourcePoint" />
