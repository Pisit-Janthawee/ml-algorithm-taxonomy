        <mxCell id="anomaly-231" value="&lt;span style='background:#FFFF00'&gt;\(M_{12} = 15.7 \gg 3.5\) → clear outlier (normal points: |M| ≤ 1.35)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
