            <mxPoint x="1928.0" y="2084.3" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-573" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Confidence&lt;/th&gt;&lt;th&gt;α&lt;/th&gt;&lt;th&gt;|z| critical&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;90 %&lt;/td&gt;&lt;td&gt;0.10&lt;/td&gt;&lt;td&gt;1.645&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;95 %&lt;/td&gt;&lt;td&gt;0.05&lt;/td&gt;&lt;td&gt;1.96&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;99 %&lt;/td&gt;&lt;td&gt;0.01&lt;/td&gt;&lt;td&gt;2.576&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;99.73 %&lt;/td&gt;&lt;td&gt;0.0027&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2090.0" y="1880.0" width="290.0" height="109.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-574" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is this observation unusual?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ if |z| &gt; 1.96 it is in the red 5 % tails; the example z = 3 is beyond 99.7 % of normal data → outlier&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2080.0" y="2000.0" width="300.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-575" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2080.0" y="2068.0" as="sourcePoint" />
            <mxPoint x="1942.0" y="2089.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="distributions-576" value="&lt;b&gt;Example:&lt;/b&gt; house price x = 80, μ = 50, σ = 10 → z = (80 − 50)/10 = &lt;span style=&quot;background:#FFFF00&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/span&gt; → outlier (|z| ≥ 3)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1440.0" y="2140.0" width="920.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="distributions-577" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;After standardization every feature has mean 0 and σ 1 → fair comparison &amp; faster Gradient Descent&lt;/li&gt;&lt;li&gt;Z-test (σ known) vs. T-test (σ unknown, uses s and Student's t);  one-tailed vs. two-tailed tests&lt;/li&gt;&lt;li&gt;Percentile ↔ z:  z = 0 → 50th,  z = 1 → 84th,  z = 2 → 97.7th percentile&lt;/li&gt;&lt;li&gt;Z-score outlier rule is the base algorithm of &lt;b&gt;Anomaly Detection&lt;/b&gt; (assumes roughly normal data)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="2180.0" width="960.0" height="105.0" as="geometry" />
        </mxCell>
        <UserObject label="▶ Open Anomaly Detection (Z-Score) page" link="data:page/id,anomaly" id="distributions-578">
