        <mxCell id="evaluation-469" value="&lt;font color=&quot;#3333FF&quot;&gt;— train error&lt;/font&gt;  &lt;font color=&quot;#FF0000&quot;&gt;— validation error&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2040.0" y="2020.0" width="300.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-470" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Symptom&lt;/th&gt;&lt;th&gt;Diagnosis&lt;/th&gt;&lt;th&gt;Fixes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;train high ≈ validation high&lt;/td&gt;&lt;td&gt;high bias (underfit)&lt;/td&gt;&lt;td&gt;more features / complexity, less regularization, boosting&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;train low ≪ validation high&lt;/td&gt;&lt;td&gt;high variance (overfit)&lt;/td&gt;&lt;td&gt;more data, regularization, simpler model, bagging, early stopping&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gap shrinks as n grows&lt;/td&gt;&lt;td&gt;variance — data helps&lt;/td&gt;&lt;td&gt;collect more data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;both flat &amp; high as n grows&lt;/td&gt;&lt;td&gt;bias — data won't help&lt;/td&gt;&lt;td&gt;change model / features&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1570.0" y="2060.0" width="800.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="evaluation-471" value="Learning curves tell you whether to spend effort on more data or on a better model." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
