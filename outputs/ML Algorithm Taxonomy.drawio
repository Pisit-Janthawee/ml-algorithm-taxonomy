            <mxPoint x="1090.0" y="1904.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="datanature-634" value="$$V = \sqrt{\frac{\chi^2}{n\,(\min(r,c)-1)}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1990.0" width="260.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="datanature-635" value="$$\eta^2 = \frac{SS_{between}}{SS_{total}}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
