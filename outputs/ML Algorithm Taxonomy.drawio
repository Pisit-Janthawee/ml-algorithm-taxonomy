        <mxCell id="deeplearning-224" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#FF0000;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;" edge="1" parent="1">
