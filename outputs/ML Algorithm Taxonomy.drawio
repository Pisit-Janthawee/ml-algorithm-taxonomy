        </mxCell>
        <mxCell id="deeplearning-695" value="unrolled (BPTT trains through these copies)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1670.0" y="4305.0" width="560.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-696" value="$$h_t = \tanh\left(W_{xh}\,x_t + W_{hh}\,h_{t-1} + b_h\right)$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="4330.0" width="440.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-697" value="$$\hat{y}_t = W_{hy}\,h_t + b_y$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1960.0" y="4330.0" width="300.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-698" value="Worked example (scalar, W_xh = 0.5, W_hh = 0.8, h₀ = 0, b = 0):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="4382.0" width="600.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-699" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;t&lt;/th&gt;&lt;th&gt;\(x_t\)&lt;/th&gt;&lt;th&gt;\(W_{xh}x_t + W_{hh}h_{t-1}\)&lt;/th&gt;&lt;th&gt;\(h_t=\tanh(\cdot)\)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0.5·1 + 0.8·0.000 = 0.500&lt;/td&gt;&lt;td&gt;0.462&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;0.5·2 + 0.8·0.462 = 1.370&lt;/td&gt;&lt;td&gt;0.879&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0.5·0 + 0.8·0.879 = 0.703&lt;/td&gt;&lt;td&gt;0.606&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;-1&lt;/td&gt;&lt;td&gt;0.5·-1 + 0.8·0.606 = -0.015&lt;/td&gt;&lt;td&gt;-0.015&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="4406.0" width="520.0" height="140.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-700" value="&lt;b&gt;Sequence patterns:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;many-to-one&lt;/b&gt;: price window → next return (this example)&lt;/li&gt;&lt;li&gt;&lt;b&gt;many-to-many&lt;/b&gt;: label every step (e.g. POS tags, per-bar signals)&lt;/li&gt;&lt;li&gt;&lt;b&gt;one-to-many&lt;/b&gt;: caption / sequence generation&lt;/li&gt;&lt;li&gt;Inputs come from the lag window of the AR/MA page ⑧: shape (samples, N steps, features)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="2030.0" y="4400.0" width="350.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-701" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does the RNN still remember the first input at step 4?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ weakly: h₄ = -0.015 mixes all inputs, but x₁'s share shrinks by ≈0.8× per step&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1990.0" y="4498.0" width="380.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-702" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1990.0" y="4532.0" as="sourcePoint" />
            <mxPoint x="1858.0" y="4507.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-703" value="h₄ still contains a trace of x₁ — that is the memory; but it fades quickly (see ⑬)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1480.0" y="4565.0" width="880.0" height="20.0" as="geometry" />
        </mxCell>
