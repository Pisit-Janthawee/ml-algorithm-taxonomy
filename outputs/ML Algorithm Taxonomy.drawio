        <mxCell id="anomaly-232" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Z-score&lt;/th&gt;&lt;th&gt;Modified Z&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;centre&lt;/td&gt;&lt;td&gt;mean = 53&lt;/td&gt;&lt;td&gt;median = 50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;spread&lt;/td&gt;&lt;td&gt;σ = 9.79&lt;/td&gt;&lt;td&gt;MAD = 1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;score of 85&lt;/td&gt;&lt;td&gt;3.27&lt;/td&gt;&lt;td&gt;15.7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;threshold&lt;/td&gt;&lt;td&gt;|z| &gt; 3&lt;/td&gt;&lt;td&gt;|M| &gt; 3.5&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
