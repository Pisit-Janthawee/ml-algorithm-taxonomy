          <mxGeometry x="1920.0" y="1937.0" width="240.0" height="28.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-440" value="test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#FF8000;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2168.0" y="1937.0" width="70.0" height="28.0" as="geometry" />
