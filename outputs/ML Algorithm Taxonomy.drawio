        </mxCell>
        <mxCell id="explain-244" value="&lt;font color=&quot;#FF0000&quot;&gt;Noise&lt;/font&gt; gets &lt;b&gt;7%&lt;/b&gt; of the Gini importance (trees can always find splits on a continuous random column) but only &lt;b&gt;0%&lt;/b&gt; of the permutation importance on held-out data." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1420.0" width="720.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-245" value="&lt;b&gt;Fixes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Group permutation&lt;/b&gt;: shuffle correlated features together (cluster by |r| &amp;gt; 0.8 first)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Drop-column importance&lt;/b&gt;: retrain without feature j and compare scores (exact but p retrainings)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Conditional permutation&lt;/b&gt;: shuffle j only within groups of similar correlated features&lt;/li&gt;&lt;li&gt;Prefer permutation / SHAP on &lt;b&gt;test&lt;/b&gt; data over impurity importance (biased to high-cardinality, computed on train)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1475.0" width="720.0" height="105.0" as="geometry" />
        </mxCell>
