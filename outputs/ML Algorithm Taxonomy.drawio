        <mxCell id="deeplearning-744" value="o: output" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3333FF;strokeWidth=2;fontFamily=Helvetica;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;fontColor=default;spacing=4;" vertex="1" parent="1">
