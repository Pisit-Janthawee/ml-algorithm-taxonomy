        <mxCell id="labelling-394" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;label&lt;/th&gt;&lt;th&gt;span&lt;/th&gt;&lt;th&gt;\(\bar{u}_i\)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;[0, 8]&lt;/td&gt;&lt;td&gt;0.59&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;[3, 10]&lt;/td&gt;&lt;td&gt;0.48&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;[5, 9]&lt;/td&gt;&lt;td&gt;0.37&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;[12, 20]&lt;/td&gt;&lt;td&gt;0.61&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;[14, 25]&lt;/td&gt;&lt;td&gt;0.54&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;[22, 28]&lt;/td&gt;&lt;td&gt;0.71&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1060.0" y="1820.0" width="150.0" height="144.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-395" value="$$c_t = \sum_i 1_{t,i}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2040.0" width="190.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-396" value="$$\bar{u}_i = \frac{1}{T_i}\sum_{t \in i}\frac{1}{c_t}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2075.0" width="190.0" height="46.0" as="geometry" />
        </mxCell>
        <mxCell id="labelling-397" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(c_t\) = number of labels alive at time t (concurrency);  \(\bar{u}_i\) = average uniqueness of label i (1 = no overlap)&lt;/li&gt;&lt;li&gt;Use \(\bar{u}_i\) (× |return|) as sample weight, and bootstrap with probability ∝ uniqueness (sequential bootstrap)&lt;/li&gt;&lt;li&gt;Overlap breaks the i.i.d. assumption → ordinary K-fold leaks future information into training&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="2150.0" width="790.0" height="85.0" as="geometry" />
        </mxCell>
