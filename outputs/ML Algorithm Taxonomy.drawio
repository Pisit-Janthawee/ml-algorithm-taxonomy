        </mxCell>
        <mxCell id="tree-187" value="At each node: compute entropy of the subset, compute IG of every remaining feature, split on the best, repeat" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
