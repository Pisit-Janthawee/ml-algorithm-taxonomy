        </mxCell>
        <mxCell id="dimred-400" value="&lt;span style='background:#FFFF00'&gt;Keep k = 4 components → 95% of the variance with 4 instead of 6 features&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="1360.0" width="660.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-401" value="&lt;b&gt;Choose k:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Rules of thumb: cumulative ≥ 90–95%, or the 'elbow' of the bars, or λ &gt; 1 (Kaiser)&lt;/li&gt;&lt;li&gt;For visualization keep k = 2 or 3&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="1395.0" width="660.0" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-402" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1800.0" y="900.0" width="600.0" height="600.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-403" value="⑥ Algorithm &amp;amp; Trade-offs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1814.0" y="910.0" width="572.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-404" value="&lt;b&gt;Pseudo-code&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;Z = (X − μ) / σ&amp;nbsp;&amp;nbsp;# ① standardize&lt;br&gt;Σ = Zᵀ Z / (n − 1)&amp;nbsp;&amp;nbsp;# ② covariance&lt;br&gt;λ, V = eig(Σ)&amp;nbsp;&amp;nbsp;# ② eigen&lt;br&gt;sort λ descending, reorder V&lt;br&gt;W = V[:, :k]&amp;nbsp;&amp;nbsp;# ⑤ choose k&lt;br&gt;Z_k = Z · W&amp;nbsp;&amp;nbsp;# ④ project&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=default;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="950.0" width="560.0" height="170.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-405" value="&lt;b&gt;✔ Pros&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Removes multicollinearity, speeds up training, reduces noise&lt;/li&gt;&lt;li&gt;Unsupervised: no labels needed;  fast (one eigen / SVD)&lt;/li&gt;&lt;li&gt;Good for 2-D / 3-D visualization of high-dimensional data&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="1140.0" width="560.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-406" value="&lt;b&gt;✘ Cons&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Components are mixes of features → hard to interpret&lt;/li&gt;&lt;li&gt;Linear only → curved structure needs Kernel PCA, t-SNE, UMAP&lt;/li&gt;&lt;li&gt;Sensitive to scaling and outliers;  high variance ≠ useful for the target&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="1235.0" width="560.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-407" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Does more variance mean more predictive power?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Not necessarily: PCA ignores the target; a small PC can still predict y (try LDA / supervised)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2165.0" y="988.0" width="210.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-408" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2165.0" y="1084.0" as="sourcePoint" />
            <mxPoint x="2140.0" y="1292.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dimred-409" value="&lt;b&gt;Related:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;LDA&lt;/b&gt;: supervised — maximizes class separation instead of variance&lt;/li&gt;&lt;li&gt;&lt;b&gt;Truncated SVD&lt;/b&gt;: PCA without centring, for sparse text matrices&lt;/li&gt;&lt;li&gt;&lt;b&gt;Autoencoder&lt;/b&gt;: non-linear PCA with a neural network&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1820.0" y="1330.0" width="560.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-410" value="Dimensionality: why reduce, and which method" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="1520.0" width="1200.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-411" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="1560.0" width="1000.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-412" value="⑦ Curse of Dimensionality" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
