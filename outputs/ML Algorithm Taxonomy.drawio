        <mxCell id="timeseries-259" value="Lag plot: slope ≈ φ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="1150.0" y="825.0" width="180.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-260" value="&lt;b&gt;Rules of φ:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(|\varphi| \lt 1\) → stationary (shocks fade)&lt;/li&gt;&lt;li&gt;\(\varphi = 1\) → random walk (non-stationary)&lt;/li&gt;&lt;li&gt;\(\varphi \lt 0\) → zig-zag series&lt;/li&gt;&lt;li&gt;Mean of AR(1): \(\mu = \frac{c}{1-\varphi}\)&lt;/li&gt;&lt;li&gt;Variance: \(\frac{\sigma^2}{1-\varphi^2}\)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1360.0" y="660.0" width="320.0" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-261" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How strongly does today depend on yesterday?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ lag-plot slope ≈ φ = 0.8 → 80 % of yesterday's deviation carries over&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1350.0" y="795.0" width="330.0" height="68.0" as="geometry" />
        </mxCell>
