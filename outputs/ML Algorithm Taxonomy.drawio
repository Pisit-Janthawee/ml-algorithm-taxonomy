          <mxGeometry x="400.0" y="1700.0" width="1300.0" height="780.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-408" value="⑤ SHAP (SHapley Additive exPlanations)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1710.0" width="1272.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-409" value="Each feature&amp;#x27;s fair share of the gap between the average prediction and this prediction" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1736.0" width="1272.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-410" value="$$\phi_j = \sum_{S \subseteq N \setminus \{j\}} \frac{|S|!\,(|N|-|S|-1)!}{|N|!}\left[v(S\cup\{j\}) - v(S)\right]$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1764.0" width="620.0" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="explain-411" value="weight: share of orderings with S before j" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="1828.0" width="250.0" height="18.0" as="geometry" />
