        </mxCell>
        <mxCell id="anomaly-463" value="Random feature, random split value, repeat → short path = anomaly" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
