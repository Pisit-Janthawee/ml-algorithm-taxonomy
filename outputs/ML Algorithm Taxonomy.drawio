        </mxCell>
        <mxCell id="optimization-122" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Each contour = set of (θ₀, θ₁) with the same cost&lt;/li&gt;&lt;li&gt;Partial derivative: change J along ONE parameter, keep the others fixed&lt;/li&gt;&lt;li&gt;For linear regression: \(\frac{\partial J}{\partial\theta_j} = \frac{1}{m}\sum(\hat{y}_i-y_i)x_{ij}\)&lt;/li&gt;&lt;li&gt;All θⱼ are updated &lt;b&gt;simultaneously&lt;/b&gt; with the same α&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="730.0" width="330.0" height="130.0" as="geometry" />
        </mxCell>
