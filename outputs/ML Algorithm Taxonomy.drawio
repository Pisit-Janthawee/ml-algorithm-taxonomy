        <mxCell id="regression-119" value="$$\hat{y}_i = \beta_0 + \beta_1 x_i + \epsilon_i$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="695.0" width="400.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-120" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;How much does y change when x grows by one unit?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ read the slope β₁ (here ≈ 0.7): +1 in x → +0.7 in ŷ; sign = direction of the relationship&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="490.0" width="230.0" height="96.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-121" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790.0" y="538.0" as="sourcePoint" />
            <mxPoint x="608.0" y="532.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="regression-122" value="&lt;b&gt;Where:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;\(\hat{y}_i\) = predicted value,  \(y_i\) = actual (observed) value&lt;/li&gt;&lt;li&gt;\(x_i\) = input feature (independent variable)&lt;/li&gt;&lt;li&gt;\(\beta_0\) = intercept,  \(\beta_1\) = slope (change of ŷ when x increases by 1)&lt;/li&gt;&lt;li&gt;\(\epsilon_i\) = error term (residual), assumed \(\sim N(0, \sigma^2)\)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Goal:&lt;/b&gt; find \(\beta_0, \beta_1\) that minimize the error between \(\hat{y}_i\) and \(y_i\)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="745.0" width="600.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-123" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080.0" y="240.0" width="620.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-124" value="② Least Squares (closed-form solution)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="250.0" width="592.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-125" value="Background: mean, variance, covariance" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1094.0" y="276.0" width="592.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-126" value="$$\beta_1 = \frac{\sum_{i=1}^{n}(x_i-\bar{x})(y_i-\bar{y})}{\sum_{i=1}^{n}(x_i-\bar{x})^2} = \frac{Cov(x,y)}{Var(x)}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="310.0" width="580.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-127" value="$$\beta_0 = \bar{y} - \beta_1\bar{x}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="370.0" width="580.0" height="36.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-128" value="Example: 5 houses (x = size, y = price)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="415.0" width="400.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-129" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;\(x\)&lt;/th&gt;&lt;th&gt;\(y\)&lt;/th&gt;&lt;th&gt;\(x-\bar{x}\)&lt;/th&gt;&lt;th&gt;\(y-\bar{y}\)&lt;/th&gt;&lt;th&gt;\((x-\bar{x})(y-\bar{y})\)&lt;/th&gt;&lt;th&gt;\((x-\bar{x})^2\)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;-2&lt;/td&gt;&lt;td&gt;-2&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;-1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;\(\bar{x}=3\)&lt;/td&gt;&lt;td&gt;\(\bar{y}=4\)&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;Σ&lt;/td&gt;&lt;td&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="440.0" width="360.0" height="151.0" as="geometry" />
        </mxCell>
        <mxCell id="regression-130" value="$$\beta_1 = \frac{6}{10} = 0.6$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1100.0" y="635.0" width="180.0" height="40.0" as="geometry" />
