        <mxCell id="classification-213" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
