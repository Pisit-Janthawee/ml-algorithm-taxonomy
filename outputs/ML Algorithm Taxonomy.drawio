            <mxPoint x="1966.2" y="1249.2" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-276" value="underfitting" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1827.5" y="1045.6" width="90.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-277" value="overfitting →" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2103.8" y="1137.9" width="100.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-278" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;Epoch&lt;/b&gt; = one pass over all training data;  &lt;b&gt;batch&lt;/b&gt; = samples per weight update&lt;/li&gt;&lt;li&gt;Gap between validation and training loss growing = &lt;b&gt;overfitting&lt;/b&gt; (memorizing)&lt;/li&gt;&lt;li&gt;Fixes: early stopping, &lt;b&gt;Dropout&lt;/b&gt; layer, L2 weight decay, more data&lt;/li&gt;&lt;li&gt;Both losses high = &lt;b&gt;underfitting&lt;/b&gt; → bigger network / train longer&lt;/li&gt;&lt;li&gt;Scale inputs (standardize) and initialize weights randomly (Xavier / He)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1760.0" y="1360.0" width="620.0" height="125.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-279" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400.0" y="1680.0" width="2000.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-280" value="⑦ Data Illustration: one mini-batch flowing through the MLP" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1690.0" width="1972.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-281" value="Tabular trading features → target = next bar up (1) / down (0) · n = 160 rows · network 4 → 6 (tanh) → 1 (sigmoid) · trained 60 epochs, batch 16 → train accuracy 92%" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="414.0" y="1716.0" width="1972.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-282" value="1. Raw tabular data (first 4 rows = one mini-batch)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1744.0" width="520.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-283" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;RSI&lt;/th&gt;&lt;th&gt;EMA gap %&lt;/th&gt;&lt;th&gt;Volume (M)&lt;/th&gt;&lt;th&gt;Return t−1 %&lt;/th&gt;&lt;th&gt;y&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;32.3&lt;/td&gt;&lt;td&gt;-0.57&lt;/td&gt;&lt;td&gt;1.20&lt;/td&gt;&lt;td&gt;-2.29&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;16.2&lt;/td&gt;&lt;td&gt;+0.55&lt;/td&gt;&lt;td&gt;1.06&lt;/td&gt;&lt;td&gt;+1.36&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;56.0&lt;/td&gt;&lt;td&gt;-0.14&lt;/td&gt;&lt;td&gt;0.78&lt;/td&gt;&lt;td&gt;+0.15&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;44.7&lt;/td&gt;&lt;td&gt;+0.35&lt;/td&gt;&lt;td&gt;1.02&lt;/td&gt;&lt;td&gt;-0.41&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;μ&lt;/td&gt;&lt;td&gt;48.6&lt;/td&gt;&lt;td&gt;-0.00&lt;/td&gt;&lt;td&gt;0.99&lt;/td&gt;&lt;td&gt;+0.05&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;σ&lt;/td&gt;&lt;td&gt;15.8&lt;/td&gt;&lt;td&gt;0.49&lt;/td&gt;&lt;td&gt;0.30&lt;/td&gt;&lt;td&gt;0.90&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="1770.0" width="520.0" height="151.0" as="geometry" />
