          </mxGeometry>
        </mxCell>
        <mxCell id="deeplearning-374" value="$$L_b = -\frac{1}{|b|}\sum_{i\in b}\left[y_i\log\hat{p}_i+(1-y_i)\log(1-\hat{p}_i)\right]$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1640.0" y="2125.0" width="720.0" height="50.0" as="geometry" />
        </mxCell>
        <mxCell id="deeplearning-375" value="&lt;b&gt;Notes:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;One &lt;b&gt;mini-batch&lt;/b&gt; = a few rows processed together as a matrix → one gradient step&lt;/li&gt;&lt;li&gt;Rows are shuffled every epoch; 1 epoch = n / batch = 160 / 16 = 10 steps&lt;/li&gt;&lt;li&gt;Backprop uses \(L_b\) of this batch only (see panel ⑤) → noisy but fast updates&lt;/li&gt;&lt;li&gt;Highlighted row = misclassified in this batch → contributes the largest loss&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1640.0" y="2190.0" width="720.0" height="105.0" as="geometry" />
        </mxCell>
