        <mxCell id="labelling-285" value="upper barrier  \(P_{t_0}(1 + pt\cdot\sigma_{t_0}\sqrt{h})\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
