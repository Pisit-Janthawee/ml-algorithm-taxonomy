        <mxCell id="problems-882" value="avg return of &lt;b&gt;survivors only&lt;/b&gt;: &lt;b&gt;+35%&lt;/b&gt;&lt;br&gt;avg incl. &lt;font color='#FF0000'&gt;delisted&lt;/font&gt;: &lt;b&gt;-16%&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1340.0" y="2230.0" width="170.0" height="52.0" as="geometry" />
        </mxCell>
        <mxCell id="problems-883" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Why does my backtest beat reality?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ Delisted stocks are missing: survivors show +35% but the real universe gave -16%&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1340.0" y="2300.0" width="170.0" height="96.0" as="geometry" />
        </mxCell>
