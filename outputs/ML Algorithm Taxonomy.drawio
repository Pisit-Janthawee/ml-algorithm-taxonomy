        <mxCell id="association-242" value="&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Low support → combinatorial explosion of itemsets and rules (slow, mostly noise)&lt;/li&gt;&lt;li&gt;High support → only the obvious best-sellers survive; interesting niche rules vanish&lt;/li&gt;&lt;li&gt;Pick the knee where the count of &lt;b&gt;useful&lt;/b&gt; (lift-filtered) rules is still stable&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2680.0" width="640.0" height="66.0" as="geometry" />
        </mxCell>
