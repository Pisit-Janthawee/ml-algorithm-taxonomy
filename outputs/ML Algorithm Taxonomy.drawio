        <mxCell id="explain-418" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;Order of joining&lt;/th&gt;&lt;th&gt;Δ EMA&lt;/th&gt;&lt;th&gt;Δ RSI&lt;/th&gt;&lt;th&gt;Δ Vol&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EMA → RSI → Vol&lt;/td&gt;&lt;td&gt;-0.193&lt;/td&gt;&lt;td&gt;-0.275&lt;/td&gt;&lt;td&gt;+0.009&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EMA → Vol → RSI&lt;/td&gt;&lt;td&gt;-0.193&lt;/td&gt;&lt;td&gt;-0.315&lt;/td&gt;&lt;td&gt;+0.048&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RSI → EMA → Vol&lt;/td&gt;&lt;td&gt;-0.149&lt;/td&gt;&lt;td&gt;-0.320&lt;/td&gt;&lt;td&gt;+0.009&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RSI → Vol → EMA&lt;/td&gt;&lt;td&gt;-0.143&lt;/td&gt;&lt;td&gt;-0.320&lt;/td&gt;&lt;td&gt;+0.003&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Vol → EMA → RSI&lt;/td&gt;&lt;td&gt;-0.170&lt;/td&gt;&lt;td&gt;-0.315&lt;/td&gt;&lt;td&gt;+0.025&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Vol → RSI → EMA&lt;/td&gt;&lt;td&gt;-0.143&lt;/td&gt;&lt;td&gt;-0.341&lt;/td&gt;&lt;td&gt;+0.025&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FFFF00&quot;&gt;&lt;td&gt;&lt;b&gt;φ = average&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;-0.165&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;-0.314&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;+0.020&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
