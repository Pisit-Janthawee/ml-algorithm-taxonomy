        <mxCell id="regression-292" value="α too large → diverges" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
