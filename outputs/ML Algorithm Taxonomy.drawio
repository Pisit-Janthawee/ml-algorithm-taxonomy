        </mxCell>
        <mxCell id="dimred-1224" value="linear activations + MSE ≈ PCA; non-linear activations learn curved manifolds" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2675.0" width="260.0" height="44.0" as="geometry" />
        </mxCell>
        <mxCell id="dimred-1225" value="&lt;b&gt;Rule of thumb:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Linear structure → PCA (unsupervised) or LDA (supervised, at most C − 1 components)&lt;/li&gt;&lt;li&gt;Curved structure → Kernel PCA, Isomap, UMAP (modelling) or t-SNE (plots only)&lt;/li&gt;&lt;li&gt;Very large / complex data (images, many sensors) → autoencoders; all methods need scaled inputs&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="2820.0" width="1280.0" height="85.0" as="geometry" />
        </mxCell>
