        <mxCell id="timeseries-676" value="Residual  \(R_t\)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="470.0" y="2834.0" width="300.0" height="20.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-677" value="$$\text{Additive: } y_t = T_t + S_t + R_t$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2490.0" width="320.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-678" value="$$\text{Multiplicative: } y_t = T_t \times S_t \times R_t$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2530.0" width="330.0" height="30.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-679" value="&lt;b&gt;How it works:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Additive: seasonal swings constant in size&lt;/li&gt;&lt;li&gt;Multiplicative: swings grow with the level → log turns it additive&lt;/li&gt;&lt;li&gt;Trend by moving average (window = s); seasonal = average deviation per position in the cycle; residual = rest&lt;/li&gt;&lt;li&gt;STL (LOESS) is robust and lets the season change slowly&lt;/li&gt;&lt;li&gt;Residual should look like white noise → model it (ARMA) or use it for anomaly detection&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1030.0" y="2580.0" width="340.0" height="210.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-680" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Is there a repeating pattern, and how long is its cycle?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ yes: the seasonal part repeats every s = 12 steps (±5); the trend adds +0.15 per step; the rest is noise&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040.0" y="2820.0" width="320.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-681" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040.0" y="2820.0" as="sourcePoint" />
            <mxPoint x="1020.0" y="2772.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="timeseries-682" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;strokeWidth=0.5;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=default;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1420.0" y="2420.0" width="980.0" height="660.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-683" value="⑩ ACF &amp;amp; PACF by hand + how to read a correlogram" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1434.0" y="2430.0" width="952.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-684" value="$$r_k = \frac{\sum_{t=k+1}^{n}(y_t-\bar{y})(y_{t-k}-\bar{y})}{\sum_{t=1}^{n}(y_t-\bar{y})^2}$$" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1450.0" y="2465.0" width="420.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-685" value="correlation of the series with itself shifted k steps" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1870.0" y="2480.0" width="210.0" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="timeseries-686" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#555555;strokeWidth=0.75;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
