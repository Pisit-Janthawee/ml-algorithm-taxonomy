        <mxCell id="regression-117" value="\(\beta_1 = \frac{\Delta y}{\Delta x}\) Slope" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=#009900;" vertex="1" parent="1">
