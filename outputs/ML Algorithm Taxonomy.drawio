          <mxGeometry x="1540.0" y="4370.0" width="860.0" height="700.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1242" value="⑬ Bagging vs Boosting vs Voting vs Stacking" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1554.0" y="4380.0" width="832.0" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1243" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background:#EEEEEE&quot;&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;★ Bagging / RF&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;Boosting&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;Voting&lt;/b&gt;&lt;/th&gt;&lt;th&gt;&lt;b&gt;Stacking&lt;/b&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mainly reduces&lt;/td&gt;&lt;td&gt;variance&lt;/td&gt;&lt;td&gt;bias (and variance)&lt;/td&gt;&lt;td&gt;variance&lt;/td&gt;&lt;td&gt;bias + variance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Training&lt;/td&gt;&lt;td&gt;parallel&lt;/td&gt;&lt;td&gt;sequential&lt;/td&gt;&lt;td&gt;parallel&lt;/td&gt;&lt;td&gt;parallel → sequential&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Base learners&lt;/td&gt;&lt;td&gt;same, deep / unstable&lt;/td&gt;&lt;td&gt;same, shallow / weak&lt;/td&gt;&lt;td&gt;different&lt;/td&gt;&lt;td&gt;different&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Combiner&lt;/td&gt;&lt;td&gt;average / majority&lt;/td&gt;&lt;td&gt;weighted sum (α, η)&lt;/td&gt;&lt;td&gt;majority / avg prob&lt;/td&gt;&lt;td&gt;learned meta-model&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Overfitting risk&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;td&gt;medium–high (needs early stop)&lt;/td&gt;&lt;td&gt;low&lt;/td&gt;&lt;td&gt;medium (needs OOF)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Key hyperparameters&lt;/td&gt;&lt;td&gt;n_estimators, max_features&lt;/td&gt;&lt;td&gt;n_rounds, η, depth&lt;/td&gt;&lt;td&gt;weights, hard/soft&lt;/td&gt;&lt;td&gt;base set, meta-model, K&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Typical models&lt;/td&gt;&lt;td&gt;Random Forest, Extra Trees&lt;/td&gt;&lt;td&gt;AdaBoost, XGBoost, LightGBM, CatBoost&lt;/td&gt;&lt;td&gt;LR + kNN + RF&lt;/td&gt;&lt;td&gt;LR + GBM + NN → ridge&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trading use&lt;/td&gt;&lt;td&gt;robust baseline signal&lt;/td&gt;&lt;td&gt;strongest tabular model&lt;/td&gt;&lt;td&gt;combine strategies&lt;/td&gt;&lt;td&gt;combine model families&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="4420.0" width="820.0" height="330.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1244" value="&lt;b&gt;&lt;font color=&quot;#7030A0&quot;&gt;❓ Doing this answers:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Which ensemble should be my first try on tabular data?&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot;&gt;→ start with Random Forest (few knobs, hard to overfit), then gradient boosting with early stopping; add voting / stacking only for the last few %&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#9673A6;strokeWidth=1;align=left;verticalAlign=top;spacing=6;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1560.0" y="4640.0" width="400.0" height="68.0" as="geometry" />
        </mxCell>
        <mxCell id="ensemble-1245" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;strokeWidth=1.2;fontSize=10;fontFamily=Helvetica;endFill=1;endSize=6;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1750.0" y="4640.0" as="sourcePoint" />
            <mxPoint x="1750.0" y="4598.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ensemble-1246" value="&lt;b&gt;Remember:&lt;/b&gt;&lt;ul style=&quot;margin:2px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Diversity is the engine of every ensemble: correlated models add little&lt;/li&gt;&lt;li&gt;Variance of an average of B models with correlation ρ: ρσ² + (1−ρ)σ²/B&lt;/li&gt;&lt;li&gt;Ensembles cost interpretability → use permutation importance / SHAP (Explainability page)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1980.0" y="4632.0" width="400.0" height="85.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
