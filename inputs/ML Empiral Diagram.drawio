        <mxCell id="evaWvi1vpdNmqx1aG_62-41" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=7;" value="&lt;div&gt;\( \frac{\partial J}{\partial \beta_j} = \frac{1}{m} \sum_{i=1}^{m} (\hat{Y}_i - Y_i) X_{ij} \)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="290" x="-2781" y="170.5" as="geometry" />
        </mxCell>
        <mxCell id="evaWvi1vpdNmqx1aG_62-42" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=7;" value="&lt;div&gt;\( \beta_{j} \leftarrow \beta_j - \alpha \cdot \frac{1}{m} \sum_{i=1}^{m} (\hat{Y}_i - Y_i) X_{ij} \)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="310" x="-2779" y="209" as="geometry" />
