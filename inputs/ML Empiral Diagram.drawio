        <mxCell id="SLD8MAGXRNQxXdCwcKoe-45" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&amp;nbsp;\( \mu = \frac{\sum_{i=1}^{N} X_i}{N} \),&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 24px; text-align: left; background-color: transparent;&quot;&gt;Population mean&lt;/span&gt;&lt;/div&gt;" vertex="1">
