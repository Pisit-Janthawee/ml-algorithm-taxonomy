        <mxCell id="5kFyLk4gYI5ngxrhhRNj-9" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" value="&lt;p&gt;Where:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;\(K\): Number of classes&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;\(p_{k}\): Proportion (probability) of samples in the node that belong to class \&lt;span style=&quot;background-color: transparent;&quot;&gt;(k\)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;\(p_k = \frac{\text{number of samples in class } k}{\text{total samples in node}}\)&lt;/p&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="170" width="510" x="26628.75" y="1905" as="geometry" />
        </mxCell>
