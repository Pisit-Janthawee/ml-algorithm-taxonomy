        <mxCell id="GwZDzvBw4KAlplTj4DPt-280" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=default;labelBackgroundColor=none;" value="&lt;span style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;font face=&quot;SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;$$J(\theta) = \frac{1}{2m} \sum_{i=1}^{m} \left( \hat{y}_i - y_i \right)^2 + \frac{\lambda}{2m} \sum_{j=1}^{p} \theta_j^2$$&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/span&gt;" vertex="1">
