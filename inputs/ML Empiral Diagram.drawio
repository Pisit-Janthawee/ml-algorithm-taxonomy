          <mxGeometry height="30" width="400" x="-14410" y="2877.13" as="geometry" />
        </mxCell>
        <mxCell id="5kFyLk4gYI5ngxrhhRNj-11" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=30;fontColor=default;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Nature of Distribution&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="400" x="-22345" y="2827.63" as="geometry" />
        </mxCell>
        <mxCell id="5kFyLk4gYI5ngxrhhRNj-12" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" value="&lt;div&gt;\( \text{Entropy} = -\sum_{k=1}^{K} p_k \log_2(p_k) \)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="400" x="26028.25" y="1805" as="geometry" />
        </mxCell>
        <mxCell id="jvPRw4r8EHJMau3s-ZT8-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p&gt;&lt;strong&gt;Where&lt;/strong&gt;:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;\(K\): Number of classes&lt;/li&gt;&lt;li&gt;\(p_k\): Same as above, the proportion of class \(k\) in the node&lt;/li&gt;&lt;li&gt;\(log_2(p_k)\): Logarithm base 2 — measures the amount of &quot;information&quot; or uncertainty associated with class k&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;Note&lt;/strong&gt;: If \(p_k = 0\), we define \(p_k \log_2(p_k)\)= 0 to avoid log(0).&lt;/p&gt;" vertex="1">
