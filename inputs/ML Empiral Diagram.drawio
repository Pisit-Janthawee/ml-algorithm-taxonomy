        <mxCell id="GwZDzvBw4KAlplTj4DPt-281" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;h3&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Where&lt;/span&gt;:&lt;/font&gt;&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(J(\theta)\): Cost/loss function&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(m\): Number of training examples&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(y^{(i)}\): Actual target value&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(\theta_j\): Model parameters (excluding \(\theta_j\) if bias isn&#39;t regularized)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(\lambda\): Regularization (Control penalty Strength)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 10px;&quot;&gt;\(\frac{\lambda}{2m}\) \(\sum_{j=1}^{p}\) \(\theta_j^2\):&amp;nbsp;Sum of squares of weights (excluding bias term&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-family: math; font-size: 10px; text-transform: math-auto;&quot;&gt;\(\theta_{0}\)&amp;nbsp;&lt;/span&gt;)&lt;/li&gt;&lt;/ul&gt;" vertex="1">
